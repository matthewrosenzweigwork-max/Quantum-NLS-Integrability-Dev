import QuantumNLS.BetheChartFiberSteps

/-! Residual domains for a complete first physical chart integration.
Empty fibers are tested by the explicit lower-endpoint probe. The original
moving labels, chart, branch and pending denominator set are retained.
This does not enumerate terms generated by further endpoint integrations. -/
noncomputable section
open MeasureTheory Set
open scoped BigOperators
set_option autoImplicit false
set_option maxHeartbeats 4000000
attribute [local instance] Classical.propDecidable
namespace QuantumNLS.BetheResidualFibers
open TensorPlacements BetheFaceEnumeration BethePhysicalFaceCharts
open BetheChartFiberSteps BetheFiniteNAction BethePrimitiveTransport

theorem lower_update {N : ℕ} (x : Fin N → ℝ) (a : Fin N) (t : ℝ) :
    lower (Function.update x a t) a = lower x a := by
  classical
  unfold lower
  split_ifs with h
  · apply Function.update_of_ne
    intro he
    have := congrArg Fin.val he
    simp at this
  · rfl

theorem upper_update {N : ℕ} (L : ℝ) (x : Fin N → ℝ) (a : Fin N) (t : ℝ) :
    upper L (Function.update x a t) a = upper L x a := by
  classical
  unfold upper
  split_ifs with h
  · apply Function.update_of_ne
    intro he
    have := congrArg Fin.val he
    simp at this
    omega
  · rfl

theorem fiberLower_update {m q : ℕ} (X y : Fin m → ℝ) (s : Fin q → ℝ)
    (b : Bool) (S : PlacementSubset m q) (i : Fin m) (t : ℝ) :
    fiberLower X (Function.update y i t) s b S i = fiberLower X y s b S i := by
  simp only [fiberLower, mergeChart_update, lower_update]

theorem fiberUpper_update {m q : ℕ} (L : ℝ) (X y : Fin m → ℝ) (s : Fin q → ℝ)
    (b : Bool) (S : PlacementSubset m q) (i : Fin m) (t : ℝ) :
    fiberUpper L X (Function.update y i t) s b S i = fiberUpper L X y s b S i := by
  simp only [fiberUpper, mergeChart_update, upper_update]

/-- An explicit residual-domain test; it uses no chosen incident point. -/
def residualCell {m q : ℕ} (L : ℝ) (X : Fin m → ℝ) (s : Fin q → ℝ)
    (b : Bool) (S : PlacementSubset m q) (i : Fin m) : Set (Fin m → ℝ) :=
  {y | Function.update y i (fiberLower X y s b S i) ∈ closedPhysicalCell L X s b S}

/-- All fibers, including empty fibers, at an arbitrary residual tuple. -/
theorem mem_fiber_iff {m q : ℕ} (L : ℝ) (X y : Fin m → ℝ) (s : Fin q → ℝ)
    (b : Bool) (S : PlacementSubset m q) (i : Fin m) (t : ℝ) :
    Function.update y i t ∈ closedPhysicalCell L X s b S ↔
      y ∈ residualCell L X s b S i ∧
        t ∈ Icc (fiberLower X y s b S i) (fiberUpper L X y s b S i) := by
  classical
  constructor
  · intro ht
    have hb := fiber_bounds L X (Function.update y i t) s b S i ht
    have he := (fiber_endpoints_mem L X (Function.update y i t) s b S i ht).1
    simp only [fiberLower_update, fiberUpper_update, Function.update_self] at hb
    simp only [fiberLower_update, Function.update_idem] at he
    exact ⟨he, hb⟩
  · rintro ⟨hr, ht⟩
    have he := closedPhysicalCell_fiber L X
      (Function.update y i (fiberLower X y s b S i)) s b S i hr
    simp only [fiberLower_update, fiberUpper_update, Function.update_idem] at he
    exact (Set.ext_iff.mp he t).mpr ht

theorem fiber_eq {m q : ℕ} (L : ℝ) (X y : Fin m → ℝ) (s : Fin q → ℝ)
    (b : Bool) (S : PlacementSubset m q) (i : Fin m) :
    {t | Function.update y i t ∈ closedPhysicalCell L X s b S} =
      if y ∈ residualCell L X s b S i then
        Icc (fiberLower X y s b S i) (fiberUpper L X y s b S i) else ∅ := by
  classical
  ext t
  simp only [mem_ofPred_eq, mem_fiber_iff]
  split_ifs <;> simp_all

theorem residualCell_iff_nonempty {m q : ℕ} (L : ℝ) (X y : Fin m → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset m q) (i : Fin m) :
    y ∈ residualCell L X s b S i ↔
      ∃ t, Function.update y i t ∈ closedPhysicalCell L X s b S := by
  constructor
  · intro h; exact ⟨_, h⟩
  · rintro ⟨t, ht⟩; exact ((mem_fiber_iff L X y s b S i t).mp ht).1

/-- The dummy coordinate in a residual tuple has no effect. -/
theorem residualCell_update {m q : ℕ} (L : ℝ) (X y : Fin m → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset m q) (i : Fin m) (t : ℝ) :
    Function.update y i t ∈ residualCell L X s b S i ↔
      y ∈ residualCell L X s b S i := by
  simp only [residualCell, mem_ofPred_eq, fiberLower_update, Function.update_idem]

theorem measurableSet_closedPhysicalCell {m q : ℕ} (L : ℝ) (X : Fin m → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset m q) :
    MeasurableSet (closedPhysicalCell L X s b S) := by
  have hr : MeasurableSet (closedRectangle L X b) := by
    unfold closedRectangle
    simp only [Set.ofPred_forall]
    exact MeasurableSet.iInter fun i => measurableSet_Icc.preimage (measurable_pi_apply i)
  have hb : MeasurableSet {y : Fin m → ℝ | ∀ k, mergeChart S y s k ∈ Icc 0 L} := by
    simp only [Set.ofPred_forall]
    exact MeasurableSet.iInter fun k => measurableSet_Icc.preimage (by unfold mergeChart; fun_prop)
  exact hr.inter ((measurableSet_chartSet S s).inter hb)

theorem continuous_fiberLower {m q : ℕ} (X : Fin m → ℝ) (s : Fin q → ℝ)
    (b : Bool) (S : PlacementSubset m q) (i : Fin m) :
    Continuous (fun y => fiberLower X y s b S i) := by
  unfold fiberLower lower
  split_ifs <;> (try unfold mergeChart) <;> fun_prop

theorem measurableSet_residualCell {m q : ℕ} (L : ℝ) (X : Fin m → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset m q) (i : Fin m) :
    MeasurableSet (residualCell L X s b S i) := by
  have h : Continuous (fun y => Function.update y i (fiberLower X y s b S i)) := by
    apply continuous_pi
    intro j
    by_cases hj : j = i
    · subst j; simpa only [Function.update_self] using continuous_fiberLower X s b S i
    · simpa only [Function.update_of_ne hj] using (continuous_apply j : Continuous (fun y : Fin m → ℝ => y j))
  exact h.measurable (measurableSet_closedPhysicalCell L X s b S)

/-- The exact ordinary first integration is zero on every empty fiber.
On a nonempty fiber it has both endpoints and the inserted original label. -/
theorem integral_primitive_all_fibers {m q : ℕ} (L c : ℝ) (r : Fin (m+q) → ℝ)
    (X y : Fin m → ℝ) (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset m q)
    (i : Fin m) (z : ℂ) (hz : ∀ k, z ≠ (r k : ℂ))
    (A : Finset (Fin (m+q))) (ha : Fin.castAdd q i ∉ A) (u : ℝ) :
    (∫ t in {t | Function.update y i t ∈ closedPhysicalCell L X s b S},
      Complex.exp (Complex.I*z*(u-t)) * chartPrimitive S c r (Function.update y i t) s z A) =
      if y ∈ residualCell L X s b S i then
        Complex.exp (Complex.I*z*(u-fiberUpper L X y s b S i)) *
          chartPrimitive S c r (Function.update y i (fiberUpper L X y s b S i)) s z
            (insert (Fin.castAdd q i) A) -
        Complex.exp (Complex.I*z*(u-fiberLower X y s b S i)) *
          chartPrimitive S c r (Function.update y i (fiberLower X y s b S i)) s z
            (insert (Fin.castAdd q i) A) else 0 := by
  classical
  by_cases hy : y ∈ residualCell L X s b S i
  · rw [ite_eq_left hy]
    have he := integral_chartPrimitive_fiber L c r X
      (Function.update y i (fiberLower X y s b S i)) s b S i hy z hz A ha u
    simpa only [fiberLower_update, fiberUpper_update, Function.update_idem] using he
  · rw [ite_eq_right hy, fiber_eq, ite_eq_right hy]
    simp

/-- Integrability on the full cell is proved from its bounded rectangle,
with no Fubini or integrability premise supplied by the desired result. -/
theorem integrableOn_cell {m q : ℕ} (L : ℝ) (X : Fin m → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset m q)
    (f : (Fin m → ℝ) → ℂ) (hf : Continuous f) :
    IntegrableOn f (closedPhysicalCell L X s b S) := by
  exact (hf.integrableOn_Icc (a := rectangleLower X b)
    (b := rectangleUpper L X b)).mono_set (fun _ h =>
      ⟨fun j => (h.1 j).1, fun j => (h.1 j).2⟩)

/-- Fubini for the actual closed cell at any original moving label.
The right side includes every residual tuple, including empty fibers. -/
theorem integral_cell_fubini {d q : ℕ} (L : ℝ) (X : Fin (d+1) → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset (d+1) q)
    (i : Fin (d+1)) (f : (Fin (d+1) → ℝ) → ℂ) (hf : Continuous f) :
    (∫ y in closedPhysicalCell L X s b S, f y) =
      ∫ v : Fin d → ℝ, ∫ t in {t | i.insertNth t v ∈ closedPhysicalCell L X s b S},
        f (i.insertNth t v) := by
  let C := closedPhysicalCell L X s b S
  let g := C.indicator f
  have hC : MeasurableSet C := measurableSet_closedPhysicalCell L X s b S
  have hg : Integrable g := (integrableOn_cell L X s b S f hf).integrable_indicator hC
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d+1) => ℝ) i
  have hp : MeasurePreserving e.symm (volume.prod volume) volume := by
    simpa only [Measure.volume_eq_prod] using (volume_preserving_piFinSuccAbove (fun _ : Fin (d+1) => ℝ) i).symm
  have hi : Integrable (g ∘ e.symm) (volume.prod volume) :=
    (hp.integrable_comp_emb e.symm.measurableEmbedding).mpr hg
  rw [← integral_indicator hC]
  change (∫ y, g y) = _
  rw [← hp.integral_comp' g]
  change (∫ x, (g ∘ e.symm) x ∂volume.prod volume) = _
  rw [integral_prod_symm _ hi]
  apply integral_congr_ae
  filter_upwards with v
  rw [← integral_indicator (by
    change MeasurableSet ((fun t => i.insertNth t v) ⁻¹' C)
    exact hC.preimage (by
      change Measurable (fun t => e.symm (t,v))
      fun_prop))]
  apply integral_congr_ae
  filter_upwards with t
  change C.indicator f (i.insertNth t v) = _
  by_cases h : i.insertNth t v ∈ C <;> simp [C] at h ⊢ <;> simp [h]

/-- The residual domain has a concrete measurable lower-probe test.
No integral over an empty fiber is replaced by an endpoint difference. -/
theorem integral_cell_residual {d q : ℕ} (L : ℝ) (X : Fin (d+1) → ℝ)
    (s : Fin q → ℝ) (b : Bool) (S : PlacementSubset (d+1) q)
    (i : Fin (d+1)) (f : (Fin (d+1) → ℝ) → ℂ) (hf : Continuous f) :
    (∫ y in closedPhysicalCell L X s b S, f y) =
      ∫ v : Fin d → ℝ,
        if i.insertNth 0 v ∈ residualCell L X s b S i then
          ∫ t in Icc (fiberLower X (i.insertNth 0 v) s b S i)
            (fiberUpper L X (i.insertNth 0 v) s b S i), f (i.insertNth t v)
        else 0 := by
  rw [integral_cell_fubini L X s b S i f hf]
  apply integral_congr_ae
  filter_upwards with v
  have he := fiber_eq L X (i.insertNth 0 v) s b S i
  simp only [Fin.update_insertNth] at he
  rw [he]
  split_ifs <;> simp

/-- The complete physical branch phase, retaining exp(i*z*L) for minus. -/
def branchSource {m q : ℕ} (L c : ℝ) (n : Fin (m+q) → ℤ) (z : ℂ)
    (X : Fin m → ℝ) (s : Fin q → ℝ) (b : Bool) (y : Fin m → ℝ) : ℂ :=
  Complex.exp (Complex.I*z*((if b then L else 0) +
    BetheTransferKernelAdjoint.displacement X y)) *
      BetheExtension.symmetricExtension L c n (Fin.append y s)

theorem continuous_branchSource {m q : ℕ} (L c : ℝ) (n : Fin (m+q) → ℤ)
    (z : ℂ) (X : Fin m → ℝ) (s : Fin q → ℝ) (b : Bool) :
    Continuous (branchSource L c n z X s b) := by
  unfold branchSource BetheTransferKernelAdjoint.displacement
  apply Continuous.mul
  · fun_prop
  · exact (BetheExtension.continuous_symmetricExtension L c n).comp (by fun_prop)

/-- Literal raw kernels agree with these full branch phases on their
proved open rectangles. This is a pointwise kernel identity. -/
theorem rawSource_branches {m q : ℕ} (L c : ℝ) (n : Fin (m+q) → ℤ)
    (z : ℂ) (X : Fin m → ℝ) (s : Fin q → ℝ)
    (hX : X ∈ BetheWavefunctions.chamber m L) (y : Fin m → ℝ) :
    rawSource L c n z X s y =
      (openRectangle L X false).indicator (branchSource L c n z X s false) y +
      (openRectangle L X true).indicator (branchSource L c n z X s true) y := by
  classical
  have hm : Complex.exp (Complex.I*z*L - Complex.I*z*(∑ j, (y j-X j) : ℝ)) =
      Complex.exp (Complex.I*z*((L : ℝ) + BetheTransferKernelAdjoint.displacement X y)) := by
    have hd := BetheTransferKernelAdjoint.displacement_swap X y
    change (∑ j, (y j-X j) : ℝ) = -BetheTransferKernelAdjoint.displacement X y at hd
    rw [hd]
    congr 1
    push_cast
    ring
  unfold rawSource BetheTransferKernelAdjoint.rawKernel
    BetheTransferKernelAdjoint.rawPlus BetheTransferKernelAdjoint.rawMinus
  rw [add_mul, plusOrder_openRectangle hX y, minusOrder_openRectangle hX y, hm]
  by_cases hp : y ∈ openRectangle L X false <;>
    by_cases hn : y ∈ openRectangle L X true <;> simp [hp, hn, branchSource]

theorem rectangle_open_closed_ae {m : ℕ} (L : ℝ) (X : Fin m → ℝ) (b : Bool) :
    ∀ᵐ y : Fin m → ℝ, y ∈ openRectangle L X b ↔ y ∈ closedRectangle L X b := by
  have hn (i : Fin m) : ∀ᵐ y : Fin m → ℝ,
      y i ≠ rectangleLower X b i ∧ y i ≠ rectangleUpper L X b i := by
    have hl := Measure.ae_eval_ne (fun _ : Fin m => (volume : Measure ℝ)) i (rectangleLower X b i)
    have hu := Measure.ae_eval_ne (fun _ : Fin m => (volume : Measure ℝ)) i (rectangleUpper L X b i)
    rw [← volume_pi] at hl hu
    exact hl.and hu
  filter_upwards [Filter.eventually_all.mpr hn] with y hy
  constructor
  · intro h i; exact ⟨(h i).1.le, (h i).2.le⟩
  · intro h i
    exact ⟨lt_of_le_of_ne (h i).1 (hy i).1.symm, lt_of_le_of_ne (h i).2 (hy i).2⟩

theorem closedRectangle_mem_cube {m : ℕ} (L : ℝ) (X y : Fin m → ℝ) (b : Bool)
    (hX : X ∈ BetheWavefunctions.chamber m L) (hy : y ∈ closedRectangle L X b) :
    y ∈ Icc (fun _ => 0) (fun _ => L) := by
  constructor <;> intro i
  · have h := hy i
    cases b
    · exact (lower_bounds hX i).1.trans h.1
    · exact (hX.2 i).1.le.trans h.1
  · have h := hy i
    cases b
    · exact h.2.trans (hX.2 i).2.le
    · exact h.2.trans (upper_bounds hX i).2

/-- A proved bridge from each literal BPR1 chart-restricted cube integral
to the two closed-cell integrals used by the residual Fubini theorem.
Only rectangle endpoints are removed, by explicit ambient null sets. -/
theorem integral_rawSource_closed_cells {m q : ℕ} (L c : ℝ) (n : Fin (m+q) → ℤ)
    (z : ℂ) (X : Fin m → ℝ) (s : Fin q → ℝ) (S : PlacementSubset m q)
    (hX : X ∈ BetheWavefunctions.chamber m L) (hs : ∀ j, s j ∈ Icc 0 L) :
    (∫ y in chartSet S s, rawSource L c n z X s y ∂BetheWeakGradient.cubeMeasure m L) =
      (∫ y in closedPhysicalCell L X s false S, branchSource L c n z X s false y) +
      ∫ y in closedPhysicalCell L X s true S, branchSource L c n z X s true y := by
  classical
  let B : Set (Fin m → ℝ) := Icc (fun _ => 0) (fun _ => L)
  let C (b : Bool) := closedPhysicalCell L X s b S
  let f (b : Bool) := branchSource L c n z X s b
  have hm (b : Bool) : MeasurableSet (C b) := measurableSet_closedPhysicalCell L X s b S
  have hi (b : Bool) : Integrable ((C b).indicator (f b)) :=
    (integrableOn_cell L X s b S (f b) (continuous_branchSource L c n z X s b)).integrable_indicator (hm b)
  rw [← integral_indicator (measurableSet_chartSet S s)]
  change (∫ y in B, (chartSet S s).indicator (rawSource L c n z X s) y) = _
  rw [← integral_indicator measurableSet_Icc,
    ← integral_indicator (hm false), ← integral_indicator (hm true), ← integral_add (hi false) (hi true)]
  apply integral_congr_ae
  filter_upwards [rectangle_open_closed_ae L X false, rectangle_open_closed_ae L X true] with y hp hn
  have he (b : Bool) : y ∈ C b ↔ y ∈ closedRectangle L X b ∧ y ∈ chartSet S s :=
    closedPhysicalCell_iff L X y s b S hX hs
  have hb (b : Bool) : y ∈ closedRectangle L X b → y ∈ B :=
    closedRectangle_mem_cube L X y b hX
  by_cases hB : y ∈ B
  · by_cases hS : y ∈ chartSet S s
    · rw [indicator_of_mem hB, indicator_of_mem hS, rawSource_branches L c n z X s hX y]
      have hpC : y ∈ C false ↔ y ∈ openRectangle L X false := by
        rw [he, ← hp, and_iff_left hS]
      have hnC : y ∈ C true ↔ y ∈ openRectangle L X true := by
        rw [he, ← hn, and_iff_left hS]
      simp only [Set.indicator, hpC, hnC, f]
    · have hfalse : y ∉ C false := fun h => hS ((he false).mp h).2
      have htrue : y ∉ C true := fun h => hS ((he true).mp h).2
      rw [indicator_of_mem hB, indicator_of_notMem hS,
        indicator_of_notMem hfalse, indicator_of_notMem htrue]
      simp
  · have hfalse : y ∉ C false := fun h => hB (hb false ((he false).mp h).1)
    have htrue : y ∉ C true := fun h => hB (hb true ((he true).mp h).1)
    rw [indicator_of_notMem hB, indicator_of_notMem hfalse, indicator_of_notMem htrue]
    simp

theorem displacement_update {m : ℕ} (X y : Fin m → ℝ) (i : Fin m) (t : ℝ) :
    BetheTransferKernelAdjoint.displacement X (Function.update y i t) =
      BetheTransferKernelAdjoint.displacement X y + y i - t := by
  classical
  have he (j : Fin m) : X j - Function.update y i t j =
      (X j - y j) + (if j = i then y i - t else 0) := by
    by_cases hj : j = i
    · subst j; simp
    · simp [hj]
  simp only [BetheTransferKernelAdjoint.displacement, he, Finset.sum_add_distrib]
  simp
  ring

/-- Exact first generated endpoint pair, with its residual-domain test.
The complete branch phase and the original input denominator label survive. -/
def firstEndpoints {d q : ℕ} (L c : ℝ) (n : Fin ((d+1)+q) → ℤ) (z : ℂ)
    (X : Fin (d+1) → ℝ) (s : Fin q → ℝ) (b : Bool)
    (S : PlacementSubset (d+1) q) (i : Fin (d+1)) (v : Fin d → ℝ) : ℂ :=
        let y : Fin (d+1) → ℝ := i.insertNth 0 v
        let u := (if b then L else 0) + BetheTransferKernelAdjoint.displacement X y
        if y ∈ residualCell L X s b S i then
          Complex.exp (Complex.I*z*(u-fiberUpper L X y s b S i)) *
            chartPrimitive S c (BetheSmooth.sourceRoots L n c)
              (i.insertNth (fiberUpper L X y s b S i) v) s z {Fin.castAdd q i} -
          Complex.exp (Complex.I*z*(u-fiberLower X y s b S i)) *
            chartPrimitive S c (BetheSmooth.sourceRoots L n c)
              (i.insertNth (fiberLower X y s b S i) v) s z {Fin.castAdd q i}
        else 0

/-- Complete one-cell source action as an integral of its first generated
endpoints over the exact residual domain. The two terms are not canceled. -/
theorem integral_branchSource_first_endpoints {d q : ℕ} (L c : ℝ)
    (n : Fin ((d+1)+q) → ℤ) (z : ℂ)
    (hz : ∀ k, z ≠ (BetheSmooth.sourceRoots L n c k : ℂ))
    (X : Fin (d+1) → ℝ) (s : Fin q → ℝ) (b : Bool)
    (S : PlacementSubset (d+1) q) (i : Fin (d+1)) :
    (∫ y in closedPhysicalCell L X s b S, branchSource L c n z X s b y) =
      ∫ v : Fin d → ℝ, firstEndpoints L c n z X s b S i v := by
  unfold firstEndpoints
  rw [integral_cell_fubini L X s b S i _ (continuous_branchSource L c n z X s b)]
  apply integral_congr_ae
  filter_upwards with v
  let y : Fin (d+1) → ℝ := i.insertNth 0 v
  let u := (if b then L else 0) + BetheTransferKernelAdjoint.displacement X y
  have hi : y i = 0 := by simp [y]
  have he := integral_primitive_all_fibers L c (BetheSmooth.sourceRoots L n c)
    X y s b S i z hz ∅ (Finset.notMem_empty _) u
  dsimp only [y] at he
  simp only [Finset.insert_empty, Fin.update_insertNth] at he
  change (∫ t in {t | i.insertNth t v ∈ closedPhysicalCell L X s b S},
    branchSource L c n z X s b (i.insertNth t v)) = _
  rw [← he]
  apply setIntegral_congr_fun
  · have hm : Measurable (fun t : ℝ => (i.insertNth t v : Fin (d+1) → ℝ)) := by
      change Measurable (fun t =>
        (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (d+1) => ℝ) i).symm (t,v))
      fun_prop
    exact (measurableSet_closedPhysicalCell L X s b S).preimage hm
  · intro t ht
    dsimp only
    rw [chartPrimitive_empty_source L c n (i.insertNth t v) s S ht.2.1 z]
    have hd := displacement_update X y i t
    simp only [y, Fin.update_insertNth, Fin.insertNth_apply_same, add_zero] at hd
    simp only [branchSource, hd, u]
    congr 2
    push_cast
    ring

/-- One complete first endpoint reduction for a literal BPR1 chart integral. -/
theorem integral_rawSource_first_endpoints {d q : ℕ} (L c : ℝ)
    (n : Fin ((d+1)+q) → ℤ) (z : ℂ)
    (hz : ∀ k, z ≠ (BetheSmooth.sourceRoots L n c k : ℂ))
    (X : Fin (d+1) → ℝ) (s : Fin q → ℝ) (S : PlacementSubset (d+1) q)
    (i : Fin (d+1)) (hX : X ∈ BetheWavefunctions.chamber (d+1) L)
    (hs : ∀ j, s j ∈ Icc 0 L) :
    (∫ y in chartSet S s, rawSource L c n z X s y ∂BetheWeakGradient.cubeMeasure (d+1) L) =
      (∫ v, firstEndpoints L c n z X s false S i v) +
        ∫ v, firstEndpoints L c n z X s true S i v := by
  rw [integral_rawSource_closed_cells L c n z X s S hX hs,
    integral_branchSource_first_endpoints L c n z hz X s false S i,
    integral_branchSource_first_endpoints L c n z hz X s true S i]

open TensorCarrier PhysicalTensor BetheHigherPlacement BetheGeneralSliceEndpoints
open BetheTransferKernelAdjoint BetheWeakGradient

/-- The first endpoint reduction for the actual positive-c physical
transfer term, with the frozen exact coefficient c^m per output subset.
No generated endpoint is identified with a different transfer degree. -/
theorem source_transferTerm_first_endpoints_ae (L : ℝ) [Fact (0 < L)]
    (d q : ℕ) {c : ℝ} (hc : 0 < c) {n : Fin ((d+1)+q) → ℤ}
    (hn : Antitone n) (z : ℂ)
    (hz : ∀ k, z ≠ (BetheSmooth.sourceRoots L n c k : ℂ)) (i : Fin (d+1)) :
    ∀ᵐ x ∂torusPiMeasure L ((d+1)+q), StrictAnti (representatives L x) →
      physUnitary ((BethePhysicalTransfer.transferTerm L ((d+1)+q) c z ⟨d+1,by omega⟩
        (sourceVector L hc hn)).1) x = (c : ℂ)^(d+1) *
        ∑ S : PlacementSubset (d+1) q, ∑ T : PlacementSubset (d+1) q,
          let X := fun j : Fin (d+1) => representatives L x ((mergePermutation S) (Fin.castAdd q j))
          let s := fun j : Fin q => representatives L x ((mergePermutation S) (Fin.natAdd (d+1) j))
          (∫ v, firstEndpoints L c n z X s false T i v) +
            ∫ v, firstEndpoints L c n z X s true T i v := by
  have hall : ∀ᵐ x ∂torusPiMeasure L ((d+1)+q),
      ∀ k, representatives L x k ∈ Ioo 0 L :=
    Filter.eventually_all.mpr (fun k => representatives_interior_ae L _ k)
  filter_upwards [source_transferTerm_charts_ae L (d+1) q (by omega) hc hn z, hall] with x he hint hx
  rw [he hx]
  congr 1
  apply Finset.sum_congr rfl
  intro S _
  apply Finset.sum_congr rfl
  intro T _
  apply integral_rawSource_first_endpoints L c n z hz _ _ T i
  · constructor
    · intro a b hab
      apply hx
      simpa only [Equiv.symm_symm, mergePermutation_selected] using
        (S.1.orderEmbOfFin S.2).strictMono hab
    · intro j; exact hint _
  · intro j; exact ⟨(hint _).1.le, (hint _).2.le⟩

