set_option maxHeartbeats 4000000 in
run_cmd do
  let env ← Lean.getEnv
  let mut pending := #[
    ``QuantumNLS.BetheResidualFibers.source_transferTerm_first_endpoints_ae,
    ``QuantumNLS.BetheResidualFibers.integral_primitive_all_fibers,
    ``QuantumNLS.BetheResidualFibers.measurableSet_residualCell,
    ``QuantumNLS.BetheResidualFibers.residualCell_update,
    ``QuantumNLS.BetheIteratedIncidence.card_incidentCharts_ratio,
    ``QuantumNLS.BetheCyclicPrimitives.integral_source_primitive_outer_pair,
    ``QuantumNLS.BethePrimitiveTransport.source_spectator_face_seam_ae]
  let mut seen : Std.HashSet Lean.Name := {}
  while !pending.isEmpty do
    let n := pending.back!
    pending := pending.pop
    unless seen.contains n do
      seen := seen.insert n
      if let some ci := env.find? n then
        pending := pending ++ ci.type.getUsedConstants
        if let some v := ci.value? (allowOpaque := true) then
          pending := pending ++ v.getUsedConstants
  for n in #[
      ``QuantumNLS.BetheResidualFibers.integral_cell_fubini,
      ``QuantumNLS.BetheResidualFibers.integrableOn_cell,
      ``QuantumNLS.BetheResidualFibers.mem_fiber_iff,
      ``QuantumNLS.BetheResidualFibers.integral_rawSource_closed_cells,
      ``QuantumNLS.BetheResidualFibers.rectangle_open_closed_ae,
      ``QuantumNLS.BetheResidualFibers.rawSource_branches,
      ``QuantumNLS.BetheResidualFibers.integral_branchSource_first_endpoints,
      ``QuantumNLS.BethePhysicalFaceCharts.source_transferTerm_charts_ae,
      ``QuantumNLS.BetheHigherPlacement.coefficient_normalization,
      ``QuantumNLS.BetheInternalFaces.source_primitive_internal_face,
      ``QuantumNLS.BetheCrossDegreeFaces.integral_primitive_update,
      ``QuantumNLS.BethePeriodic.sourceRoots_term_periodic,
      ``QuantumNLS.BetheSmooth.sourceRoots] do
    unless seen.contains n do
      throwError "Residual physical fiber aggregate missing ingredient: {n}"
  for n in seen do
    if n == ``sorryAx || n.toString.startsWith "QuantumNLS.TransferSeparation" ||
        n.toString.startsWith "QuantumNLS.BetheOneParticleAction." ||
        n.toString.startsWith "QuantumNLS.BetheTwoParticle" ||
        (n.toString.startsWith "QuantumNLS." &&
          (n.toString.toLower.contains "eigenrelation" || n.toString.contains "U5")) then
      throwError "Residual physical fiber aggregate forbidden dependency: {n}"
  Lean.logInfo m!"Residual physical fiber aggregate audit PASS: {seen.size} transitive constants across separate roots. Exact all-fiber residual geometry, Fubini and first endpoints of the actual positive-c physical transfer terms with frozen normalization; static repeated-label incidence and local internal/cyclic identities are separate roots. Complete iterated generated-face enumeration, global cancellation and all-N eigenrelation remain open."
