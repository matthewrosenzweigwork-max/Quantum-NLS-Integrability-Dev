/-! PROP-022 route A, round 4, stage C7: the INTRINSIC Weyl operators `W_H(v) = exp(a*(v) - a(v))`.

For a complex Hilbert space `E` and `f ∈ E`:
* `gcl E f`: the closure (in `Fock(E) × Fock(E)`) of the graph of `a*(f) - a(f)` on the finite-particle core
  (`Prop022CCanon.Zgen`), built from the intrinsic `creF`, `annF` only;
* `IsWeylGroup f G`: `G : ℝ → U(Fock E)` is a strongly continuous unitary group whose generator is exactly
  the closure `gcl E f` (`HasDerivAt (t ↦ G t x) y 0 ↔ (x,y) ∈ gcl E f`);
* `IsWeylOp f W`: `W = G 1` for such a group, i.e. `W = exp(a*(f) - a(f))`.

Results: `weylGroup_unique` (a Weyl group is determined by its generator; the printed convention is
a characterization), `WJ_isWeylGroup` / `WH_isWeylGroup` (the compressed / transported printed Weyl operators
of the frozen stages ARE the intrinsic Weyl groups; `t ↦ W_J(t v)` is strongly continuous with generator the
closure of `a*(v) - a(v)` on the core), `WJ_isWeylOp`, `WH_isWeylOp`. -/

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 200000
set_option linter.unusedSectionVars false
noncomputable section
open scoped InnerProductSpace Topology
open Filter
attribute [local instance 1100] NormedSpace.complexToReal Module.complexToReal
attribute [local instance 2000] InnerProductSpace.complexToReal

namespace QuantumNLS.Prop022CWeyl
open QuantumNLS.TensorCarrier QuantumNLS.Prop022GTensor QuantumNLS.Prop022AIsoTensor
open QuantumNLS.Prop022BIso QuantumNLS.Prop022CCanon QuantumNLS.Prop022BFock1
open QuantumNLS.Prop022CStone QuantumNLS.Prop022CTorus QuantumNLS.Prop022BFock2
open PhysicalTensor Ext025B3PhysicalSectors

section Intrinsic
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- Closure of the graph of `a*(f) - a(f)` on the finite-particle core. -/
def gcl (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (f : E) :
    Set (FockSpace E × FockSpace E) :=
  closure {p | ∃ z : Dfin E, p = ((z : FockSpace E), (Zgen f z : FockSpace E))}

/-- `G` is a strongly continuous unitary group generated by the closure of `a*(f) - a(f)`. -/
abbrev IsWeylGroup (f : E) (G : ℝ → FockSpace E ≃ₗᵢ[ℂ] FockSpace E) : Prop :=
  IsStoneGroup G (gcl E f)

/-- `W = exp(a*(f) - a(f))`, as the time-one value of the Weyl group. -/
def IsWeylOp (f : E) (W : FockSpace E ≃ₗᵢ[ℂ] FockSpace E) : Prop :=
  ∃ G, IsWeylGroup f G ∧ G 1 = W

lemma dfin_dense : Dense (Dfin E : Set (FockSpace E)) := by
  intro x
  rw [mem_closure_iff_seq_limit]
  have hs := lp.hasSum_single (p := 2) (by norm_num) x
  refine ⟨fun N => ∑ n ∈ Finset.range N, (lp.single 2 n (x n) : FockSpace E), fun N => ?_,
    hs.tendsto_sum_nat⟩
  exact (Dfin E).sum_mem (fun n _ => ⟨n, fun m hm => by
    rw [lp.single_apply_ne _ _ _ (ne_of_gt hm)]⟩)

lemma mem_gcl_iff (f : E) (x y : FockSpace E) :
    (x, y) ∈ gcl E f ↔ ∃ z : ℕ → Dfin E, Tendsto (fun n => (z n : FockSpace E)) atTop (𝓝 x) ∧
      Tendsto (fun n => (Zgen f (z n) : FockSpace E)) atTop (𝓝 y) := by
  constructor
  · intro h
    obtain ⟨p, hp, ht⟩ := mem_closure_iff_seq_limit.mp h
    choose z hz using hp
    refine ⟨z, ?_, ?_⟩
    · have := ((continuous_fst.tendsto (x, y)).comp ht)
      exact this.congr (fun n => by simp [Function.comp, hz n])
    · have := ((continuous_snd.tendsto (x, y)).comp ht)
      exact this.congr (fun n => by simp [Function.comp, hz n])
  · rintro ⟨z, hz, hZ⟩
    apply mem_closure_of_tendsto (b := atTop) (f := fun n => ((z n : FockSpace E), (Zgen f (z n) : FockSpace E)))
    · exact hz.prodMk_nhds hZ
    · exact Eventually.of_forall (fun n => ⟨z n, rfl⟩)

lemma gcl_dense (f : E) : Dense {x : FockSpace E | ∃ y, (x, y) ∈ gcl E f} :=
  dfin_dense.mono (fun z hz => ⟨(Zgen f ⟨z, hz⟩ : FockSpace E), subset_closure ⟨⟨z, hz⟩, rfl⟩⟩)

lemma gcl_skew (f : E) : ∀ p ∈ gcl E f, ∀ q ∈ gcl E f, ⟪p.2, q.1⟫_ℂ + ⟪p.1, q.2⟫_ℂ = 0 := by
  let A : Set (FockSpace E × FockSpace E) :=
    {p | ∃ z : Dfin E, p = ((z : FockSpace E), (Zgen f z : FockSpace E))}
  have hA : ∀ pq ∈ A ×ˢ A, ⟪pq.1.2, pq.2.1⟫_ℂ + ⟪pq.1.1, pq.2.2⟫_ℂ = 0 := by
    rintro ⟨_, _⟩ ⟨⟨z, rfl⟩, ⟨w, rfl⟩⟩
    exact Zgen_skew f z w
  have hcl : closure (A ×ˢ A) ⊆
      {pq : (FockSpace E × FockSpace E) × (FockSpace E × FockSpace E) |
        ⟪pq.1.2, pq.2.1⟫_ℂ + ⟪pq.1.1, pq.2.2⟫_ℂ = 0} :=
    closure_minimal hA (isClosed_eq
      (Continuous.add
        (Continuous.inner (continuous_snd.comp continuous_fst) (continuous_fst.comp continuous_snd))
        (Continuous.inner (continuous_fst.comp continuous_fst) (continuous_snd.comp continuous_snd)))
      continuous_const)
  intro p hp q hq
  have : (p, q) ∈ closure (A ×ˢ A) := by
    rw [closure_prod_eq]
    exact ⟨hp, hq⟩
  exact hcl this

/-- **A Weyl group is determined by its generator.** -/
theorem weylGroup_unique {f : E} {G G' : ℝ → FockSpace E ≃ₗᵢ[ℂ] FockSpace E}
    (h : IsWeylGroup f G) (h' : IsWeylGroup f G') (t : ℝ) (x : FockSpace E) :
    G t x = G' t x :=
  stone_unique (gcl_skew f) (gcl_dense f) h h' t x

theorem weylOp_unique {f : E} {W W' : FockSpace E ≃ₗᵢ[ℂ] FockSpace E}
    (h : IsWeylOp f W) (h' : IsWeylOp f W') : W = W' := by
  obtain ⟨G, hG, rfl⟩ := h
  obtain ⟨G', hG', rfl⟩ := h'
  exact LinearIsometryEquiv.ext (fun x => weylGroup_unique hG hG' 1 x)

end Intrinsic

/-! ### The compressed Weyl operators are the intrinsic ones -/

section Compressed
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable {L : ℝ} [Fact (0 < L)]

lemma hasDerivAt_clm {X Y : Type*} [NormedAddCommGroup X] [InnerProductSpace ℂ X]
    [NormedAddCommGroup Y] [InnerProductSpace ℂ Y] (T : X →L[ℂ] Y) {f : ℝ → X} {f' : X} {t : ℝ}
    (hf : HasDerivAt f f' t) : HasDerivAt (fun s => T (f s)) (T f') t :=
  (T.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt t hf

lemma Zgen_gam (J : H →ₗᵢ[ℂ] L2T L) (f : H) (x : Dfin H) :
    (Zgen (J f) (gamD J x) : FockSpace (L2T L)) = fockMapI J (Zgen f x : FockSpace H) := by
  rw [Zgen_apply, Zgen_apply, map_sub, creF_gam, annF_gam]

lemma Zgen_gamAdj (J : H →ₗᵢ[ℂ] L2T L) (f : H) (z : Dfin (L2T L)) :
    (Zgen f (gamAdjD J z) : FockSpace H) = gamAdj J (Zgen (J f) z : FockSpace (L2T L)) := by
  rw [Zgen_apply, Zgen_apply, map_sub, creF_gamAdj, annF_gamAdj]

lemma WJ_gam (J : H →ₗᵢ[ℂ] L2T L) (v : H) (r : ℝ) (x : FockSpace H) :
    fockMapI J (WJ J ((r : ℂ) • v) x) = WK (J v) r (fockMapI J x) := by
  have h : fockMapI J (WJ J ((r : ℂ) • v) x) =
      Prop022OVacuum.printedWeyl (J ((r : ℂ) • v)) (fockMapI J x) := gam_compress J _ _ x
  rw [h, map_smul, printedWeyl_eq_WK]

/-- **The compressed printed Weyl operators form the intrinsic Weyl group**
`t ↦ exp(t(a*(v) - a(v)))`: a strongly continuous unitary group whose generator is the closure of
`a*(v) - a(v)` on the finite-particle core of `Fock(H)`. -/
theorem WJ_isWeylGroup (J : H →ₗᵢ[ℂ] L2T L) (v : H) :
    IsWeylGroup v (fun r : ℝ => WJ J ((r : ℂ) • v)) where
  zero x := by
    apply (fockMapI J).injective
    rw [WJ_gam, WK_zero]
  add s t x := by
    apply (fockMapI J).injective
    rw [WJ_gam, WJ_gam, WJ_gam, WK_add]
  cont x := by
    have h : (fun r : ℝ => WJ J ((r : ℂ) • v) x) =
        fun r : ℝ => gamAdj J (WK (J v) r (fockMapI J x)) := by
      funext r
      rw [← WJ_gam, gamAdj_gam]
    rw [h]
    exact (gamAdj J).continuous.comp (WK_cont (J v) (fockMapI J x))
  gen x y := by
    constructor
    · intro hd
      have hd1 := hasDerivAt_clm (fockMapI J).toContinuousLinearMap hd
      have hf : (fun s : ℝ => (fockMapI J).toContinuousLinearMap (WJ J ((s : ℂ) • v) x)) =
          fun s => WK (J v) s (fockMapI J x) := funext (fun s => WJ_gam J v s x)
      rw [hf] at hd1
      obtain ⟨z, hz1, hz2⟩ := WK_core_of_deriv (J v) (fockMapI J x) (fockMapI J y) hd1
      rw [mem_gcl_iff]
      refine ⟨fun n => gamAdjD J (z n), ?_, ?_⟩
      · have := ((gamAdj J).continuous.tendsto _).comp hz1
        rw [gamAdj_gam] at this
        exact this
      · have h2 : ∀ n, (Zgen v (gamAdjD J (z n)) : FockSpace H) =
            gamAdj J (Zgen (J v) (z n) : FockSpace (L2T L)) := fun n => Zgen_gamAdj J v (z n)
        simp only [h2]
        have := ((gamAdj J).continuous.tendsto _).comp hz2
        rw [gamAdj_gam] at this
        exact this
    · intro h
      obtain ⟨z, hz1, hz2⟩ := (mem_gcl_iff v x y).mp h
      have h1 : Tendsto (fun n => ((gamD J (z n) : Dfin (L2T L)) : FockSpace (L2T L))) atTop
          (𝓝 (fockMapI J x)) := ((fockMapI J).continuous.tendsto x).comp hz1
      have h2 : Tendsto (fun n => (Zgen (J v) (gamD J (z n)) : FockSpace (L2T L))) atTop
          (𝓝 (fockMapI J y)) := by
        have h3 : ∀ n, (Zgen (J v) (gamD J (z n)) : FockSpace (L2T L)) =
            fockMapI J (Zgen v (z n) : FockSpace H) := fun n => Zgen_gam J v (z n)
        simp only [h3]
        exact ((fockMapI J).continuous.tendsto y).comp hz2
      have hd := WK_deriv_of_core (J v) (fockMapI J x) (fockMapI J y) (fun n => gamD J (z n)) h1 h2
      have hd' := hasDerivAt_clm (gamAdj J) hd
      have hf : (fun s : ℝ => gamAdj J (WK (J v) s (fockMapI J x))) =
          fun s : ℝ => WJ J ((s : ℂ) • v) x := by
        funext s
        rw [← WJ_gam, gamAdj_gam]
      rw [hf, gamAdj_gam] at hd'
      exact hd'

theorem WJ_isWeylOp (J : H →ₗᵢ[ℂ] L2T L) (v : H) : IsWeylOp v (WJ J v) :=
  ⟨_, WJ_isWeylGroup J v, by simp⟩

theorem WH_eq_WJ (U : H ≃ₗᵢ[ℂ] L2T L) (v : H) :
    Prop022AFock.WH U v = WJ U.toLinearIsometry v := by
  apply LinearIsometryEquiv.ext
  intro x
  apply (fockMapI U.toLinearIsometry).injective
  have h1 : fockMapI U.toLinearIsometry (Prop022AFock.WH U v x) =
      Prop022OVacuum.printedWeyl (U v) (fockMapI U.toLinearIsometry x) := by
    rw [fockMapI_equiv, fockMapI_equiv]
    exact (Prop022AFock.gam U).apply_symm_apply _
  have h2 : fockMapI U.toLinearIsometry (WJ U.toLinearIsometry v x) =
      Prop022OVacuum.printedWeyl (U v) (fockMapI U.toLinearIsometry x) :=
    gam_compress U.toLinearIsometry _ _ x
  exact h1.trans h2.symm

theorem WH_isWeylGroup (U : H ≃ₗᵢ[ℂ] L2T L) (v : H) :
    IsWeylGroup v (fun r : ℝ => Prop022AFock.WH U ((r : ℂ) • v)) := by
  have h : (fun r : ℝ => Prop022AFock.WH U ((r : ℂ) • v)) =
      fun r : ℝ => WJ U.toLinearIsometry ((r : ℂ) • v) := funext fun r => WH_eq_WJ U _
  rw [h]
  exact WJ_isWeylGroup _ v

theorem WH_isWeylOp (U : H ≃ₗᵢ[ℂ] L2T L) (v : H) : IsWeylOp v (Prop022AFock.WH U v) := by
  rw [WH_eq_WJ]
  exact WJ_isWeylOp _ v


/-! ### Reusable standalone forms (for downstream transfers) -/

/-- **Unitary form.** For every unitary `U : H ≃ L²(𝕋_L)` and every intrinsic Weyl operator `W` of
`Fock(H)` with `IsWeylOp v W` (i.e. `W = exp(a*(v) - a(v))` characterized by Stone's generator), the
transported printed Weyl operator `Γ(U)⁻¹ W_L(Uv) Γ(U)` equals `W`. -/
theorem unitary_printedWeyl_eq_intrinsic (U : H ≃ₗᵢ[ℂ] L2T L) (v : H)
    (W : FockSpace H ≃ₗᵢ[ℂ] FockSpace H) (hW : IsWeylOp v W) (x : FockSpace H) :
    (Prop022AFock.gam U).symm
      (Prop022OVacuum.printedWeyl (U v) (Prop022AFock.gam U x)) = W x := by
  have h := weylOp_unique (WH_isWeylOp U v) hW
  rw [← h]
  rfl

/-- **Isometry (compressed) form.** For every isometry `J : H → L²(𝕋_L)` (in particular for finite-dimensional
`H`) and every `W` with `IsWeylOp v W`: `Γ(J)† W_L(Jv) Γ(J) = W`, where `W_L(Jv)` is the physical printed Weyl
operator; this uses that `W_L(Jv)` commutes with `Γ(R)` for `R` fixing `range J`. -/
theorem isometry_printedWeyl_eq_intrinsic (J : H →ₗᵢ[ℂ] L2T L) (v : H)
    (W : FockSpace H ≃ₗᵢ[ℂ] FockSpace H) (hW : IsWeylOp v W) (x : FockSpace H) :
    gamAdj J (Prop022OVacuum.printedWeyl (J v) (fockMapI J x)) = W x := by
  have h := weylOp_unique (WJ_isWeylOp J v) hW
  rw [← h]
  rfl

/-- The intrinsic Weyl operator intertwines with `Γ(J)`: `Γ(J) W = W_L(Jv) Γ(J)`. -/
theorem isometry_intrinsic_gam (J : H →ₗᵢ[ℂ] L2T L) (v : H)
    (W : FockSpace H ≃ₗᵢ[ℂ] FockSpace H) (hW : IsWeylOp v W) (x : FockSpace H) :
    fockMapI J (W x) = Prop022OVacuum.printedWeyl (J v) (fockMapI J x) := by
  have h := weylOp_unique (WJ_isWeylOp J v) hW
  rw [← h]
  exact gam_compress J _ _ x

end Compressed

