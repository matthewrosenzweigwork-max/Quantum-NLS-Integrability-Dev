import Mathlib
import QuantumNLS.ChartFrequencies

/-!
# REF88GradStructure: rotation-invariant functions on `ℓ²` have a radial differential
(R-EF8C2837, "Physical rotations on finite action supports")

Source: `source-text/chapters/global/physical_cubic.tex`, proof, paragraph "Physical rotations on finite action
supports" (printed lines 142 to 160):

  "... `e_F = E_F ∘ Φ_κ⁻¹` ... is therefore locally invariant under the standard rotations generated by the
   `q_n`. ... At a zero coordinate, rotational invariance forces the derivative of `e_F` in that coordinate
   to be zero. ... Boundedness of the full differential and density of finite coordinate vectors extend this
   vanishing to the entire complementary Hilbert subspace.  At an active coordinate its Hamiltonian field is
   `-i (∂_{a_n} h_F) z_n`."

This module is the pure `ℓ²` statement (no physics): if `e : ℓ² → ℝ` is invariant under every coordinate
rotation `rotE θ` and differentiable at `z`, and `z_n = 0` off a finite set `F`, then

  `de(z)[k] = ∑_{n∈F} (de(z)[z_n e_n] / |z_n|²) · Re(conj z_n k_n)`       (`D_eq_sum`),

and the Hamiltonian-vector-field pairing `Ω(∑_{n∈F} -i λ_n z_n e_n, k) = 2 ∑ λ_n Re(conj z_n k_n)` is
`omega_sum_single`.  Coordinate zeros use the half-turn (`D_single_zero`), active coordinates the one-parameter
rotation (`D_single_rot`); the complementary subspace uses `lp.hasSum_single` and continuity of `de(z)`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
noncomputable section

open scoped ComplexConjugate ENNReal InnerProductSpace
open Filter Topology

namespace QuantumNLS.REF88GradStructure

open QuantumNLS.RephasingFlow QuantumNLS.ChartFrequencies

abbrev sg (n : ℤ) (w : ℂ) : E := lp.single (E := fun _ : ℤ => ℂ) 2 n w

lemma sg_apply (n : ℤ) (w : ℂ) (m : ℤ) : (sg n w : ℤ → ℂ) m = if m = n then w else 0 := by
  simp [sg, lp.coeFn_single, Pi.single_apply]

lemma sg_add (n : ℤ) (a b : ℂ) : sg n (a + b) = sg n a + sg n b := by
  apply lp.ext; funext m
  simp only [sg_apply, lp.coeFn_add, Pi.add_apply]
  split_ifs <;> simp

lemma sg_real_smul (n : ℤ) (s : ℝ) (a : ℂ) : sg n ((s : ℂ) * a) = s • sg n a := by
  apply lp.ext; funext m
  simp only [sg_apply, lp.coeFn_smul, Pi.smul_apply, Complex.real_smul]
  split_ifs <;> simp

lemma sg_single_ne (n : ℤ) (w : ℂ) {m : ℤ} (h : m ≠ n) : (sg n w : ℤ → ℂ) m = 0 := by
  rw [sg_apply, if_neg h]

/-- the line `s ↦ z + s v` -/
lemma hasDerivAt_line (z v : E) : HasDerivAt (fun s : ℝ => z + s • v) v 0 := by
  simpa using ((hasDerivAt_id (0 : ℝ)).smul_const v).const_add z

section
variable {e : E → ℝ} {z : E}

/-- A zero coordinate: the half-turn `z + s w e_n ↦ z - s w e_n` forces a vanishing derivative. -/
theorem D_single_zero (hd : DifferentiableAt ℝ e z) (hinv : ∀ θ y, e (rotE θ y) = e y)
    {n : ℤ} (hzn : z n = 0) (w : ℂ) : fderiv ℝ e z (sg n w) = 0 := by
  set v := sg n w with hv
  have h1 : HasDerivAt (fun s : ℝ => e (z + s • v)) (fderiv ℝ e z v) 0 := by
    have hd' : HasFDerivAt e (fderiv ℝ e z) (z + (0 : ℝ) • v) := by
      simpa using hd.hasFDerivAt
    exact hd'.comp_hasDerivAt (0 : ℝ) (hasDerivAt_line z v)
  have hrot : ∀ s : ℝ, rotE (Pi.single n Real.pi) (z + s • v) = z + (-s) • v := by
    intro s
    apply lp.ext; funext m
    rw [rotE_apply]
    simp only [lp.coeFn_add, Pi.add_apply, lp.coeFn_smul, Pi.smul_apply, hv, sg_apply,
      Complex.real_smul]
    by_cases hm : m = n
    · subst hm
      simp [hzn, Complex.exp_pi_mul_I]
    · simp [hm]
  have hfun : (fun s : ℝ => e (z + s • v)) = fun s : ℝ => e (z + (-s) • v) := by
    funext s
    rw [← hrot s, hinv]
  have h2 : HasDerivAt (fun s : ℝ => e (z + (-s) • v)) (-(fderiv ℝ e z v)) 0 := by
    have h1' : HasDerivAt (fun s : ℝ => e (z + s • v)) (fderiv ℝ e z v) (-(0 : ℝ)) := by
      simpa using h1
    have := h1'.scomp (0 : ℝ) (hasDerivAt_neg (0 : ℝ))
    simpa [Function.comp_def] using this
  rw [hfun] at h1
  have := h1.unique h2
  linarith

/-- An active coordinate: the rotation of coordinate `n` has the radial-orthogonal direction `i z_n e_n`. -/
theorem D_single_rot (hd : DifferentiableAt ℝ e z) (hinv : ∀ θ y, e (rotE θ y) = e y) (n : ℤ) :
    fderiv ℝ e z (sg n (Complex.I * z n)) = 0 := by
  have hpath : ∀ s : ℝ, rotE (Pi.single n s) z = z + sg n ((Complex.exp ((s : ℂ) * Complex.I) - 1) * z n) := by
    intro s
    apply lp.ext; funext m
    rw [rotE_apply]
    simp only [lp.coeFn_add, Pi.add_apply, sg_apply]
    by_cases hm : m = n
    · subst hm; simp; ring
    · simp [hm]
  have hc : HasDerivAt (fun s : ℝ => (Complex.exp ((s : ℂ) * Complex.I) - 1) * z n)
      (Complex.I * z n) 0 := by
    have h0 : HasDerivAt (fun s : ℝ => ((s : ℂ) * Complex.I)) Complex.I 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).ofReal_comp).mul_const Complex.I
    have h1 := ((h0.cexp).sub_const 1).mul_const (z n)
    simpa using h1
  have hι := ((lp.singleContinuousLinearMap ℂ (fun _ : ℤ => ℂ) 2 n).restrictScalars ℝ).hasFDerivAt
    (x := (Complex.exp (((0 : ℝ) : ℂ) * Complex.I) - 1) * z n)
  have hs : HasDerivAt (fun s : ℝ => sg n ((Complex.exp ((s : ℂ) * Complex.I) - 1) * z n))
      (sg n (Complex.I * z n)) 0 := by
    have := hι.comp_hasDerivAt (0 : ℝ) hc
    simpa [Function.comp_def, sg] using this
  have hp : HasDerivAt (fun s : ℝ => z + sg n ((Complex.exp ((s : ℂ) * Complex.I) - 1) * z n))
      (sg n (Complex.I * z n)) 0 := hs.const_add z
  have h1 : HasDerivAt (fun s : ℝ => e (z + sg n ((Complex.exp ((s : ℂ) * Complex.I) - 1) * z n)))
      (fderiv ℝ e z (sg n (Complex.I * z n))) 0 := by
    have hz0 : z + sg n ((Complex.exp (((0 : ℝ) : ℂ) * Complex.I) - 1) * z n) = z := by simp
    have hd' : HasFDerivAt e (fderiv ℝ e z) (z + sg n ((Complex.exp (((0 : ℝ) : ℂ) * Complex.I) - 1) * z n)) := by
      rw [hz0]; exact hd.hasFDerivAt
    exact hd'.comp_hasDerivAt (0 : ℝ) hp
  have hfun : (fun s : ℝ => e (z + sg n ((Complex.exp ((s : ℂ) * Complex.I) - 1) * z n))) =
      fun _ => e z := by
    funext s
    rw [← hpath s, hinv]
  rw [hfun] at h1
  exact h1.unique (hasDerivAt_const _ _) |>.symm ▸ rfl

/-- The coordinate formula. -/
theorem D_single_formula (hd : DifferentiableAt ℝ e z) (hinv : ∀ θ y, e (rotE θ y) = e y)
    (n : ℤ) (w : ℂ) :
    fderiv ℝ e z (sg n w) =
      (fderiv ℝ e z (sg n (z n)) / ‖z n‖ ^ 2) * (conj (z n) * w).re := by
  by_cases hzn : z n = 0
  · rw [D_single_zero hd hinv hzn, hzn]; simp
  · have hn2 : (‖z n‖ ^ 2 : ℝ) ≠ 0 := by positivity
    set α : ℝ := (conj (z n) * w).re / ‖z n‖ ^ 2 with hα
    set β : ℝ := (conj (z n) * w).im / ‖z n‖ ^ 2 with hβ
    have hw : w = (α : ℂ) * z n + (β : ℂ) * (Complex.I * z n) := by
      set c : ℂ := conj ((z : ℤ → ℂ) n) * w with hcdef
      set N' : ℂ := ((‖(z : ℤ → ℂ) n‖ ^ 2 : ℝ) : ℂ) with hN'
      have hN'0 : N' ≠ 0 := by rw [hN']; exact_mod_cast hn2
      have hzz : conj ((z : ℤ → ℂ) n) * (z : ℤ → ℂ) n = N' := by
        rw [hN', Complex.conj_mul']; push_cast; ring
      have hc := Complex.re_add_im c
      have key : (α : ℂ) + (β : ℂ) * Complex.I = c / N' := by
        rw [eq_div_iff hN'0, hα, hβ, Complex.ofReal_div, Complex.ofReal_div, ← hN']
        field_simp
        linear_combination hc
      have : w = (c / N') * (z : ℤ → ℂ) n := by
        rw [div_mul_eq_mul_div, eq_div_iff hN'0, hcdef]
        calc w * N' = w * (conj ((z : ℤ → ℂ) n) * (z : ℤ → ℂ) n) := by rw [hzz]
          _ = _ := by ring
      calc w = (c / N') * (z : ℤ → ℂ) n := this
        _ = ((α : ℂ) + (β : ℂ) * Complex.I) * (z : ℤ → ℂ) n := by rw [key]
        _ = _ := by ring
    have hs : sg n w = α • sg n (z n) + β • sg n (Complex.I * z n) := by
      rw [hw, sg_add, sg_real_smul, sg_real_smul]
    rw [hs, map_add, map_smul, map_smul, D_single_rot hd hinv n]
    simp only [smul_eq_mul, mul_zero, add_zero, hα]
    field_simp

/-- **Radial structure of the differential.** -/
theorem D_eq_sum (hd : DifferentiableAt ℝ e z) (hinv : ∀ θ y, e (rotE θ y) = e y)
    (F : Finset ℤ) (hz : ∀ n, n ∉ F → z n = 0) (k : E) :
    fderiv ℝ e z k = ∑ n ∈ F,
      (fderiv ℝ e z (sg n (z n)) / ‖z n‖ ^ 2) * (conj (z n) * (k : ℤ → ℂ) n).re := by
  have hs := (lp.hasSum_single (E := fun _ : ℤ => ℂ) (p := 2) (by simp) k).mapL
    (fderiv ℝ e z)
  have hterm : ∀ n : ℤ, fderiv ℝ e z (lp.single (E := fun _ : ℤ => ℂ) 2 n ((k : ℤ → ℂ) n)) =
      (fderiv ℝ e z (sg n (z n)) / ‖z n‖ ^ 2) * (conj (z n) * (k : ℤ → ℂ) n).re :=
    fun n => D_single_formula hd hinv n _
  simp_rw [hterm] at hs
  have hfin : HasSum (fun n : ℤ => (fderiv ℝ e z (sg n (z n)) / ‖z n‖ ^ 2) *
      (conj (z n) * (k : ℤ → ℂ) n).re) (∑ n ∈ F,
      (fderiv ℝ e z (sg n (z n)) / ‖z n‖ ^ 2) * (conj (z n) * (k : ℤ → ℂ) n).re) := by
    apply hasSum_sum_of_ne_finset_zero
    intro n hn
    rw [hz n hn]; simp
  exact hs.unique hfin

end

/-- `Ω(∑_{n∈F} -i λ_n z_n e_n, k) = 2 ∑ λ_n Re(conj z_n k_n)`. -/
theorem omega_sum_single (F : Finset ℤ) (lam : ℤ → ℝ) (z k : E) :
    SymplecticBracket.omega
        (∑ n ∈ F, sg n (-Complex.I * ((lam n : ℝ) : ℂ) * z n)) k =
      ∑ n ∈ F, 2 * lam n * (conj (z n) * (k : ℤ → ℂ) n).re := by
  unfold SymplecticBracket.omega
  rw [sum_inner, Complex.im_sum]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [lp.inner_single_left]
  simp only [Complex.inner, map_mul, Complex.conj_ofReal, Complex.conj_I, neg_mul, map_neg]
  simp [Complex.mul_im, Complex.mul_re]
  ring

