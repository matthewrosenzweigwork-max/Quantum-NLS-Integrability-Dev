import QuantumNLS.MPOps
import QuantumNLS.MPContour
import QuantumNLS.Prop001RtwentyTheorem
import QuantumNLS.HighMomentsDerivative

/-!
# R-52CF5DA1 stage 4: the frozen-contour linear generator is a bounded interaction series

`prop:audit-finite-count-propagation` (GAUGE_RETARGETING.tex:101), proof paragraph "compare the fixed marginals with
those generated by the bounded interaction series `N Σ_{n∈F} t_n L^v_{N,n}`, `L^v_{N,n} = -(2πκ)⁻¹ Re ∮_{Γ_n}
S_N(z)/D_v(z) dz`, up to scalar terms."

Generic part (complex Hilbert spaces `E`, `F_j`; compact finite-measure parameter space `Θ`; bounded linear
placements `U_j : B(F_j) → B(E)` commuting with adjoints):
* `kerA`: the kernels `A_j = κ^{j+1} Re ∫ w(θ) K_j(θ) dν` (`Re X = (X + X^*)/2`), self-adjoint (`kerA_selfAdjoint`),
  with `‖A_j‖ ≤ ν(Θ) W M` whenever `‖w‖ ≤ W`, `|κ|^{j+1}‖K_j(θ)‖ ≤ M` (`kerA_norm_le`);
* **`N_Lop_gen`**: for `S(θ) = c(θ)·1 + Σ_{j<N} κ^{j+1} q_j U_j(K_j(θ))`,
  `N · Re ∫ u d S dν = (N Re ∫ u d c dν)·1 + N Σ_{j<N} q_j U_j(A_j)`.
Physical part: `UL` (the placement `U_{N,r}` as a bounded linear map of the kernel) and **`N_Lop_eq`**: for the actual
transfer `S_N(z) = normalizedTransfer L κ N z` along any continuous parameter path, `N L_N` is the scalar
`N Re ∫ u d (1 + e^{izL}) dν` plus the literal PROP-001 generator `Prop001.generator A N` of the frozen kernels.
No hypothesis is added; all inherited modules are read-only.
-/

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option linter.unusedSectionVars false
noncomputable section
open MeasureTheory Set Filter Topology
open scoped BigOperators InnerProductSpace

namespace QuantumNLS.R52CFKernels

open TensorCarrier KernelDefinition
open QuantumNLS.MixedQuadratures (reOp)

section ReOp
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

theorem reOp_add (X Y : E →L[ℂ] E) : reOp (X + Y) = reOp X + reOp Y := by
  unfold reOp
  rw [map_add]
  simp only [smul_add]
  abel

theorem reOp_sum {ι : Type*} (s : Finset ι) (X : ι → E →L[ℂ] E) :
    reOp (∑ i ∈ s, X i) = ∑ i ∈ s, reOp (X i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [reOp]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, reOp_add, ih]

theorem reOp_real_smul (a : ℝ) (X : E →L[ℂ] E) : reOp ((a : ℂ) • X) = (a : ℂ) • reOp X := by
  unfold reOp
  rw [map_smulₛₗ, Complex.conj_ofReal, ← smul_add, smul_comm]

theorem conj_half : (starRingEnd ℂ) (1 / 2 : ℂ) = 1 / 2 := by
  rw [show (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) by push_cast; ring, Complex.conj_ofReal]

theorem reOp_smul_one (z : ℂ) : reOp (z • (1 : E →L[ℂ] E)) = ((z.re : ℝ) : ℂ) • (1 : E →L[ℂ] E) := by
  unfold reOp
  rw [map_smulₛₗ, ContinuousLinearMap.adjoint_one, ← add_smul, smul_smul]
  congr 1
  apply Complex.ext <;> simp [Complex.add_re, Complex.add_im] <;> ring

theorem reOp_selfAdjoint (X : E →L[ℂ] E) : IsSelfAdjoint (reOp X) := by
  unfold reOp
  change ContinuousLinearMap.adjoint ((1 / 2 : ℂ) • (X + ContinuousLinearMap.adjoint X)) =
    (1 / 2 : ℂ) • (X + ContinuousLinearMap.adjoint X)
  rw [map_smulₛₗ, map_add, ContinuousLinearMap.adjoint_adjoint, add_comm (ContinuousLinearMap.adjoint X) X,
    conj_half]

theorem reOp_norm_le (X : E →L[ℂ] E) : ‖reOp X‖ ≤ ‖X‖ := by
  unfold reOp
  rw [norm_smul]
  have h := norm_add_le X (ContinuousLinearMap.adjoint X)
  rw [LinearIsometryEquiv.norm_map] at h
  have h2 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
  rw [h2]
  linarith

end ReOp

/-- A bounded additive homogeneous map of operators as a continuous linear map. -/
def mkCLM {F E : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F] [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (G : (F →L[ℂ] F) → (E →L[ℂ] E)) (hadd : ∀ X Y, G (X + Y) = G X + G Y)
    (hsmul : ∀ (c : ℂ) X, G (c • X) = c • G X) (hb : ∀ X, ‖G X‖ ≤ ‖X‖) :
    (F →L[ℂ] F) →L[ℂ] (E →L[ℂ] E) :=
  LinearMap.mkContinuous
    { toFun := G
      map_add' := hadd
      map_smul' := fun c X => hsmul c X } 1 (fun X => by
        show ‖G X‖ ≤ 1 * ‖X‖
        rw [one_mul]
        exact hb X)

theorem mkCLM_apply {F E : Type*} [NormedAddCommGroup F] [InnerProductSpace ℂ F] [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] (G : (F →L[ℂ] F) → (E →L[ℂ] E)) (hadd : ∀ X Y, G (X + Y) = G X + G Y)
    (hsmul : ∀ (c : ℂ) X, G (c • X) = c • G X) (hb : ∀ X, ‖G X‖ ≤ ‖X‖) (X : F →L[ℂ] F) :
    mkCLM G hadd hsmul hb X = G X := rfl

section Generic

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
  {F : ℕ → Type*} [∀ j, NormedAddCommGroup (F j)] [∀ j, InnerProductSpace ℂ (F j)] [∀ j, CompleteSpace (F j)]
  {Θ : Type*} [TopologicalSpace Θ] [CompactSpace Θ] [MeasurableSpace Θ] [OpensMeasurableSpace Θ]
  (ν : Measure Θ) [IsFiniteMeasure ν]

theorem integrable_of_cont {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] {f : Θ → X}
    (hf : Continuous f) : Integrable f ν :=
  hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace f)

/-- The frozen-contour interaction kernels `A_j = κ^{j+1} Re ∫ w(θ) K_j(θ) dν`. -/
def kerA (κ : ℝ) (w : Θ → ℂ) (K : ∀ j : ℕ, Θ → F j →L[ℂ] F j) (j : ℕ) : F j →L[ℂ] F j :=
  ((κ ^ (j + 1) : ℝ) : ℂ) • reOp (∫ θ, w θ • K j θ ∂ν)

/-- The scalar part `Re ∫ w c dν`. -/
def scal (w c : Θ → ℂ) : ℝ := (∫ θ, w θ * c θ ∂ν).re

theorem kerA_selfAdjoint (κ : ℝ) (w : Θ → ℂ) (K : ∀ j : ℕ, Θ → F j →L[ℂ] F j) (j : ℕ) :
    IsSelfAdjoint (kerA ν κ w K j) := by
  unfold kerA
  have hr : IsSelfAdjoint (((κ ^ (j + 1) : ℝ) : ℂ)) := Complex.conj_ofReal _
  exact IsSelfAdjoint.smul hr (reOp_selfAdjoint _)

theorem kerA_norm_le (κ : ℝ) (w : Θ → ℂ) (K : ∀ j : ℕ, Θ → F j →L[ℂ] F j) (j : ℕ)
    {W M : ℝ} (hw : ∀ θ, ‖w θ‖ ≤ W) (hK : ∀ θ, |κ| ^ (j + 1) * ‖K j θ‖ ≤ M) (hW : 0 ≤ W) :
    ‖kerA ν κ w K j‖ ≤ ν.real univ * W * M := by
  have hb : ∀ θ, |κ| ^ (j + 1) * ‖w θ • K j θ‖ ≤ W * M := by
    intro θ
    rw [norm_smul]
    calc |κ| ^ (j + 1) * (‖w θ‖ * ‖K j θ‖) = ‖w θ‖ * (|κ| ^ (j + 1) * ‖K j θ‖) := by ring
      _ ≤ W * M := mul_le_mul (hw θ) (hK θ) (by positivity) hW
  unfold kerA
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_pow]
  refine (mul_le_mul_of_nonneg_left (reOp_norm_le _) (by positivity)).trans ?_
  have he : |κ| ^ (j + 1) * ‖∫ θ, w θ • K j θ ∂ν‖ =
      ‖∫ θ, ((|κ| ^ (j + 1) : ℝ) : ℂ) • (w θ • K j θ) ∂ν‖ := by
    rw [integral_smul, norm_smul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  rw [he]
  refine (norm_integral_le_of_norm_le_const (C := W * M) (Eventually.of_forall fun θ => ?_)).trans
    (le_of_eq (by ring))
  rw [norm_smul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
  exact hb θ

/-- **The decomposition of the frozen-contour linear generator (generic form).** -/
theorem N_Lop_gen (κ : ℝ) (N : ℕ) (U : ∀ j : Fin N, (F (j : ℕ) →L[ℂ] F j) →L[ℂ] (E →L[ℂ] E))
    (hU : ∀ (j : Fin N) (X : F (j : ℕ) →L[ℂ] F j),
      ContinuousLinearMap.adjoint (U j X) = U j (ContinuousLinearMap.adjoint X))
    (q : Fin N → ℝ) (u d c : Θ → ℂ) (K : ∀ j : ℕ, Θ → F j →L[ℂ] F j)
    (hu : Continuous u) (hd : Continuous d) (hc : Continuous c) (hK : ∀ j, Continuous (K j)) :
    ((N : ℕ) : ℂ) • MPOps.Lop ν (fun θ => c θ • ContinuousLinearMap.id ℂ E +
        ∑ j : Fin N, (((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (K j θ)) u d =
      ((((N : ℕ) : ℝ) * scal ν (fun θ => u θ * d θ) c : ℝ) : ℂ) • (1 : E →L[ℂ] E) +
        ((N : ℕ) : ℂ) • ∑ j : Fin N, ((q j : ℝ) : ℂ) • U j (kerA ν κ (fun θ => u θ * d θ) K j) := by
  have hw : Continuous (fun θ => u θ * d θ) := hu.mul hd
  set w : Θ → ℂ := fun θ => u θ * d θ with hwdef
  have hint_c : Integrable (fun θ => (w θ * c θ) • (1 : E →L[ℂ] E)) ν :=
    integrable_of_cont ν ((hw.mul hc).smul continuous_const)
  have hint_K : ∀ j : ℕ, Integrable (fun θ => w θ • K j θ) ν :=
    fun j => integrable_of_cont ν (hw.smul (hK j))
  have hint_U : ∀ j : Fin N, Integrable (fun θ => w θ • ((((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) •
      U j (K j θ))) ν := by
    intro j
    have h0 : Integrable (fun θ => U j (w θ • K j θ)) ν := (U j).integrable_comp (hint_K j)
    have h1 := h0.smul ((((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ))
    refine h1.congr (Eventually.of_forall fun θ => ?_)
    change (((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (w θ • K j θ) =
      w θ • ((((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (K j θ))
    rw [map_smul, smul_comm]
  have hexp : ∀ θ, w θ • (c θ • ContinuousLinearMap.id ℂ E +
        ∑ j : Fin N, (((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (K j θ)) =
      (w θ * c θ) • (1 : E →L[ℂ] E) +
        ∑ j : Fin N, w θ • ((((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (K j θ)) := by
    intro θ
    rw [smul_add, Finset.smul_sum, smul_smul]
    rfl
  have hI : ∫ θ, w θ • (c θ • ContinuousLinearMap.id ℂ E +
        ∑ j : Fin N, (((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (K j θ)) ∂ν =
      (∫ θ, w θ * c θ ∂ν) • (1 : E →L[ℂ] E) +
        ∑ j : Fin N, (((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (∫ θ, w θ • K j θ ∂ν) := by
    simp_rw [hexp]
    rw [integral_add hint_c (integrable_finsetSum _ (fun j _ => hint_U j)), integral_finsetSum _
      (fun j _ => hint_U j), integral_smul_const]
    congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    have e1 : ∀ θ, w θ • ((((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (K j θ)) =
        (((κ ^ ((j : ℕ) + 1) : ℝ) * q j : ℝ) : ℂ) • U j (w θ • K j θ) := by
      intro θ
      rw [map_smul, smul_comm]
    simp_rw [e1]
    rw [integral_smul, ContinuousLinearMap.integral_comp_comm _ (hint_K j)]
  unfold MPOps.Lop
  rw [hI, reOp_add, reOp_smul_one, reOp_sum]
  unfold kerA scal
  rw [smul_add, smul_smul]
  congr 1
  · congr 1
    push_cast
    ring
  · congr 1
    refine Finset.sum_congr rfl fun j _ => ?_
    have hre : reOp (U j (∫ θ, w θ • K j θ ∂ν)) = U j (reOp (∫ θ, w θ • K j θ ∂ν)) := by
      unfold reOp
      rw [hU, ← map_add, ← map_smul]
    rw [reOp_real_smul, hre, map_smul, smul_smul]
    congr 1
    push_cast
    ring

end Generic

section Physical
variable {L : ℝ} [Fact (0 < L)]

/-- `U_{N,r}` as a bounded linear map of the kernel. -/
def UL (N r : ℕ) (hr : r ≤ N) :
    (SymSector ℂ (PhysicalTensor.L2T L) r →L[ℂ] SymSector ℂ (PhysicalTensor.L2T L) r) →L[ℂ]
      (SymSector ℂ (PhysicalTensor.L2T L) N →L[ℂ] SymSector ℂ (PhysicalTensor.L2T L) N) :=
  mkCLM (genericU_N_r N r hr) (fun A B => RootOverlapLimit.genericU_add N r hr A B)
    (fun c A => RootOverlapLimit.genericU_smul N r hr c A) (fun A => norm_genericU_N_r_le N r hr A)

/-- The physical transfer kernels along a parameter path. -/
def physK {Θ : Type*} (z : Θ → ℂ) (j : ℕ) (θ : Θ) :
    SymSector ℂ (PhysicalTensor.L2T L) (j + 1) →L[ℂ] SymSector ℂ (PhysicalTensor.L2T L) (j + 1) :=
  NormalizedTransfer.orderedKernel L (j + 1) (z θ)

theorem cont_of_diff {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X] (f : ℂ → X)
    (hf : Differentiable ℂ f) : Continuous f := hf.continuous

set_option synthInstance.maxHeartbeats 4000000 in
theorem physK_continuous {Θ : Type*} [TopologicalSpace Θ] (z : Θ → ℂ) (hz : Continuous z) (j : ℕ) :
    Continuous (physK (L := L) z j) :=
  (HighMomentsDerivative.differentiable_physicalKernel L (j + 1)).continuous.comp hz

variable {Θ : Type*} [TopologicalSpace Θ] [CompactSpace Θ] [MeasurableSpace Θ] [OpensMeasurableSpace Θ]
  (ν : Measure Θ) [IsFiniteMeasure ν]

/-- **`N L_N` = scalar + the literal PROP-001 generator of the frozen kernels.** -/
theorem N_Lop_eq (κ : ℝ) (N : ℕ) (z u d : Θ → ℂ) (hz : Continuous z) (hu : Continuous u) (hd : Continuous d) :
    ((N : ℕ) : ℂ) • MPOps.Lop ν (fun θ => NormalizedTransfer.normalizedTransfer L κ N (z θ)) u d =
      ((((N : ℕ) : ℝ) * scal ν (fun θ => u θ * d θ) (fun θ => 1 + Complex.exp (Complex.I * z θ * L)) : ℝ) : ℂ) •
        (1 : SymSector ℂ (PhysicalTensor.L2T L) N →L[ℂ] SymSector ℂ (PhysicalTensor.L2T L) N) +
        Prop001.generator (kerA ν κ (fun θ => u θ * d θ) (physK (L := L) z)) N := by
  have h := N_Lop_gen (F := fun j => SymSector ℂ (PhysicalTensor.L2T L) (j + 1)) ν κ N
    (fun j => UL N ((j : ℕ) + 1) j.2)
    (fun j X => GenericUAdjoint.adjoint_genericU_N_r N ((j : ℕ) + 1) j.2 X)
    (fun j => Prop001.theta N ((j : ℕ) + 1)) u d (fun θ => 1 + Complex.exp (Complex.I * z θ * L))
    (physK (L := L) z) hu hd (by fun_prop) (fun j => physK_continuous z hz j)
  convert h using 2 <;> rfl

end Physical

end QuantumNLS.R52CFKernels

#print axioms QuantumNLS.R52CFKernels.N_Lop_eq
