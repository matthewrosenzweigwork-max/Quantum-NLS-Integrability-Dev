section FLPart7

open NormedSpace ComplexConjugate MeasureTheory
open scoped InnerProductSpace FourierTransform ContDiff

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

section Final

variable {K : Set (EuclideanSpace ℝ (Fin d))} [CompactSpace K]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (Φ : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))

/-- The Schwartz function of a real smooth compactly supported `F` (complex valued). -/
def schwartzOfReal (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : ContDiff ℝ ∞ F) (hFc : HasCompactSupport F) :
    SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ :=
  (HasCompactSupport.toSchwartzMap (f := fun x => ((F x : ℝ) : ℂ))
    (hFc.comp_left (g := fun r : ℝ => (r : ℂ)) (by simp))
    (Complex.ofRealCLM.contDiff.comp hF))

/-- `F(B)`: the joint functional calculus `Φ` applied to `F`. -/
def Fop (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : Continuous F) : H →L[ℂ] H :=
  Φ (liftC (fun x => ((F x : ℝ) : ℂ)) (Complex.continuous_ofReal.comp hF))

/-- `H_N = N F(B_N)`. -/
def Hnl (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : Continuous F) (N : ℝ) : H →L[ℂ] H :=
  (N : ℂ) • Fop Φ F hF

/-- `H_N^lin = N ∑_j ∂_jF(b) B_{N,j}`. -/
def Hlin (F : EuclideanSpace ℝ (Fin d) → ℝ) (b : EuclideanSpace ℝ (Fin d)) (N : ℝ) : H →L[ℂ] H :=
  (N : ℂ) • ∑ j : Fin d, ((fderiv ℝ F b (EuclideanSpace.single j 1) : ℝ) : ℂ) • Φ (coordC j)

theorem commute_Phi (g1 g2 : C(K, ℂ)) : Commute (Φ g1) (Φ g2) := (Commute.all g1 g2).map Φ

theorem isSelfAdjoint_coordC (j : Fin d) : IsSelfAdjoint (coordC (K := K) j) := by
  unfold IsSelfAdjoint
  ext x
  simp [coordC, liftC, ContinuousMap.star_apply]

theorem fderiv_ofReal (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : ContDiff ℝ ∞ F)
    (b m : EuclideanSpace ℝ (Fin d)) :
    fderiv ℝ (fun x => ((F x : ℝ) : ℂ)) b m = ((fderiv ℝ F b m : ℝ) : ℂ) := by
  have hd : DifferentiableAt ℝ F b := (hF.differentiable (by simp)).differentiableAt
  have h := (Complex.ofRealCLM.hasFDerivAt.comp b hd.hasFDerivAt).fderiv
  have e : (fun x => ((F x : ℝ) : ℂ)) = Complex.ofRealCLM ∘ F := rfl
  rw [e, h]
  rfl

theorem commute_evol {X T : H →L[ℂ] H} (h : Commute X T) (s : ℝ) : Commute X (evol T s) := by
  unfold evol
  exact ((h.smul_right Complex.I).smul_right (-s)).exp_right

theorem CF_nonneg (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) : 0 ≤ CF f := by
  unfold CF
  positivity

/-- **PROP-014 `lem:A4-functional-linearization`.**  `Φ` is the joint continuous functional
calculus of the commuting self-adjoint tuple `B_j = Φ(x_j)` (spectra in the compact set `K`),
`F` a real `C^∞` function with compact support. -/
theorem functional_linearization (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : ContDiff ℝ ∞ F)
    (hFc : HasCompactSupport F) (b : EuclideanSpace ℝ (Fin d)) (N : ℝ) (hN : 0 < N) (ψ : H)
    (hψ : ‖ψ‖ = 1) {δ : ℝ} (hδ : 0 ≤ δ)
    (hψδ : ∀ j, ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) ψ‖ ≤ δ)
    (J : H →L[ℂ] H) {CJ : ℝ} (hCJ : 0 ≤ CJ)
    (hJ : ∀ j, ‖Φ (coordC j) * J - J * Φ (coordC j)‖ ≤ CJ / N) (t T : ℝ) (ht : |t| ≤ T) :
    ‖⟪evol (Hnl Φ F hF.continuous N) t ψ, J (evol (Hnl Φ F hF.continuous N) t ψ)⟫_ℂ -
        ⟪evol (Hlin Φ F b N) t ψ, J (evol (Hlin Φ F b N) t ψ)⟫_ℂ‖ ≤
      CF (schwartzOfReal F hF hFc) * T * CJ * δ := by
  have : Nontrivial H := ⟨⟨ψ, 0, fun h => by rw [h] at hψ; simp at hψ⟩⟩
  set f := schwartzOfReal F hF hFc with hf
  have hfc : ∀ x, (f : EuclideanSpace ℝ (Fin d) → ℂ) x = ((F x : ℝ) : ℂ) := fun x => rfl
  have hfd : ∀ j : Fin d, fderiv ℝ (f : EuclideanSpace ℝ (Fin d) → ℂ) b (EuclideanSpace.single j 1) =
      ((fderiv ℝ F b (EuclideanSpace.single j 1) : ℝ) : ℂ) := fun j => fderiv_ofReal F hF b _
  obtain ⟨R, hR0, hR⟩ : ∃ R : ℝ, 0 ≤ R ∧ ∀ x : K, ‖(x : EuclideanSpace ℝ (Fin d)) - b‖ ≤ R := by
    obtain ⟨C, hC⟩ := (isCompact_univ : IsCompact (Set.univ : Set K)).exists_bound_of_continuousOn
      (f := fun x : K => (x : EuclideanSpace ℝ (Fin d)) - b)
      (by fun_prop : Continuous fun x : K => (x : EuclideanSpace ℝ (Fin d)) - b).continuousOn
    exact ⟨max C 0, le_max_right _ _, fun x => (hC x (Set.mem_univ x)).trans (le_max_left _ _)⟩
  -- the operators as images of `Φ`
  set gC : C(K, ℂ) := liftC (fun x => ((F x : ℝ) : ℂ)) (Complex.continuous_ofReal.comp hF.continuous) -
    ∑ j : Fin d, ((fderiv ℝ F b (EuclideanSpace.single j 1) : ℝ) : ℂ) • coordC j with hgC
  set linC : C(K, ℂ) := ∑ j : Fin d, ((fderiv ℝ F b (EuclideanSpace.single j 1) : ℝ) : ℂ) • coordC j
    with hlinC
  have hHlin : Hlin Φ F b N = (N : ℂ) • Φ linC := by
    simp only [Hlin, hlinC, map_sum, map_smul]
  have hD : Hnl Φ F hF.continuous N - Hlin Φ F b N = (N : ℂ) • Φ gC := by
    rw [hHlin, hgC, map_sub, smul_sub]; rfl
  set D := Hnl Φ F hF.continuous N - Hlin Φ F b N with hDdef
  have hNsa : IsSelfAdjoint (N : ℂ) := by simp [IsSelfAdjoint]
  have hsa_lin : IsSelfAdjoint linC := by
    rw [hlinC]
    unfold IsSelfAdjoint
    ext x
    simp [coordC, liftC, ContinuousMap.star_apply, Finset.sum_apply, map_sum]
  have hsa_cast : IsSelfAdjoint (liftC (K := K) (fun x => ((F x : ℝ) : ℂ))
      (Complex.continuous_ofReal.comp hF.continuous)) := by
    unfold IsSelfAdjoint
    ext x
    simp [liftC, ContinuousMap.star_apply]
  have hsa_g : IsSelfAdjoint gC := by rw [hgC]; exact hsa_cast.sub hsa_lin
  have hDsa : IsSelfAdjoint D := by rw [hD]; exact hNsa.smul (hsa_g.map Φ)
  have hLsa : IsSelfAdjoint (Hlin Φ F b N) := by rw [hHlin]; exact hNsa.smul (hsa_lin.map Φ)
  have hcomm : Commute D (Hlin Φ F b N) := by
    rw [hD, hHlin]; exact ((commute_Phi Φ gC linC).smul_left _).smul_right _
  -- the Taylor remainder form of `D`
  set κ0 : ℂ := ((F b : ℝ) : ℂ) - ∑ j : Fin d, ((fderiv ℝ F b (EuclideanSpace.single j 1) : ℝ) : ℂ) *
    ((b j : ℝ) : ℂ) with hκ0
  have hg_rem : gC = remC (K := K) f b + κ0 • (1 : C(K, ℂ)) := by
    ext x
    simp only [hgC, hlinC, remC, liftC, coordC, hκ0, ContinuousMap.sub_apply, ContinuousMap.add_apply,
      ContinuousMap.smul_apply, ContinuousMap.coe_mk, ContinuousMap.coe_sum, Finset.sum_apply,
      ContinuousMap.one_apply, smul_eq_mul, hfd, hfc, mul_one, mul_sub, Finset.sum_sub_distrib]
    ring
  have hDform : D = (N : ℂ) • Φ (remC (K := K) f b) + ((N : ℂ) * κ0) • (1 : H →L[ℂ] H) := by
    rw [hD, hg_rem, map_add, map_smul, map_one, smul_add, smul_smul]
  have hDJ : D * J - J * D = (N : ℂ) • (Φ (remC (K := K) f b) * J - J * Φ (remC (K := K) f b)) := by
    rw [hDform, add_mul, mul_add, smul_mul_assoc, smul_mul_assoc, mul_smul_comm, mul_smul_comm,
      one_mul, mul_one, smul_sub]
    abel
  -- the key estimate for all intermediate states
  have hNne : (N : ℂ) ≠ 0 := by exact_mod_cast hN.ne'
  have hmain : ∀ s : ℝ, ‖⟪evol D s (evol (Hlin Φ F b N) t ψ), (D * J - J * D)
      (evol D s (evol (Hlin Φ F b N) t ψ))⟫_ℂ‖ ≤ CF f * δ * CJ := by
    intro s
    set w := evol (Hlin Φ F b N) t ψ with hw
    set φ := evol D s w with hφ
    have hw1 : ‖w‖ ≤ 1 := by
      have h1 : ‖evol (Hlin Φ F b N) t‖ ≤ 1 := by
        unfold evol; exact norm_exp_le hLsa (-t)
      calc ‖w‖ ≤ ‖evol (Hlin Φ F b N) t‖ * ‖ψ‖ := (evol (Hlin Φ F b N) t).le_opNorm ψ
        _ ≤ 1 * 1 := by rw [hψ]; gcongr
        _ = 1 := one_mul 1
    have hφ1 : ‖φ‖ ≤ 1 := by
      have h1 : ‖evol D s‖ ≤ 1 := by unfold evol; exact norm_exp_le hDsa (-s)
      calc ‖φ‖ ≤ ‖evol D s‖ * ‖w‖ := (evol D s).le_opNorm w
        _ ≤ 1 * 1 := by gcongr
        _ = 1 := one_mul 1
    have hX : ∀ j, ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) φ‖ ≤ δ := by
      intro j
      have hXj : Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H) =
          Φ (coordC j - ((b j : ℝ) : ℂ) • (1 : C(K, ℂ))) := by
        rw [map_sub, map_smul, map_one]
      have hc1 : Commute (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) D := by
        rw [hXj, hD]; exact ((commute_Phi Φ _ gC).smul_right _)
      have hc2 : Commute (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) (Hlin Φ F b N) := by
        rw [hXj, hHlin]; exact ((commute_Phi Φ _ linC).smul_right _)
      have e : (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) φ =
          evol D s (evol (Hlin Φ F b N) t ((Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) ψ)) := by
        have h1 := (commute_evol hc1 s).eq
        have h2 := (commute_evol hc2 t).eq
        rw [hφ, hw]
        calc _ = ((Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) * evol D s) (evol (Hlin Φ F b N) t ψ) := rfl
          _ = (evol D s * (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H))) (evol (Hlin Φ F b N) t ψ) := by rw [h1]
          _ = evol D s (((Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) * evol (Hlin Φ F b N) t) ψ) := rfl
          _ = _ := by rw [h2]; rfl
      rw [e]
      have n1 : ‖evol D s‖ ≤ 1 := by unfold evol; exact norm_exp_le hDsa (-s)
      have n2 : ‖evol (Hlin Φ F b N) t‖ ≤ 1 := by unfold evol; exact norm_exp_le hLsa (-t)
      calc _ ≤ ‖evol D s‖ * ‖evol (Hlin Φ F b N) t
            ((Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) ψ)‖ := (evol D s).le_opNorm _
        _ ≤ 1 * (1 * ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) ψ‖) := by
            gcongr
            exact ((evol (Hlin Φ F b N) t).le_opNorm _).trans (by gcongr)
        _ ≤ δ := by simpa using hψδ j
    have hJ' : ∀ j, ‖Φ (coordC j) * J - J * Φ (coordC j)‖ ≤ CJ / N := hJ
    have hkey := Phi_remC_bound Φ f b hR0 hR J φ hφ1 hδ (div_nonneg hCJ hN.le) hX hJ'
    rw [hDJ, smul_apply, inner_smul_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hN]
    calc N * ‖⟪φ, (Φ (remC (K := K) f b) * J - J * Φ (remC (K := K) f b)) φ⟫_ℂ‖ ≤
          N * (CF f * δ * (CJ / N)) := by gcongr
      _ = CF f * δ * CJ := by field_simp
  have hfin := time_bound hDsa hcomm ψ J t hmain
  have hH : Hnl Φ F hF.continuous N = D + Hlin Φ F b N := (sub_add_cancel _ _).symm
  rw [hH]
  refine hfin.trans ?_
  have h0 : 0 ≤ CF f := CF_nonneg f
  calc CF f * δ * CJ * |t| ≤ CF f * δ * CJ * T := by gcongr
    _ = CF f * T * CJ * δ := by ring

end Final

end QuantumNLS.FunctionalLinearization

