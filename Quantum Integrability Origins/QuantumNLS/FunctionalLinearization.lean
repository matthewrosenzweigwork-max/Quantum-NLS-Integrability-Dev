section FLPart6

open NormedSpace ComplexConjugate
open scoped InnerProductSpace

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] [Nontrivial H]

/-- The unitary group `e^{-itH}` of a bounded operator, as the norm-convergent exponential. -/
def evol (T : H →L[ℂ] H) (t : ℝ) : H →L[ℂ] H := exp ((-t) • (Complex.I • T))

theorem evol_zero (T : H →L[ℂ] H) : evol T 0 = 1 := by
  unfold evol; simp

theorem hasDerivAt_evol_apply {D : H →L[ℂ] H} (v : H) (s : ℝ) :
    HasDerivAt (fun s : ℝ => evol D s v) (-(Complex.I • (D (evol D s v)))) s := by
  have hx : ∀ s : ℝ, evol D s = exp (s • (-(Complex.I • D))) := fun s => by
    unfold evol; rw [neg_smul, smul_neg]
  have h := hasDerivAt_apply (hasDerivAt_exp_smul_const (-(Complex.I • D)) s) v
  have hc : exp (s • (-(Complex.I • D))) * (-(Complex.I • D)) =
      (-(Complex.I • D)) * exp (s • (-(Complex.I • D))) :=
    (((Commute.refl (-(Complex.I • D))).smul_left s).exp_left).eq
  have e : (fun s : ℝ => evol D s v) = fun s : ℝ => exp (s • (-(Complex.I • D))) v := by
    funext s; rw [hx]
  rw [e]
  refine h.congr_deriv ?_
  rw [hc, hx s]
  simp

theorem evol_add {D G : H →L[ℂ] H} (hDG : Commute D G) (t : ℝ) :
    evol (D + G) t = evol D t * evol G t := by
  let +nondep : NormedAlgebra ℚ (H →L[ℂ] H) := .restrictScalars ℚ ℂ _
  have hc : Commute ((-t) • (Complex.I • D)) ((-t) • (Complex.I • G)) :=
    (((hDG.smul_left Complex.I).smul_right Complex.I).smul_left (-t)).smul_right (-t)
  unfold evol
  rw [smul_add, smul_add, exp_add_of_commute hc]

theorem time_bound {D G : H →L[ℂ] H} (hD : IsSelfAdjoint D) (hDG : Commute D G) (ψ : H)
    (J : H →L[ℂ] H) (t : ℝ) {M : ℝ}
    (hM : ∀ s : ℝ, ‖⟪evol D s (evol G t ψ), (D * J - J * D) (evol D s (evol G t ψ))⟫_ℂ‖ ≤ M) :
    ‖⟪evol (D + G) t ψ, J (evol (D + G) t ψ)⟫_ℂ - ⟪evol G t ψ, J (evol G t ψ)⟫_ℂ‖ ≤ M * |t| := by
  have hsym : ∀ a b : H, ⟪D a, b⟫_ℂ = ⟪a, D b⟫_ℂ :=
    ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp hD
  set v := evol G t ψ with hv
  have hg : ∀ s : ℝ, HasDerivAt (fun s : ℝ => ⟪evol D s v, J (evol D s v)⟫_ℂ)
      (Complex.I * ⟪evol D s v, (D * J - J * D) (evol D s v)⟫_ℂ) s := by
    intro s
    have hφ := hasDerivAt_evol_apply (D := D) v s
    have hJφ : HasDerivAt (fun s : ℝ => J (evol D s v)) (J (-(Complex.I • D (evol D s v)))) s :=
      ((J.restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt s hφ)
    have h := HasDerivAt.inner ℂ hφ hJφ
    refine h.congr_deriv ?_
    set φ := evol D s v
    have e1 : ⟪φ, J (-(Complex.I • D φ))⟫_ℂ = -(Complex.I * ⟪φ, J (D φ)⟫_ℂ) := by
      rw [map_neg, map_smul, inner_neg_right, inner_smul_right]
    have e2 : ⟪-(Complex.I • D φ), J φ⟫_ℂ = Complex.I * ⟪φ, D (J φ)⟫_ℂ := by
      rw [inner_neg_left, inner_smul_left, hsym]
      simp [Complex.conj_I]
    have e3 : (D * J - J * D) φ = D (J φ) - J (D φ) := rfl
    rw [e1, e2, e3, inner_sub_right]
    ring
  have hm := mvt_real hg (fun s => by
    rw [norm_mul, Complex.norm_I, one_mul]; exact hM s) 0 t
  have e0 : evol D 0 v = v := by rw [evol_zero]; rfl
  have et : evol D t v = evol (D + G) t ψ := by rw [evol_add hDG]; rfl
  simp only [e0, et] at hm
  simpa using hm

end QuantumNLS.FunctionalLinearization

end

