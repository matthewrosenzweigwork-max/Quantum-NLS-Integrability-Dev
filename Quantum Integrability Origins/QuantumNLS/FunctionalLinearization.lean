section FLPart8

open NormedSpace
open scoped IsMulCommutative
noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The closed commutative C*-algebra generated by a commuting family of self-adjoint operators. -/
def genAlg {d : ℕ} (B : Fin d → H →L[ℂ] H) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range B)).topologicalClosure

theorem genAlg_comm {d : ℕ} (B : Fin d → H →L[ℂ] H) (hsa : ∀ j, IsSelfAdjoint (B j))
    (hcomm : ∀ i j, Commute (B i) (B j)) : IsMulCommutative (genAlg B) := by
  have hn : ∀ x ∈ Set.range B, IsStarNormal x := by
    rintro _ ⟨i, rfl⟩; exact (hsa i).isStarNormal
  have hc : (Set.range B).Pairwise Commute := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _; exact hcomm i j
  have hcs : (Set.range B).Pairwise (Commute · <| star ·) := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _
    rw [(hsa j).star_eq]; exact hcomm i j
  have : IsMulCommutative (StarAlgebra.adjoin ℂ (Set.range B)) :=
    StarAlgebra.isMulCommutative_adjoin ℂ hn hc hcs
  exact StarSubalgebra.isMulCommutative_topologicalClosure _

theorem genAlg_mem {d : ℕ} (B : Fin d → H →L[ℂ] H) (j : Fin d) : B j ∈ genAlg B :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨j, rfl⟩)

instance genAlg_commC {d : ℕ} (B : Fin d → H →L[ℂ] H) [IsMulCommutative (genAlg B)] :
    CommCStarAlgebra (genAlg B) := by
  haveI : IsClosed ((genAlg B : StarSubalgebra ℂ (H →L[ℂ] H)) : Set (H →L[ℂ] H)) :=
    StarSubalgebra.isClosed_topologicalClosure _
  infer_instance

open WeakDual

/-- **Existence of the joint functional calculus** (Gelfand duality for the closed commutative
C*-algebra generated by the tuple): for commuting bounded self-adjoint `B_j` there is a compact
set `K ⊂ ℝ^d` (the joint spectrum) and a unital `*`-homomorphism `Φ : C(K,ℂ) → B(H)` with
`Φ(x_j) = B_j`; the coordinates of points of `K` lie in the spectra of the `B_j`. -/
theorem exists_functional_calculus {d : ℕ} (B : Fin d → H →L[ℂ] H) (hsa : ∀ j, IsSelfAdjoint (B j))
    (hcomm : ∀ i j, Commute (B i) (B j)) :
    ∃ (K : Set (EuclideanSpace ℝ (Fin d))) (_ : CompactSpace K) (Φ : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)),
      (∀ j, Φ (coordC j) = B j) ∧ ∀ x ∈ K, ∀ j, ((x j : ℝ) : ℂ) ∈ spectrum ℂ (B j) := by
  haveI := genAlg_comm B hsa hcomm
  let S := genAlg B
  let b : Fin d → S := fun j => ⟨B j, genAlg_mem B j⟩
  let χ : characterSpace ℂ S → EuclideanSpace ℝ (Fin d) := fun φ =>
    (EuclideanSpace.equiv (Fin d) ℝ).symm (fun j => (φ (b j)).re)
  have hχ : Continuous χ :=
    (EuclideanSpace.equiv (Fin d) ℝ).symm.continuous.comp
      (continuous_pi fun j => Complex.continuous_re.comp (gelfandTransform ℂ S (b j)).continuous)
  have hK : IsCompact (Set.range χ) := isCompact_range hχ
  haveI : CompactSpace (Set.range χ) := isCompact_iff_compactSpace.mp hK
  let χK : C(characterSpace ℂ S, Set.range χ) := ⟨fun φ => ⟨χ φ, ⟨φ, rfl⟩⟩, by fun_prop⟩
  let Φ0 : C(Set.range χ, ℂ) →⋆ₐ[ℂ] S :=
    (gelfandStarTransform S).symm.toStarAlgHom.comp (ContinuousMap.compStarAlgHom' ℂ ℂ χK)
  let Φ : C(Set.range χ, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H) := (StarSubalgebra.subtype S).comp Φ0
  have hreal : ∀ (φ : characterSpace ℂ S) (j : Fin d), φ (b j) = (((φ (b j)).re : ℝ) : ℂ) := by
    intro φ j
    have h1 : star (φ (b j)) = φ (b j) := by
      rw [← map_star φ]
      congr 1
      exact Subtype.ext (hsa j).star_eq
    exact (Complex.conj_eq_iff_re.mp h1).symm
  have hcoord : ∀ j, Φ0 (coordC j) = b j := by
    intro j
    have : (gelfandStarTransform S) (b j) = ContinuousMap.comp (coordC j) χK := by
      ext φ
      simp only [gelfandStarTransform_apply_apply, coordC, liftC, ContinuousMap.comp_apply,
        ContinuousMap.coe_mk, χK, χ]
      exact hreal φ j
    show (gelfandStarTransform S).symm (ContinuousMap.comp (coordC j) χK) = b j
    rw [← this]
    exact StarAlgEquiv.symm_apply_apply _ _
  haveI hcl : IsClosed ((genAlg B : StarSubalgebra ℂ (H →L[ℂ] H)) : Set (H →L[ℂ] H)) :=
    StarSubalgebra.isClosed_topologicalClosure _
  refine ⟨Set.range χ, inferInstance, Φ, fun j => ?_, ?_⟩
  · show ((Φ0 (coordC j) : S) : H →L[ℂ] H) = B j
    rw [hcoord j]
  · rintro _ ⟨φ, rfl⟩ j
    have h1 : φ (b j) ∈ spectrum ℂ (b j) := CharacterSpace.apply_mem_spectrum φ (b j)
    have h2 : φ (b j) ∈ spectrum ℂ (B j) := (StarSubalgebra.mem_spectrum_iff (S := S)).mp h1
    have h3 : ((((EuclideanSpace.equiv (Fin d) ℝ).symm fun j => (φ (b j)).re).ofLp j : ℝ) : ℂ) =
        φ (b j) := (hreal φ j).symm
    rw [h3]; exact h2

/-- **Uniqueness of the joint functional calculus** (Stone–Weierstrass): a unital `*`-homomorphism
`C(K,ℂ) → B(H)` is determined by its values on the coordinate functions. -/
theorem functional_calculus_unique {d : ℕ} {K : Set (EuclideanSpace ℝ (Fin d))} [CompactSpace K]
    (Φ Ψ : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H)) (h : ∀ j, Φ (coordC j) = Ψ (coordC j)) : Φ = Ψ := by
  let A : StarSubalgebra ℂ C(K, ℂ) := StarAlgebra.adjoin ℂ (Set.range (coordC (K := K)))
  have hsep : A.SeparatesPoints := by
    intro x y hxy
    have : ∃ j, (x : EuclideanSpace ℝ (Fin d)) j ≠ (y : EuclideanSpace ℝ (Fin d)) j := by
      by_contra hcon
      push_neg at hcon
      exact hxy (Subtype.ext (by ext j; exact hcon j))
    obtain ⟨j, hj⟩ := this
    refine ⟨_, ⟨coordC j, StarAlgebra.subset_adjoin ℂ _ ⟨j, rfl⟩, rfl⟩, ?_⟩
    simpa [coordC, liftC] using hj
  have htop := ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints A hsep
  have hle : A ≤ StarAlgHom.equalizer Φ Ψ := by
    rw [StarAlgebra.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    exact h j
  have hcl : IsClosed ((StarAlgHom.equalizer Φ Ψ : StarSubalgebra ℂ C(K, ℂ)) : Set C(K, ℂ)) :=
    isClosed_eq (Phi_continuous Φ) (Phi_continuous Ψ)
  have h2 := StarSubalgebra.topologicalClosure_minimal hle hcl
  rw [htop] at h2
  refine StarAlgHom.ext (fun f => ?_)
  exact (StarAlgHom.mem_equalizer Φ Ψ f).mp (h2 StarSubalgebra.mem_top)

end QuantumNLS.FunctionalLinearization

end

end FLPart8

section FLPart9

open NormedSpace ComplexConjugate MeasureTheory
open scoped InnerProductSpace FourierTransform NNReal

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

/-- `C_F` is bounded by finitely many Schwartz seminorms of `F` (the constant depends only on
`d`): the constant of the linearization estimate is uniform on families of `F` with uniformly
bounded derivatives of finite order (and uniform decay). -/
theorem CF_le_seminorms (d : ℕ) :
    ∃ (s : Finset (ℕ × ℕ)) (C : ℝ), 0 ≤ C ∧
      ∀ f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
        CF f ≤ C * (s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f := by
  set ip := (MeasureTheory.volume : Measure (EuclideanSpace ℝ (Fin d))).integrablePower with hip
  set c0 : ℝ := 2 ^ ip * ∫ x : EuclideanSpace ℝ (Fin d), (1 + ‖x‖) ^ (-(ip : ℝ)) with hc0
  have hc0nn : 0 ≤ c0 := by
    rw [hc0]; exact mul_nonneg (by positivity) (integral_nonneg fun x => by positivity)
  have hg : ∀ g : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
      ∫ ξ : EuclideanSpace ℝ (Fin d), ‖ξ‖ ^ 2 * ‖g ξ‖ ≤
        c0 * (SchwartzMap.seminorm ℂ 0 0 g + SchwartzMap.seminorm ℂ (2 + ip) 0 g) := by
    intro g
    have := g.integral_pow_mul_iteratedFDeriv_le ℂ MeasureTheory.volume 2 0
    simpa [norm_iteratedFDeriv_zero, hc0, mul_assoc, add_comm] using this
  have hF : ∀ k n : ℕ, ∃ (s : Finset (ℕ × ℕ)) (C : ℝ≥0), ∀ f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ,
      SchwartzMap.seminorm ℂ k n (𝓕 f) ≤
        (C : ℝ) * (s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f := by
    intro k n
    have hq : Continuous ((SchwartzMap.seminorm ℂ k n).comp
        (SchwartzMap.fourierTransformCLM ℂ (E := ℂ) (V := EuclideanSpace ℝ (Fin d))).toLinearMap) :=
      ((schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin d)) ℂ).continuous_seminorm (k, n)).comp
        (SchwartzMap.fourierTransformCLM ℂ (E := ℂ) (V := EuclideanSpace ℝ (Fin d))).continuous
    obtain ⟨s, C, -, hC⟩ := Seminorm.bound_of_continuous
      (schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin d)) ℂ) _ hq
    refine ⟨s, C, fun f => ?_⟩
    have h := hC f
    have e : ((SchwartzMap.seminorm ℂ k n).comp
        (SchwartzMap.fourierTransformCLM ℂ (E := ℂ) (V := EuclideanSpace ℝ (Fin d))).toLinearMap) f =
        SchwartzMap.seminorm ℂ k n (𝓕 f) := rfl
    rw [e] at h
    have e2 : (C • (s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ))) f =
        (C : ℝ) * (s.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f := by
      rw [Seminorm.smul_apply, NNReal.smul_def, smul_eq_mul]
    rw [e2] at h
    exact h
  obtain ⟨s1, C1, h1⟩ := hF 0 0
  obtain ⟨s2, C2, h2⟩ := hF (2 + ip) 0
  refine ⟨s1 ∪ s2, 8 * Real.pi ^ 2 * (d : ℝ) ^ 2 * c0 * ((C1 : ℝ) + (C2 : ℝ)), by positivity, fun f => ?_⟩
  have hs1 : (s1.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f ≤
      ((s1 ∪ s2).sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f :=
    Seminorm.le_def.mp (Finset.sup_mono Finset.subset_union_left) f
  have hs2 : (s2.sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f ≤
      ((s1 ∪ s2).sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f :=
    Seminorm.le_def.mp (Finset.sup_mono Finset.subset_union_right) f
  have hnn : 0 ≤ ((s1 ∪ s2).sup (schwartzSeminormFamily ℂ (EuclideanSpace ℝ (Fin d)) ℂ)) f := apply_nonneg _ _
  have e1 := h1 f
  have e2 := h2 f
  have e3 := hg (𝓕 f)
  unfold CF
  have hpos : 0 ≤ 8 * Real.pi ^ 2 * (d : ℝ) ^ 2 := by positivity
  calc 8 * Real.pi ^ 2 * (d : ℝ) ^ 2 * ∫ ξ : EuclideanSpace ℝ (Fin d), ‖ξ‖ ^ 2 *
        ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖
      ≤ 8 * Real.pi ^ 2 * (d : ℝ) ^ 2 * (c0 * (SchwartzMap.seminorm ℂ 0 0 (𝓕 f) +
          SchwartzMap.seminorm ℂ (2 + ip) 0 (𝓕 f))) := mul_le_mul_of_nonneg_left e3 hpos
    _ ≤ 8 * Real.pi ^ 2 * (d : ℝ) ^ 2 * (c0 * ((C1 : ℝ) * ((s1 ∪ s2).sup (schwartzSeminormFamily ℂ
          (EuclideanSpace ℝ (Fin d)) ℂ)) f + (C2 : ℝ) * ((s1 ∪ s2).sup (schwartzSeminormFamily ℂ
          (EuclideanSpace ℝ (Fin d)) ℂ)) f)) := by
        gcongr
        · exact e1.trans (mul_le_mul_of_nonneg_left hs1 C1.2)
        · exact e2.trans (mul_le_mul_of_nonneg_left hs2 C2.2)
    _ = _ := by ring

end QuantumNLS.FunctionalLinearization

end

end FLPart9

section FLPart10

open NormedSpace ComplexConjugate MeasureTheory Filter Topology
open scoped InnerProductSpace FourierTransform ContDiff

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

/-- A smooth function on an open set `U` agrees, near a compact `C ⊆ U`, with a `C^∞` function of
compact support (cutoff). -/
theorem exists_extension {U : Set (EuclideanSpace ℝ (Fin d))} (hU : IsOpen U)
    {F : EuclideanSpace ℝ (Fin d) → ℝ} (hF : ContDiffOn ℝ ∞ F U)
    {C : Set (EuclideanSpace ℝ (Fin d))} (hC : IsCompact C) (hCU : C ⊆ U) :
    ∃ G : EuclideanSpace ℝ (Fin d) → ℝ, ContDiff ℝ ∞ G ∧ HasCompactSupport G ∧
      ∃ W : Set (EuclideanSpace ℝ (Fin d)), IsOpen W ∧ C ⊆ W ∧ ∀ x ∈ W, G x = F x := by
  classical
  obtain ⟨L, hLc, hCL, hLU⟩ := exists_compact_between hC hU hCU
  obtain ⟨L2, hL2c, hCL2, hL2L⟩ := exists_compact_between hC isOpen_interior hCL
  obtain ⟨χ, hχ, -, hχs, hχ1⟩ := exists_contDiff_support_eq_eq_one_iff (n := (⊤ : ℕ∞))
    (isOpen_interior : IsOpen (interior L)) hL2c.isClosed hL2L
  have hcl : closure (interior L) ⊆ L := closure_minimal interior_subset hLc.isClosed
  have hχ0 : ∀ y, y ∉ interior L → χ y = 0 := fun y hy => by
    by_contra h
    exact hy (hχs ▸ (Function.mem_support.mpr h))
  refine ⟨fun x => if x ∈ U then χ x * F x else 0, ?_, ?_, interior L2, isOpen_interior,
    hCL2, fun x hx => ?_⟩
  · rw [contDiff_iff_contDiffAt]
    intro x
    by_cases hxU : x ∈ U
    · have h1 : ContDiffAt ℝ ∞ (fun y => χ y * F y) x :=
        (hχ.contDiffAt).mul (hF.contDiffAt (hU.mem_nhds hxU))
      refine h1.congr_of_eventuallyEq ?_
      filter_upwards [hU.mem_nhds hxU] with y hy
      simp [hy]
    · have hxL : x ∉ closure (interior L) := fun h => hxU (hLU (hcl h))
      have : (fun y => if y ∈ U then χ y * F y else 0) =ᶠ[𝓝 x] fun _ => 0 := by
        filter_upwards [isClosed_closure.isOpen_compl.mem_nhds hxL] with y hy
        have hy' : y ∉ interior L := fun h => hy (subset_closure h)
        simp [hχ0 y hy']
      exact (contDiffAt_const).congr_of_eventuallyEq this
  · refine HasCompactSupport.of_support_subset_isCompact (K := L) hLc ?_
    intro y hy
    by_contra hyL
    have : y ∉ interior L := fun h => hyL (interior_subset h)
    apply hy
    simp [hχ0 y this]
  · have hxU : x ∈ U := hLU (interior_subset (hL2L (interior_subset hx)))
    have h1 : χ x = 1 := (hχ1 x).mp (interior_subset hx)
    simp [hxU, h1]

section Nbhd

variable {K : Set (EuclideanSpace ℝ (Fin d))} [CompactSpace K]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (Φ : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))

/-- `F(B)` for `F` only continuous on the joint spectrum `K`: `Φ` applied to `F|_K`. -/
def FopOn (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : ContinuousOn F K) : H →L[ℂ] H :=
  Φ ⟨fun x : K => ((F x : ℝ) : ℂ), Complex.continuous_ofReal.comp hF.restrict⟩

/-- **PROP-014 `lem:A4-functional-linearization`, with `F` real smooth only on a neighbourhood `U`
of the spectral set `K` and of `b`.**  After a cutoff extension `F'` (as in the printed proof),
the estimate holds for `H_N = N F(B_N)` (`F(B_N) = Φ(F|_K)`) and
`H_N^lin = N ∑_j ∂_jF(b) B_{N,j}`, for all `N, ψ, J, T`, with the constant `C_F(F')`. -/
theorem functional_linearization_nbhd (U : Set (EuclideanSpace ℝ (Fin d))) (hU : IsOpen U)
    (F : EuclideanSpace ℝ (Fin d) → ℝ) (hF : ContDiffOn ℝ ∞ F U) (hKU : K ⊆ U)
    (b : EuclideanSpace ℝ (Fin d)) (hbU : b ∈ U) :
    ∃ (F' : EuclideanSpace ℝ (Fin d) → ℝ) (hF' : ContDiff ℝ ∞ F') (hFc : HasCompactSupport F'),
      (∀ x : K, F' x = F x) ∧ fderiv ℝ F' b = fderiv ℝ F b ∧
      ∀ (N : ℝ), 0 < N → ∀ (ψ : H), ‖ψ‖ = 1 → ∀ {δ : ℝ}, 0 ≤ δ →
        (∀ j, ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) ψ‖ ≤ δ) →
        ∀ (J : H →L[ℂ] H) {CJ : ℝ}, 0 ≤ CJ →
        (∀ j, ‖Φ (coordC j) * J - J * Φ (coordC j)‖ ≤ CJ / N) → ∀ (t T : ℝ), |t| ≤ T →
        ‖⟪evol ((N : ℂ) • FopOn Φ F (hF.continuousOn.mono hKU)) t ψ,
            J (evol ((N : ℂ) • FopOn Φ F (hF.continuousOn.mono hKU)) t ψ)⟫_ℂ -
          ⟪evol (Hlin Φ F b N) t ψ, J (evol (Hlin Φ F b N) t ψ)⟫_ℂ‖ ≤
        CF (schwartzOfReal F' hF' hFc) * T * CJ * δ := by
  have hKc : IsCompact K := isCompact_iff_compactSpace.mpr ‹CompactSpace K›
  obtain ⟨G, hG, hGc, W, hW, hCW, hGW⟩ := exists_extension hU hF (hKc.union isCompact_singleton)
    (Set.union_subset hKU (Set.singleton_subset_iff.mpr hbU))
  have hGF : ∀ x : K, G x = F x := fun x => hGW x (hCW (Or.inl x.2))
  have hbW : b ∈ W := hCW (Or.inr rfl)
  have hder : fderiv ℝ G b = fderiv ℝ F b := by
    have : G =ᶠ[𝓝 b] F := by filter_upwards [hW.mem_nhds hbW] with y hy using hGW y hy
    exact this.fderiv_eq
  refine ⟨G, hG, hGc, hGF, hder, fun N hN ψ hψ δ hδ hψδ J CJ hCJ hJ t T ht => ?_⟩
  have h := functional_linearization Φ G hG hGc b N hN ψ hψ hδ hψδ J hCJ hJ t T ht
  have e1 : Hnl Φ G hG.continuous N = (N : ℂ) • FopOn Φ F (hF.continuousOn.mono hKU) := by
    unfold Hnl Fop FopOn
    congr 2
    ext x
    simp [liftC, hGF x]
  have e2 : Hlin Φ G b N = Hlin Φ F b N := by unfold Hlin; rw [hder]
  rw [e1, e2] at h
  exact h

end Nbhd

end QuantumNLS.FunctionalLinearization

end

