import Mathlib

/-!
# PROP-014 `lem:A4-functional-linearization`: linearization on a concentrated spectral state

Source: `source/chapters/propagation/spectral_calculus.tex`, lines 497-598, label
`lem:A4-functional-linearization`, `\ReportID{PROP-014}`, status `Proved` in the report.

Printed statement.  For each `N`, let `B_{N,1},…,B_{N,d}` be commuting bounded self-adjoint
operators with spectra in a fixed compact interval, `b ∈ ℝ^d`, `F` real smooth on a neighbourhood
of the joint spectral cube, `ψ_N` normalized with `δ_N = max_j ‖(B_{N,j} − b_j)ψ_N‖`, and `J_N`
bounded with `max_j ‖[B_{N,j}, J_N]‖ ≤ C_J/N`.  With `H_N = N F(B_N)`,
`H_N^lin = N ∑_j ∂_jF(b) B_{N,j}`:
`sup_{|t|≤T} |⟨e^{-itH_N}ψ, J e^{-itH_N}ψ⟩ − ⟨e^{-itH^lin}ψ, J e^{-itH^lin}ψ⟩| ≤ C_F T C_J δ_N`,
`C_F` uniform when the cube, `b` and finitely many derivatives of a smooth extension of `F` are
uniformly bounded; the same for an integral over a finite measure parameter space of such
functions with mutually commuting spectral coordinates.

## What is formalised (all proved, no placeholder)
* **The operator class / functional calculus.**  `H` is an arbitrary complex Hilbert space and
  `B(H) = H →L[ℂ] H`.  `B_j := Φ(x_j)` where `Φ : C(K, ℂ) →⋆ₐ[ℂ] B(H)` is a unital `*`-homomorphism
  from the continuous functions on a compact set `K ⊂ ℝ^d` (`EuclideanSpace ℝ (Fin d)`), `x_j` the
  coordinate functions (`coordC j`): the joint continuous functional calculus, `F(B) := Φ(F|_K)`.
  `exists_functional_calculus` proves (Gelfand duality for the closed commutative C*-algebra
  generated by the tuple, spectral permanence for the support) that every commuting tuple of
  bounded self-adjoint operators has such a `Φ`, `K` being its joint spectrum, with every
  coordinate of every point of `K` in `spectrum (B j)`, hence `K ⊂` the spectral cube;
  `functional_calculus_unique` (Stone–Weierstrass) proves uniqueness; so `F(B_N)` is the
  canonical `F(B_N)` for all commuting self-adjoint tuples, and any compact `K' ⊇ K` gives the
  same operator on `F|_K`.
* **Time evolution.**  `evol T t = exp(-it T)` (norm-convergent exponential of the bounded operator,
  `evol`); `H_N = Hnl`, `H_N^lin = Hlin`.
* **The estimate.**  `functional_linearization` (`F : ℝ^d → ℝ` `C^∞` with compact support):
  for every `t, T` with `|t| ≤ T`, every `N > 0`, unit `ψ` with `‖(B_j − b_j)ψ‖ ≤ δ`, every bounded
  `J` with `‖[B_j,J]‖ ≤ C_J/N`: the difference of the two expectations is at most
  `C_F T C_J δ`, with `C_F = CF F := 8π² d² ∫ ‖ξ‖² |F̂(ξ)| dξ` — independent of `N`, `K`, `b`,
  `B`, `ψ`, `J`, `T`, `C_J`, `δ`.  `functional_linearization_nbhd`: the printed hypothesis (`F`
  smooth on an open neighbourhood `U` of `K` and of `b`): a cutoff extension `F'` (`exists_extension`,
  exactly as in the printed proof) agrees with `F` on `K` and has the same differential at `b`, and
  the estimate holds for `H_N = N Φ(F|_K)` with `C_F = CF F'`.
  `CF_le_seminorms`: `CF` is bounded by a finite sup of Schwartz seminorms of `F` with a constant
  depending only on `d` — the uniformity over families with uniformly bounded derivatives (of
  finite order, with uniform decay).
* **The printed route, with a different but equivalent bookkeeping.**  Fourier inversion of the
  Schwartz extension (`fourier_inv_pt`, `fourier_deriv_pt`, `remC_eq_integral`: the Taylor
  remainder `F(B) − F(b) − ∇F(b)(B−b)` is the `C(K,ℂ)`-valued Bochner integral of the mode
  remainders `rhoC ξ b`); the exponential commutator bound `norm_comm_exp_le`
  (`‖[e^{isΘ},J]‖ ≤ |s| ‖[Θ,J]‖`, differentiating `e^{rΘ} J e^{-rΘ}`); the key per-mode estimate
  `key_commutator_bound` (`|⟨φ,[e^{iΘ} − 1 − iΘ, J]φ⟩| ≤ 2‖Θφ‖‖[Θ,J]‖` for self-adjoint `Θ`,
  `‖φ‖ ≤ 1`, by differentiating in `s`, the centered factor moved onto the vector, exactly the
  printed (A4-remainder-commutator) step); `Phi_remC_bound`; and `time_bound` (the two generators
  commute, `e^{-itH} = e^{-itD} e^{-itH^lin}`, differentiate `⟨φ(s), J φ(s)⟩` with
  `φ(s) = e^{-isD}e^{-itH^lin}ψ`, `D = H − H^lin`; the deviations `‖(B_j − b_j)φ(s)‖ ≤ δ` are
  preserved since `D`, `H^lin` commute with every `B_j`).  The printed `g_{ij}` factorisation is
  replaced by the same Taylor expansion done mode by mode on the Fourier side (equivalent; avoids
  proving smoothness of the `g_{ij}`).

## Not formalised (precise gaps)
* The "integral over a finite measure parameter space" extension (last sentence of the statement
  and last paragraph of the proof) is **not** formalised: it needs operator-valued Bochner
  integrals over a parameter measure of families `Φ_θ(F_θ)` with commuting families across
  parameters and the corresponding measurability; the single-function estimate is the kernel of it.
* `F` is the exact printed function only through the extension/cutoff statement
  `functional_linearization_nbhd`; the estimate for `F` compactly supported is
  `functional_linearization`.
* Hilbert space `H` is arbitrary (the physical `H_N` are instances); no finite dimensionality used.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

section FLPart1

open NormedSpace ComplexConjugate
open scoped InnerProductSpace

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

section ExpComm

variable [Nontrivial H]

theorem norm_exp_le {Θ : H →L[ℂ] H} (hΘ : IsSelfAdjoint Θ) (s : ℝ) :
    ‖exp (s • (Complex.I • Θ))‖ ≤ 1 := by
  have hr : IsSelfAdjoint (s : ℂ) := by simp [IsSelfAdjoint]
  have hs : IsSelfAdjoint ((s : ℂ) • Θ) := hr.smul hΘ
  have hu := (selfAdjoint.expUnitary (⟨(s : ℂ) • Θ, hs⟩ : selfAdjoint (H →L[ℂ] H))).2
  have e : exp (s • (Complex.I • Θ)) = exp (Complex.I • ((s : ℂ) • Θ)) := by
    rw [Complex.coe_smul, smul_comm]
  rw [e]
  exact (CStarRing.norm_of_mem_unitary hu).le

theorem mvt_real {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] {f f' : ℝ → G}
    (hf : ∀ x, HasDerivAt f (f' x) x) {C : ℝ} (hC : ∀ x, ‖f' x‖ ≤ C) (x y : ℝ) :
    ‖f y - f x‖ ≤ C * |y - x| := by
  have := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le (s := Set.univ)
    (fun x _ => (hf x).hasDerivWithinAt) (fun x _ => hC x) convex_univ (Set.mem_univ x)
    (Set.mem_univ y)
  simpa [Real.norm_eq_abs] using this

/-- Commutator of the unitary group `exp (s • (I Θ))` with `J`. -/
theorem norm_comm_exp_le {Θ : H →L[ℂ] H} (hΘ : IsSelfAdjoint Θ) (J : H →L[ℂ] H) (s : ℝ) :
    ‖exp (s • (Complex.I • Θ)) * J - J * exp (s • (Complex.I • Θ))‖ ≤
      |s| * ‖Θ * J - J * Θ‖ := by
  set x : H →L[ℂ] H := Complex.I • Θ with hx
  have hE : ∀ r : ℝ, HasDerivAt (fun r : ℝ => exp (r • x)) (exp (r • x) * x) r :=
    fun r => hasDerivAt_exp_smul_const x r
  have hF : ∀ r : ℝ, HasDerivAt (fun r : ℝ => exp (r • (-x))) (exp (r • (-x)) * (-x)) r :=
    fun r => hasDerivAt_exp_smul_const (-x) r
  have hG : ∀ r : ℝ, HasDerivAt (fun r : ℝ => exp (r • x) * J * exp (r • (-x)))
      (exp (r • x) * (x * J - J * x) * exp (r • (-x))) r := by
    intro r
    have h := ((hE r).mul_const J).mul (hF r)
    refine h.congr_deriv ?_
    have hc : Commute (exp (r • (-x))) x :=
      (Commute.refl x).neg_left.smul_left r |>.exp_left
    have e1 : exp (r • (-x)) * x = x * exp (r • (-x)) := hc.eq
    calc exp (r • x) * x * J * exp (r • (-x)) + exp (r • x) * J * (exp (r • (-x)) * -x)
        = exp (r • x) * x * J * exp (r • (-x)) - exp (r • x) * J * (exp (r • (-x)) * x) := by
          noncomm_ring
      _ = _ := by rw [e1]; noncomm_ring
  have hnE : ∀ r : ℝ, ‖exp (r • x)‖ ≤ 1 := fun r => by rw [hx]; exact norm_exp_le hΘ r
  have hnF : ∀ r : ℝ, ‖exp (r • (-x))‖ ≤ 1 := fun r => by
    have := norm_exp_le hΘ (-r)
    have e : exp (r • (-x)) = exp ((-r) • (Complex.I • Θ)) := by rw [hx, neg_smul, smul_neg]
    rw [e]; exact this
  have hb : ∀ r : ℝ, ‖exp (r • x) * (x * J - J * x) * exp (r • (-x))‖ ≤ ‖Θ * J - J * Θ‖ := by
    intro r
    have hxn : ‖x * J - J * x‖ = ‖Θ * J - J * Θ‖ := by
      have : x * J - J * x = Complex.I • (Θ * J - J * Θ) := by
        rw [hx, smul_mul_assoc, mul_smul_comm, smul_sub]
      rw [this, norm_smul, Complex.norm_I, one_mul]
    calc _ ≤ ‖exp (r • x)‖ * ‖x * J - J * x‖ * ‖exp (r • (-x))‖ := by
          refine (norm_mul_le _ _).trans ?_
          gcongr
          exact norm_mul_le _ _
      _ ≤ 1 * ‖x * J - J * x‖ * 1 := by gcongr <;> first | exact hnE r | exact hnF r
      _ = _ := by rw [hxn]; ring
  have hm := mvt_real hG hb 0 s
  let +nondep : NormedAlgebra ℚ (H →L[ℂ] H) := .restrictScalars ℚ ℂ _
  have hF1 : exp (s • (-x)) * exp (s • x) = 1 := by
    rw [← exp_add_of_commute ((Commute.refl x).neg_left.smul_left s |>.smul_right s), smul_neg, neg_add_cancel, exp_zero]
  have e0 : exp ((0 : ℝ) • x) * J * exp ((0 : ℝ) • (-x)) = J := by simp
  have key : exp (s • x) * J - J * exp (s • x) =
      (exp (s • x) * J * exp (s • (-x)) - exp ((0 : ℝ) • x) * J * exp ((0 : ℝ) • (-x))) *
        exp (s • x) := by
    rw [e0, sub_mul, mul_assoc (exp (s • x) * J), hF1, mul_one]
  rw [key]
  refine (norm_mul_le _ _).trans ?_
  have := hnE s
  calc _ ≤ (‖Θ * J - J * Θ‖ * |s - 0|) * 1 := by gcongr
    _ = _ := by simp [mul_comm]

theorem hasDerivAt_apply {A : ℝ → H →L[ℂ] H} {A' : H →L[ℂ] H} {r : ℝ} (h : HasDerivAt A A' r)
    (φ : H) : HasDerivAt (fun r => A r φ) (A' φ) r := by
  exact ((ContinuousLinearMap.apply ℂ H φ).restrictScalars ℝ).hasFDerivAt.comp_hasDerivAt r h

theorem norm_exp_sub_apply_le {Θ : H →L[ℂ] H} (hΘ : IsSelfAdjoint Θ) (φ : H) (s : ℝ) :
    ‖(exp (s • (Complex.I • Θ)) - 1) φ‖ ≤ |s| * ‖Θ φ‖ := by
  set x : H →L[ℂ] H := Complex.I • Θ with hx
  have hf : ∀ r : ℝ, HasDerivAt (fun r : ℝ => exp (r • x) φ) ((exp (r • x) * x) φ) r := by
    intro r
    exact hasDerivAt_apply (hasDerivAt_exp_smul_const x r) φ
  have hb : ∀ r : ℝ, ‖(exp (r • x) * x) φ‖ ≤ ‖Θ φ‖ := by
    intro r
    have h1 : ‖(exp (r • x) * x) φ‖ ≤ ‖exp (r • x)‖ * ‖x φ‖ := by
      rw [mul_apply_eq_comp]; exact (exp (r • x)).le_opNorm _
    have h2 : ‖x φ‖ = ‖Θ φ‖ := by
      rw [hx, smul_apply, norm_smul, Complex.norm_I, one_mul]
    have h3 : ‖exp (r • x)‖ ≤ 1 := by rw [hx]; exact norm_exp_le hΘ r
    rw [h2] at h1
    calc _ ≤ _ := h1
      _ ≤ 1 * ‖Θ φ‖ := by gcongr
      _ = _ := one_mul _
  have := mvt_real hf hb 0 s
  simp only [zero_smul, exp_zero, one_apply_eq_self, sub_zero] at this
  rw [sub_apply, one_apply_eq_self, mul_comm]
  exact this

theorem key_commutator_bound {Θ : H →L[ℂ] H} (hΘ : IsSelfAdjoint Θ) (J : H →L[ℂ] H) (φ : H)
    (hφ : ‖φ‖ ≤ 1) :
    ‖⟪φ, ((exp (Complex.I • Θ) - 1 - Complex.I • Θ) * J -
        J * (exp (Complex.I • Θ) - 1 - Complex.I • Θ)) φ⟫_ℂ‖ ≤
      2 * ‖Θ φ‖ * ‖Θ * J - J * Θ‖ := by
  set x : H →L[ℂ] H := Complex.I • Θ with hx
  have hsym : ∀ a b : H, ⟪Θ a, b⟫_ℂ = ⟪a, Θ b⟫_ℂ :=
    ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp hΘ
  have hK : ∀ s : ℝ, HasDerivAt (fun s : ℝ => exp (s • x) - 1 - s • x) (exp (s • x) * x - x) s := by
    intro s
    have h1 := hasDerivAt_exp_smul_const x s
    have h2 : HasDerivAt (fun s : ℝ => s • x) x s := by simpa using (hasDerivAt_id s).smul_const x
    exact (h1.sub_const 1).sub h2
  have hM : ∀ s : ℝ, HasDerivAt (fun s : ℝ => (exp (s • x) - 1 - s • x) * J - J * (exp (s • x) - 1 - s • x))
      ((exp (s • x) * x - x) * J - J * (exp (s • x) * x - x)) s :=
    fun s => ((hK s).mul_const J).sub ((hK s).const_mul J)
  have hZ : ∀ s : ℝ, HasDerivAt (fun s : ℝ => ⟪φ, ((exp (s • x) - 1 - s • x) * J -
      J * (exp (s • x) - 1 - s • x)) φ⟫_ℂ)
      ⟪φ, (((exp (s • x) * x - x) * J - J * (exp (s • x) * x - x))) φ⟫_ℂ s := by
    intro s
    have h := HasDerivAt.inner ℂ (hasDerivAt_const s φ) (hasDerivAt_apply (hM s) φ)
    refine h.congr_deriv ?_
    simp only [inner_zero_left, add_zero]
  set a := ‖Θ φ‖ with ha
  set b := ‖Θ * J - J * Θ‖ with hb
  have hxn : ‖x * J - J * x‖ = b := by
    have : x * J - J * x = Complex.I • (Θ * J - J * Θ) := by
      rw [hx, smul_mul_assoc, mul_smul_comm, smul_sub]
    rw [this, norm_smul, Complex.norm_I, one_mul]
  have hxa : ∀ w : H, ‖⟪φ, x w⟫_ℂ‖ ≤ a * ‖w‖ := by
    intro w
    have : ⟪φ, x w⟫_ℂ = Complex.I * ⟪Θ φ, w⟫_ℂ := by
      rw [hx, smul_apply, inner_smul_right, hsym]
    rw [this, norm_mul, Complex.norm_I, one_mul]
    exact norm_inner_le_norm _ _
  have hbound : ∀ s : ℝ, s ∈ Set.Ico (0 : ℝ) 1 →
      ‖⟪φ, (((exp (s • x) * x - x) * J - J * (exp (s • x) * x - x))) φ⟫_ℂ‖ ≤ 2 * a * b := by
    intro s hs
    have hs0 : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2.le
    have hc : exp (s • x) * x = x * exp (s • x) := ((Commute.refl x).smul_left s |>.exp_left).eq
    set Y := exp (s • x) - 1 with hY
    have hxY : exp (s • x) * x - x = x * Y := by rw [hc, hY]; noncomm_ring
    have hdec : (x * Y) * J - J * (x * Y) = x * (Y * J - J * Y) + (x * J - J * x) * Y := by
      noncomm_ring
    have hYJ : Y * J - J * Y = exp (s • x) * J - J * exp (s • x) := by rw [hY]; noncomm_ring
    have hcomm : ‖Y * J - J * Y‖ ≤ |s| * b := by
      rw [hYJ]; exact norm_comm_exp_le hΘ J s
    have hYφ : ‖Y φ‖ ≤ |s| * a := norm_exp_sub_apply_le hΘ φ s
    rw [hxY, hdec, add_apply, inner_add_right]
    have t1 : ‖⟪φ, (x * (Y * J - J * Y)) φ⟫_ℂ‖ ≤ a * (|s| * b) := by
      refine (hxa _).trans ?_
      gcongr
      refine ((Y * J - J * Y).le_opNorm φ).trans ?_
      calc _ ≤ ‖Y * J - J * Y‖ * 1 := by gcongr
        _ ≤ |s| * b := by rw [mul_one]; exact hcomm
    have t2 : ‖⟪φ, ((x * J - J * x) * Y) φ⟫_ℂ‖ ≤ b * (|s| * a) := by
      refine (norm_inner_le_norm _ _).trans ?_
      have h3 : ‖(x * J - J * x) (Y φ)‖ ≤ b * (|s| * a) := by
        refine ((x * J - J * x).le_opNorm _).trans ?_
        rw [hxn]
        gcongr
      calc ‖φ‖ * ‖(x * J - J * x) (Y φ)‖ ≤ 1 * (b * (|s| * a)) :=
            mul_le_mul hφ h3 (norm_nonneg _) zero_le_one
        _ = _ := one_mul _
    calc _ ≤ _ := norm_add_le _ _
      _ ≤ a * (|s| * b) + b * (|s| * a) := add_le_add t1 t2
      _ ≤ 2 * a * b := by
        have ha0 : 0 ≤ a := norm_nonneg _
        have hb0 : 0 ≤ b := norm_nonneg _
        nlinarith [mul_nonneg ha0 hb0, mul_le_mul_of_nonneg_left hs0 (mul_nonneg ha0 hb0)]
  have hseg := norm_image_sub_le_of_norm_deriv_le_segment' (a := 0) (b := 1)
    (f := fun s : ℝ => ⟪φ, ((exp (s • x) - 1 - s • x) * J - J * (exp (s • x) - 1 - s • x)) φ⟫_ℂ)
    (fun s _ => (hZ s).hasDerivWithinAt) hbound 1 (by simp)
  simpa using hseg

end ExpComm

end QuantumNLS.FunctionalLinearization

end

end FLPart1

section FLPart2

open scoped FourierTransform ComplexInnerProductSpace
open MeasureTheory Real

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

/-- Fourier inversion for a Schwartz function, pointwise. -/
theorem fourier_inv_pt (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (y : EuclideanSpace ℝ (Fin d)) :
    ∫ ξ : EuclideanSpace ℝ (Fin d), Complex.exp (↑(2 * π * inner ℝ ξ y) * Complex.I) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ = f y := by
  have := congrFun (f.continuous.fourierInv_fourier_eq f.integrable (𝓕 f).integrable) y
  rwa [fourierInv_eq'] at this

theorem fourier_deriv_pt (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (m b : EuclideanSpace ℝ (Fin d)) :
    ∫ ξ : EuclideanSpace ℝ (Fin d), Complex.exp (↑(2 * π * inner ℝ ξ b) * Complex.I) •
      ((2 * ↑π * Complex.I * (inner ℝ ξ m : ℝ)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ) = fderiv ℝ f b m := by
  have hg : (fun x : EuclideanSpace ℝ (Fin d) => (inner ℝ x m : ℝ)).HasTemperateGrowth :=
    ((innerSL ℝ).flip m).hasTemperateGrowth
  have h1 := fourier_inv_pt (LineDeriv.lineDerivOp m f) b
  rw [SchwartzMap.lineDerivOp_apply_eq_fderiv] at h1
  rw [← h1]
  refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
  have h2 : (𝓕 (⇑(LineDeriv.lineDerivOp m f)) : EuclideanSpace ℝ (Fin d) → ℂ) ξ =
      (((2 * ↑π * Complex.I) • (SchwartzMap.smulLeftCLM ℂ fun x : EuclideanSpace ℝ (Fin d) => (inner ℝ x m : ℝ))
        (𝓕 f) : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) : EuclideanSpace ℝ (Fin d) → ℂ) ξ :=
    congrArg (fun g : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ => g ξ) (SchwartzMap.fourier_lineDerivOp_eq f m)
  simp only
  rw [h2]
  simp [SchwartzMap.smulLeftCLM_apply_apply hg, mul_assoc]
  left; rfl

end QuantumNLS.FunctionalLinearization

end

end FLPart2

section FLPart3

open NormedSpace ComplexConjugate
open scoped InnerProductSpace

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

variable {K : Set (EuclideanSpace ℝ (Fin d))} [CompactSpace K]

/-- Restriction of a continuous function on `E` to the compact set `K`. -/
def liftC (g : EuclideanSpace ℝ (Fin d) → ℂ) (hg : Continuous g) : C(K, ℂ) :=
  ⟨fun x => g x, hg.comp continuous_subtype_val⟩

/-- Coordinate function `x ↦ x_j`. -/
def coordC (j : Fin d) : C(K, ℂ) :=
  liftC (fun y => ((y j : ℝ) : ℂ)) (Complex.continuous_ofReal.comp (EuclideanSpace.proj j).continuous)

/-- `θ_ξ(x) = 2π⟨ξ, x − b⟩`. -/
def thetaC (ξ b : EuclideanSpace ℝ (Fin d)) : C(K, ℂ) :=
  liftC (fun y => ((2 * Real.pi * inner ℝ ξ (y - b) : ℝ) : ℂ)) (by fun_prop)

theorem thetaC_eq_sum (ξ b : EuclideanSpace ℝ (Fin d)) :
    thetaC (K := K) ξ b = ∑ j : Fin d, ((2 * Real.pi * ξ j : ℝ) : ℂ) •
      (coordC (K := K) j - ((b j : ℝ) : ℂ) • (1 : C(K, ℂ))) := by
  ext x
  simp [thetaC, coordC, liftC, PiLp.inner_apply, Finset.mul_sum, mul_sub, mul_comm]
  simp only [mul_assoc]

/-- Evaluation at a point as a ring homomorphism. -/
def evalRH (x : K) : C(K, ℂ) →+* ℂ where
  toFun f := f x
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem exp_apply_C (f : C(K, ℂ)) (x : K) : exp f x = Complex.exp (f x) := by
  have h := map_exp (evalRH x) (continuous_eval_const x) f
  have h2 : (evalRH x) (exp f) = exp f x := rfl
  have h3 : (evalRH x) f = f x := rfl
  rw [h2, h3] at h
  rw [h, Complex.exp_eq_exp_ℂ]

/-- `e_ξ(y) = exp(2πi⟨ξ,y⟩)`. -/
def cexpE (ξ y : EuclideanSpace ℝ (Fin d)) : ℂ :=
  Complex.exp (((2 * Real.pi * inner ℝ ξ y : ℝ) : ℂ) * Complex.I)

/-- The Taylor-remainder test function of the Fourier mode `e_ξ` at `b`. -/
def rhoC (ξ b : EuclideanSpace ℝ (Fin d)) : C(K, ℂ) :=
  liftC (fun y => cexpE ξ y - cexpE ξ b -
    (2 * Real.pi * Complex.I * ((inner ℝ ξ (y - b) : ℝ) : ℂ)) * cexpE ξ b)
    (by unfold cexpE; fun_prop)

theorem rhoC_eq (ξ b : EuclideanSpace ℝ (Fin d)) :
    rhoC (K := K) ξ b = cexpE ξ b • (exp (Complex.I • thetaC (K := K) ξ b) - 1 -
      Complex.I • thetaC (K := K) ξ b) := by
  ext x
  have hx : (((2 * Real.pi * inner ℝ ξ (x : EuclideanSpace ℝ (Fin d)) : ℝ) : ℂ) * Complex.I) =
      Complex.I * ((2 * Real.pi * inner ℝ ξ ((x : EuclideanSpace ℝ (Fin d)) - b) : ℝ) : ℂ) +
        ((2 * Real.pi * inner ℝ ξ b : ℝ) : ℂ) * Complex.I := by
    rw [inner_sub_right]; push_cast; ring
  simp only [rhoC, liftC, thetaC, ContinuousMap.coe_mk, ContinuousMap.sub_apply,
    ContinuousMap.smul_apply, ContinuousMap.one_apply, smul_eq_mul, exp_apply_C]
  unfold cexpE
  rw [hx, Complex.exp_add]
  push_cast
  ring

section PhiPart

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (Φ : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))

theorem Phi_norm_le (f : C(K, ℂ)) : ‖Φ f‖ ≤ ‖f‖ := NonUnitalStarAlgHom.norm_apply_le Φ f

theorem Phi_continuous : Continuous Φ :=
  AddMonoidHomClass.continuous_of_bound Φ 1 (fun f => by simpa using Phi_norm_le Φ f)

theorem isSelfAdjoint_thetaC (ξ b : EuclideanSpace ℝ (Fin d)) :
    IsSelfAdjoint (thetaC (K := K) ξ b) := by
  unfold IsSelfAdjoint
  ext x
  simp [thetaC, liftC, ContinuousMap.star_apply]

theorem Phi_thetaC_eq (ξ b : EuclideanSpace ℝ (Fin d)) :
    Φ (thetaC ξ b) = ∑ j : Fin d, ((2 * Real.pi * ξ j : ℝ) : ℂ) •
      (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) := by
  rw [thetaC_eq_sum, map_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_smul, map_sub, map_smul, map_one]

theorem Phi_rhoC_eq (ξ b : EuclideanSpace ℝ (Fin d)) :
    Φ (rhoC ξ b) = cexpE ξ b • (exp (Complex.I • Φ (thetaC ξ b)) - 1 -
      Complex.I • Φ (thetaC ξ b)) := by
  let +nondep : NormedAlgebra ℚ (H →L[ℂ] H) := .restrictScalars ℚ ℂ _
  let +nondep : NormedAlgebra ℚ C(K, ℂ) := .restrictScalars ℚ ℂ _
  rw [rhoC_eq, map_smul, map_sub, map_sub, map_smul, map_one,
    map_exp Φ (Phi_continuous Φ), map_smul]

theorem norm_Theta_apply_le [Nontrivial H] (ξ b : EuclideanSpace ℝ (Fin d)) (φ : H) {δ : ℝ}
    (hX : ∀ j, ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) φ‖ ≤ δ) :
    ‖Φ (thetaC ξ b) φ‖ ≤ 2 * Real.pi * (∑ j : Fin d, |ξ j|) * δ := by
  rw [Phi_thetaC_eq, ContinuousLinearMap.sum_apply]
  refine (norm_sum_le _ _).trans ?_
  rw [Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_le_sum (fun j _ => ?_)
  rw [ContinuousLinearMap.smul_apply, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_mul,
    abs_mul, abs_two, abs_of_pos Real.pi_pos]
  exact mul_le_mul_of_nonneg_left (hX j) (by positivity)

theorem comm_sub_smul_one (A J : H →L[ℂ] H) (z : ℂ) :
    (A - z • (1 : H →L[ℂ] H)) * J - J * (A - z • (1 : H →L[ℂ] H)) = A * J - J * A := by
  simp only [sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
  abel

theorem norm_Theta_comm_le [Nontrivial H] (ξ b : EuclideanSpace ℝ (Fin d)) (J : H →L[ℂ] H) {c : ℝ}
    (hc : ∀ j, ‖Φ (coordC j) * J - J * Φ (coordC j)‖ ≤ c) :
    ‖Φ (thetaC ξ b) * J - J * Φ (thetaC ξ b)‖ ≤ 2 * Real.pi * (∑ j : Fin d, |ξ j|) * c := by
  rw [Phi_thetaC_eq]
  have e : (∑ j : Fin d, ((2 * Real.pi * ξ j : ℝ) : ℂ) •
      (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H))) * J -
      J * (∑ j : Fin d, ((2 * Real.pi * ξ j : ℝ) : ℂ) •
      (Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H))) =
      ∑ j : Fin d, ((2 * Real.pi * ξ j : ℝ) : ℂ) • (Φ (coordC j) * J - J * Φ (coordC j)) := by
    rw [Finset.sum_mul, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [smul_mul_assoc, mul_smul_comm, ← smul_sub, comm_sub_smul_one]
  rw [e]
  refine (norm_sum_le _ _).trans ?_
  rw [Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_le_sum (fun j _ => ?_)
  rw [norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_mul, abs_two,
    abs_of_pos Real.pi_pos]
  exact mul_le_mul_of_nonneg_left (hc j) (by positivity)

theorem rho_comm_bound [Nontrivial H] (ξ b : EuclideanSpace ℝ (Fin d)) (J : H →L[ℂ] H) (φ : H)
    (hφ : ‖φ‖ ≤ 1) {δ c : ℝ} (hδ : 0 ≤ δ) (hc0 : 0 ≤ c)
    (hX : ∀ j, ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) φ‖ ≤ δ)
    (hc : ∀ j, ‖Φ (coordC j) * J - J * Φ (coordC j)‖ ≤ c) :
    ‖⟪φ, (Φ (rhoC ξ b) * J - J * Φ (rhoC ξ b)) φ⟫_ℂ‖ ≤
      8 * Real.pi ^ 2 * (∑ j : Fin d, |ξ j|) ^ 2 * δ * c := by
  have hsa : IsSelfAdjoint (Φ (thetaC ξ b)) := (isSelfAdjoint_thetaC ξ b).map Φ
  have hk := key_commutator_bound hsa J φ hφ
  have h1 := norm_Theta_apply_le Φ ξ b φ hX
  have h2 := norm_Theta_comm_le Φ ξ b J hc
  rw [Phi_rhoC_eq]
  have e : (cexpE ξ b • (exp (Complex.I • Φ (thetaC ξ b)) - 1 - Complex.I • Φ (thetaC ξ b))) * J -
      J * (cexpE ξ b • (exp (Complex.I • Φ (thetaC ξ b)) - 1 - Complex.I • Φ (thetaC ξ b))) =
      cexpE ξ b • ((exp (Complex.I • Φ (thetaC ξ b)) - 1 - Complex.I • Φ (thetaC ξ b)) * J -
        J * (exp (Complex.I • Φ (thetaC ξ b)) - 1 - Complex.I • Φ (thetaC ξ b))) := by
    rw [smul_mul_assoc, mul_smul_comm, smul_sub]
  rw [e, ContinuousLinearMap.smul_apply, inner_smul_right, norm_mul]
  have hn : ‖cexpE ξ b‖ = 1 := by
    unfold cexpE; exact Complex.norm_exp_ofReal_mul_I _
  rw [hn, one_mul]
  refine hk.trans ?_
  have hS : 0 ≤ ∑ j : Fin d, |ξ j| := Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hS2 : 0 ≤ 2 * Real.pi * (∑ j : Fin d, |ξ j|) * δ := by positivity
  calc 2 * ‖Φ (thetaC ξ b) φ‖ * ‖Φ (thetaC ξ b) * J - J * Φ (thetaC ξ b)‖ ≤
        2 * (2 * Real.pi * (∑ j : Fin d, |ξ j|) * δ) * (2 * Real.pi * (∑ j : Fin d, |ξ j|) * c) := by
        gcongr
    _ = 8 * Real.pi ^ 2 * (∑ j : Fin d, |ξ j|) ^ 2 * δ * c := by ring

end PhiPart

end QuantumNLS.FunctionalLinearization

end

end FLPart3

section FLPart4

open NormedSpace ComplexConjugate MeasureTheory
open scoped InnerProductSpace FourierTransform

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

section Remainder

variable {K : Set (EuclideanSpace ℝ (Fin d))} [CompactSpace K]

/-- The Taylor remainder of `f` at `b` as an element of `C(K, ℂ)`. -/
def remC (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (b : EuclideanSpace ℝ (Fin d)) : C(K, ℂ) :=
  liftC (f : EuclideanSpace ℝ (Fin d) → ℂ) f.continuous - (f b) • (1 : C(K, ℂ)) -
    ∑ j : Fin d, (fderiv ℝ f b (EuclideanSpace.single j 1)) •
      (coordC j - ((b j : ℝ) : ℂ) • (1 : C(K, ℂ)))

theorem continuous_rhoC (b : EuclideanSpace ℝ (Fin d)) :
    Continuous (fun ξ : EuclideanSpace ℝ (Fin d) => rhoC (K := K) ξ b) := by
  refine ContinuousMap.continuous_of_continuous_uncurry _ ?_
  unfold rhoC liftC cexpE
  simp only [Function.uncurry, ContinuousMap.coe_mk]
  fun_prop

theorem norm_cexpE (ξ y : EuclideanSpace ℝ (Fin d)) : ‖cexpE ξ y‖ = 1 := by
  unfold cexpE; exact Complex.norm_exp_ofReal_mul_I _

theorem norm_rhoC_le (b : EuclideanSpace ℝ (Fin d)) {R : ℝ} (hR0 : 0 ≤ R)
    (hR : ∀ x : K, ‖(x : EuclideanSpace ℝ (Fin d)) - b‖ ≤ R)
    (ξ : EuclideanSpace ℝ (Fin d)) : ‖rhoC (K := K) ξ b‖ ≤ 2 + 2 * Real.pi * R * ‖ξ‖ := by
  have h0 : 0 ≤ 2 + 2 * Real.pi * R * ‖ξ‖ := by positivity
  rw [ContinuousMap.norm_le _ h0]
  intro x
  have h1 : |inner ℝ ξ ((x : EuclideanSpace ℝ (Fin d)) - b)| ≤ ‖ξ‖ * R :=
    (abs_real_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_left (hR x) (norm_nonneg _))
  simp only [rhoC, liftC, ContinuousMap.coe_mk]
  calc ‖cexpE ξ x - cexpE ξ b - (2 * Real.pi * Complex.I * ((inner ℝ ξ (↑x - b) : ℝ) : ℂ)) * cexpE ξ b‖
      ≤ ‖cexpE ξ x - cexpE ξ b‖ +
        ‖(2 * Real.pi * Complex.I * ((inner ℝ ξ (↑x - b) : ℝ) : ℂ)) * cexpE ξ b‖ := norm_sub_le _ _
    _ ≤ (‖cexpE ξ x‖ + ‖cexpE ξ b‖) + 2 * Real.pi * |inner ℝ ξ ((x : EuclideanSpace ℝ (Fin d)) - b)| := by
        gcongr
        · exact norm_sub_le _ _
        · rw [norm_mul, norm_cexpE, mul_one]
          simp [norm_mul, abs_of_pos Real.pi_pos]
    _ ≤ 2 + 2 * Real.pi * R * ‖ξ‖ := by
        rw [norm_cexpE, norm_cexpE]
        nlinarith [Real.pi_pos, mul_le_mul_of_nonneg_left h1 (by positivity : 0 ≤ 2 * Real.pi)]

theorem integrable_mode (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ)
    (y : EuclideanSpace ℝ (Fin d)) :
    Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => cexpE ξ y • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ) := by
  have hF : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ) :=
    (𝓕 f).integrable
  refine hF.norm.mono' ?_ (Filter.Eventually.of_forall fun ξ => ?_)
  · have hc : Continuous (fun ξ : EuclideanSpace ℝ (Fin d) => (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ) :=
      (𝓕 f).continuous
    unfold cexpE
    exact (by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin d) =>
      Complex.exp (((2 * Real.pi * inner ℝ ξ y : ℝ) : ℂ) * Complex.I)).smul hc |>.aestronglyMeasurable
  · rw [norm_smul, norm_cexpE, one_mul]

theorem integrable_mode_xi (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ)
    (y m : EuclideanSpace ℝ (Fin d)) :
    Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => cexpE ξ y •
      ((2 * ↑Real.pi * Complex.I * ((inner ℝ ξ m : ℝ) : ℂ)) •
        (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ)) := by
  have hF : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => ‖ξ‖ * ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖) := by
    have h := (𝓕 f).integrable_pow_mul MeasureTheory.volume 1
    simp only [pow_one] at h
    exact h
  refine (hF.const_mul (2 * Real.pi * ‖m‖)).mono' ?_ (Filter.Eventually.of_forall fun ξ => ?_)
  · have hc : Continuous (fun ξ : EuclideanSpace ℝ (Fin d) => (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ) :=
      (𝓕 f).continuous
    unfold cexpE
    exact (by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin d) =>
      Complex.exp (((2 * Real.pi * inner ℝ ξ y : ℝ) : ℂ) * Complex.I)).smul
        ((by fun_prop : Continuous fun ξ : EuclideanSpace ℝ (Fin d) =>
          (2 * ↑Real.pi * Complex.I * ((inner ℝ ξ m : ℝ) : ℂ))).smul hc) |>.aestronglyMeasurable
  · rw [norm_smul, norm_cexpE, one_mul, norm_smul, norm_mul, norm_mul, Complex.norm_real]
    simp only [Complex.norm_I, mul_one, Complex.norm_mul, Complex.norm_ofNat, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos Real.pi_pos]
    have h1 : |inner ℝ ξ m| ≤ ‖ξ‖ * ‖m‖ := abs_real_inner_le_norm _ _
    have h2 := norm_nonneg ((𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ)
    nlinarith [Real.pi_pos, mul_le_mul_of_nonneg_right h1 (mul_nonneg h2 (by positivity : (0:ℝ) ≤ 2 * Real.pi))]

theorem integrable_rho (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (b : EuclideanSpace ℝ (Fin d))
    {R : ℝ} (hR0 : 0 ≤ R) (hR : ∀ x : K, ‖(x : EuclideanSpace ℝ (Fin d)) - b‖ ≤ R) :
    Integrable (fun ξ : EuclideanSpace ℝ (Fin d) =>
      (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ • rhoC (K := K) ξ b) := by
  have hF : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖) :=
    (𝓕 f).integrable.norm
  have hF1 : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) =>
      ‖ξ‖ * ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖) := by
    have h := (𝓕 f).integrable_pow_mul MeasureTheory.volume 1
    simp only [pow_one] at h
    exact h
  have hg : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) =>
      2 * ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖ +
        (2 * Real.pi * R) * (‖ξ‖ * ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖)) :=
    (hF.const_mul 2).add (hF1.const_mul _)
  refine hg.mono' ?_ (Filter.Eventually.of_forall fun ξ => ?_)
  · exact ((𝓕 f).continuous.smul (continuous_rhoC b)).aestronglyMeasurable
  · rw [norm_smul]
    have := norm_rhoC_le (K := K) b hR0 hR ξ
    have h2 := norm_nonneg ((𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ)
    calc _ ≤ ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖ * (2 + 2 * Real.pi * R * ‖ξ‖) :=
          mul_le_mul_of_nonneg_left this h2
      _ = _ := by ring

theorem inner_sub_expand (ξ x b : EuclideanSpace ℝ (Fin d)) :
    ((inner ℝ ξ (x - b) : ℝ) : ℂ) = ∑ j : Fin d, (((x j - b j : ℝ)) : ℂ) *
      ((inner ℝ ξ (EuclideanSpace.single j 1) : ℝ) : ℂ) := by
  rw [PiLp.inner_apply]
  push_cast
  refine Finset.sum_congr rfl (fun j _ => ?_)
  simp [EuclideanSpace.inner_single_right, mul_comm]

theorem sum_aux (c F w : ℂ) (u v : Fin d → ℂ) :
    ∑ j, u j * (c * (w * v j * F)) = (w * ∑ j, u j * v j) * c * F := by
  rw [Finset.mul_sum, Finset.sum_mul, Finset.sum_mul]
  exact Finset.sum_congr rfl (fun j _ => by ring)

theorem remC_eq_integral (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) (b : EuclideanSpace ℝ (Fin d))
    {R : ℝ} (hR0 : 0 ≤ R) (hR : ∀ x : K, ‖(x : EuclideanSpace ℝ (Fin d)) - b‖ ≤ R) :
    remC (K := K) f b = ∫ ξ : EuclideanSpace ℝ (Fin d),
      (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ • rhoC (K := K) ξ b := by
  ext x
  have hint := integrable_rho (K := K) f b hR0 hR
  have h1 := ContinuousLinearMap.integral_comp_comm (ContinuousMap.evalCLM ℂ x) hint
  simp only [ContinuousMap.evalCLM_apply] at h1
  rw [← h1]
  have hpt : ∀ ξ : EuclideanSpace ℝ (Fin d), ((𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ • rhoC (K := K) ξ b) x =
      cexpE ξ x • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ - cexpE ξ b • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ -
        ∑ j : Fin d, (((x : EuclideanSpace ℝ (Fin d)) j - b j : ℝ) : ℂ) •
          (cexpE ξ b • ((2 * ↑Real.pi * Complex.I *
            ((inner ℝ ξ (EuclideanSpace.single j 1 : EuclideanSpace ℝ (Fin d)) : ℝ) : ℂ)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ)) := by
    intro ξ
    simp only [rhoC, liftC, ContinuousMap.smul_apply, ContinuousMap.coe_mk, smul_eq_mul]
    rw [inner_sub_expand ξ (x : EuclideanSpace ℝ (Fin d)) b]
    simp only [smul_eq_mul]
    rw [sum_aux]
    ring
  have iA := integrable_mode f (x : EuclideanSpace ℝ (Fin d))
  have iB := integrable_mode f b
  have iC : ∀ j : Fin d, Integrable (fun ξ : EuclideanSpace ℝ (Fin d) =>
      (((x : EuclideanSpace ℝ (Fin d)) j - b j : ℝ) : ℂ) •
        (cexpE ξ b • ((2 * ↑Real.pi * Complex.I *
          ((inner ℝ ξ (EuclideanSpace.single j 1 : EuclideanSpace ℝ (Fin d)) : ℝ) : ℂ)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ))) :=
    fun j => by
      exact MeasureTheory.Integrable.smul (((x : EuclideanSpace ℝ (Fin d)) j - b j : ℝ) : ℂ)
        (integrable_mode_xi f b (EuclideanSpace.single j 1))
  simp_rw [hpt]
  have iAB : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => cexpE ξ (x : EuclideanSpace ℝ (Fin d)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ -
      cexpE ξ b • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ) := iA.sub iB
  have iS : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) => ∑ j : Fin d, (((x : EuclideanSpace ℝ (Fin d)) j - b j : ℝ) : ℂ) •
      (cexpE ξ b • ((2 * ↑Real.pi * Complex.I *
        ((inner ℝ ξ (EuclideanSpace.single j 1 : EuclideanSpace ℝ (Fin d)) : ℝ) : ℂ)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ))) :=
    integrable_finset_sum _ (fun j _ => iC j)
  rw [integral_sub iAB iS, integral_sub iA iB, integral_finset_sum _ (fun j _ => iC j)]
  have e1 : ∫ ξ : EuclideanSpace ℝ (Fin d), cexpE ξ (x : EuclideanSpace ℝ (Fin d)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ = f x :=
    fourier_inv_pt f x
  have e2 : ∫ ξ : EuclideanSpace ℝ (Fin d), cexpE ξ b • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ = f b := fourier_inv_pt f b
  have e3 : ∀ j : Fin d, ∫ ξ : EuclideanSpace ℝ (Fin d), (((x : EuclideanSpace ℝ (Fin d)) j - b j : ℝ) : ℂ) •
        (cexpE ξ b • ((2 * ↑Real.pi * Complex.I *
          ((inner ℝ ξ (EuclideanSpace.single j 1 : EuclideanSpace ℝ (Fin d)) : ℝ) : ℂ)) • (𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ)) =
      (((x : EuclideanSpace ℝ (Fin d)) j - b j : ℝ) : ℂ) • fderiv ℝ f b (EuclideanSpace.single j 1) := by
    intro j
    rw [integral_smul]
    congr 1
    exact fourier_deriv_pt f (EuclideanSpace.single j 1) b
  simp only [e3]
  rw [e1, e2]
  simp only [remC, liftC, coordC, ContinuousMap.sub_apply, ContinuousMap.smul_apply,
    ContinuousMap.coe_mk, ContinuousMap.coe_sum, Finset.sum_apply, ContinuousMap.one_apply,
    smul_eq_mul, mul_one]
  congr 1
  refine Finset.sum_congr rfl (fun j _ => ?_)
  push_cast
  ring

end Remainder

end QuantumNLS.FunctionalLinearization

end

end FLPart4

section FLPart5

open NormedSpace ComplexConjugate MeasureTheory
open scoped InnerProductSpace FourierTransform

noncomputable section

namespace QuantumNLS.FunctionalLinearization

variable {d : ℕ}

section Bound

variable {K : Set (EuclideanSpace ℝ (Fin d))} [CompactSpace K]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (Φ : C(K, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H))

/-- The constant `C_F = 8π² d² ∫ ‖ξ‖² |f̂(ξ)| dξ`. -/
def CF (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ) : ℝ :=
  8 * Real.pi ^ 2 * (d : ℝ) ^ 2 * ∫ ξ : EuclideanSpace ℝ (Fin d), ‖ξ‖ ^ 2 * ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖

/-- The functional `g ↦ ⟨φ, [Φ g, J] φ⟩` as a continuous linear functional on `C(K,ℂ)`. -/
def LamCLM (J : H →L[ℂ] H) (φ : H) : C(K, ℂ) →L[ℂ] ℂ :=
  (innerSL ℂ φ).comp ((ContinuousLinearMap.apply ℂ H φ).comp
    (((ContinuousLinearMap.mul ℂ (H →L[ℂ] H)).flip J - ContinuousLinearMap.mul ℂ (H →L[ℂ] H) J).comp
      (LinearMap.mkContinuous (Φ.toAlgHom : C(K, ℂ) →ₗ[ℂ] (H →L[ℂ] H)) 1
        (fun f => by simpa using Phi_norm_le Φ f))))

theorem LamCLM_apply (J : H →L[ℂ] H) (φ : H) (g : C(K, ℂ)) :
    LamCLM Φ J φ g = ⟪φ, (Φ g * J - J * Φ g) φ⟫_ℂ := by
  simp [LamCLM]

theorem sum_abs_le (ξ : EuclideanSpace ℝ (Fin d)) : ∑ j : Fin d, |ξ j| ≤ d * ‖ξ‖ := by
  have : ∀ j : Fin d, |ξ j| ≤ ‖ξ‖ := fun j => by
    have := PiLp.norm_apply_le ξ j
    simpa using this
  calc ∑ j : Fin d, |ξ j| ≤ ∑ j : Fin d, ‖ξ‖ := Finset.sum_le_sum (fun j _ => this j)
    _ = d * ‖ξ‖ := by simp

/-- **The key estimate**: for `r = F(B) − F(b) − ∇F(b)·(B − b)`, the commutator expectation is
`O(δ c)` with the constant `C_F` depending only on `F`. -/
theorem Phi_remC_bound [Nontrivial H] (f : SchwartzMap (EuclideanSpace ℝ (Fin d)) ℂ)
    (b : EuclideanSpace ℝ (Fin d)) {R : ℝ} (hR0 : 0 ≤ R)
    (hR : ∀ x : K, ‖(x : EuclideanSpace ℝ (Fin d)) - b‖ ≤ R) (J : H →L[ℂ] H) (φ : H)
    (hφ : ‖φ‖ ≤ 1) {δ c : ℝ} (hδ : 0 ≤ δ) (hc0 : 0 ≤ c)
    (hX : ∀ j, ‖(Φ (coordC j) - ((b j : ℝ) : ℂ) • (1 : H →L[ℂ] H)) φ‖ ≤ δ)
    (hc : ∀ j, ‖Φ (coordC j) * J - J * Φ (coordC j)‖ ≤ c) :
    ‖⟪φ, (Φ (remC (K := K) f b) * J - J * Φ (remC (K := K) f b)) φ⟫_ℂ‖ ≤ CF f * δ * c := by
  rw [← LamCLM_apply, remC_eq_integral f b hR0 hR]
  have hint := integrable_rho (K := K) f b hR0 hR
  rw [← ContinuousLinearMap.integral_comp_comm _ hint]
  have hg : Integrable (fun ξ : EuclideanSpace ℝ (Fin d) =>
      ‖ξ‖ ^ 2 * ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖ * (8 * Real.pi ^ 2 * (d : ℝ) ^ 2 * δ * c)) := by
    exact ((𝓕 f).integrable_pow_mul MeasureTheory.volume 2).mul_const _
  refine (norm_integral_le_of_norm_le hg (Filter.Eventually.of_forall fun ξ => ?_)).trans (le_of_eq ?_)
  · rw [map_smul, smul_eq_mul, norm_mul, LamCLM_apply]
    have h1 := rho_comm_bound Φ ξ b J φ hφ hδ hc0 hX hc
    have h2 : (∑ j : Fin d, |ξ j|) ^ 2 ≤ ((d : ℝ) * ‖ξ‖) ^ 2 :=
      pow_le_pow_left₀ (Finset.sum_nonneg (fun j _ => abs_nonneg _)) (sum_abs_le ξ) 2
    have h3 : 8 * Real.pi ^ 2 * (∑ j : Fin d, |ξ j|) ^ 2 * δ * c ≤
        8 * Real.pi ^ 2 * ((d : ℝ) * ‖ξ‖) ^ 2 * δ * c := by gcongr
    have h4 := norm_nonneg ((𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ)
    calc ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖ * ‖⟪φ, (Φ (rhoC ξ b) * J - J * Φ (rhoC ξ b)) φ⟫_ℂ‖
        ≤ ‖(𝓕 (f : EuclideanSpace ℝ (Fin d) → ℂ)) ξ‖ * (8 * Real.pi ^ 2 * ((d : ℝ) * ‖ξ‖) ^ 2 * δ * c) :=
          mul_le_mul_of_nonneg_left (h1.trans h3) h4
      _ = _ := by ring
  · rw [integral_mul_const]
    unfold CF
    ring

end Bound

end QuantumNLS.FunctionalLinearization

end

