/-- **PROP-022 (Q7B:lem:pair), physical quadratic propagator.** -/
theorem PROP022_physical_quadratic_propagator
    (K : ∀ n, HN L (n+1) →L[ℂ] HN L (n+1)) (M A : ℝ) (hM : 1 ≤ M) (hA : 0 < A)
    (hK : ∀ n, ‖K n‖ ≤ M * A^(n+1) / Real.sqrt ((2*(n+1)).factorial : ℝ))
    (hsK : ∀ n, (K n).adjoint = K n) (u₀ : Prop001.Sphere (L2T L)) (T P : ℝ) (hP : 1 ≤ P) :
    let B := positiveExtension K
    let hB := positiveExtension_bound K M A hK
    let hsa := positiveExtension_selfAdjoint K hsK
    let Phi := classicalFlow B M A hA.le hB hsa
    let u := profile B M A hA.le hB hsa u₀
    let S := fun t s : ℝ => fderiv ℝ (Phi (t - s)) (u s)
    let a := fun t : ℝ => numberOperator B (u t)
    let b := fun t : ℝ => pairKernel B (u t)
    let α := alpha B M A hA.le hB hsa u₀
    let β := betaBlock B M A hA.le hB hsa u₀
    let V := fun t s : ℝ => propagator B M A (by linarith) hA.le hB hsa u₀ s t
    -- the pair kernel is Hilbert--Schmidt; both printed coefficient bounds
    (∀ t, (a t).adjoint = a t ∧
      (∀ i j : ℤ, ⟪physicalBasis L i, b t (physicalBasis L j)⟫_ℂ =
        ⟪physicalBasis L j, b t (physicalBasis L i)⟫_ℂ) ∧
      TraceClass.hsSq (physicalBasis L) (b t) ≠ ⊤ ∧
      Real.sqrt ((TraceClass.hsSq (physicalBasis L) (b t)).toReal) ≤ pairMajorant A * M ∧
      ‖a t‖ ≤ M * ∑' r : ℕ, (((r+1 : ℕ) : ℝ)^2 * A^(r+1) / Real.sqrt ((2*(r+1)).factorial : ℝ))) ∧
    -- S is the derivative of the printed flow and solves the linearized equation
    (∀ s t : ℝ, S t s = (flow B M A hA.le hB hsa u₀ t s).toContinuousLinearMap) ∧
    (∀ s t (x : L2T L), Complex.I • deriv (fun r => S r s x) t =
      a t (S t s x) + b t (conjugation (physicalBasis L) (S t s x))) ∧
    (∀ s t (x : L2T L), S t s x = α t s x + β t s (conjugation (physicalBasis L) x)) ∧
    -- the beta estimate under the printed P hypothesis, including negative time
    ((∀ r q : ℝ, |r| ≤ T → |q| ≤ T → ‖S r q‖ ≤ P) → ∀ t, |t| ≤ T →
      TraceClass.hsSq (physicalBasis L) (β t 0) ≠ ⊤ ∧
      Real.sqrt ((TraceClass.hsSq (physicalBasis L) (β t 0)).toReal) ≤ |t| * pairMajorant A * M * P) ∧
    -- the unitary propagator of Q(t)
    (∀ s (x : Fock L), V s s x = x) ∧
    (∀ r s t (x : Fock L), V t s (V s r x) = V t r x) ∧
    (∀ s (x : Fock L), Continuous (fun t => V t s x)) ∧
    -- strong Schrodinger equation i dV/dt = Q(t) V on the common moment domain
    (∀ s t (x : Fock L), (∀ j : ℕ, x ∈ Ext005Moments.momentDomain (L := L) j) →
      HasDerivAt (fun r => V r s x) ((-Complex.I) •
        Prop022StrongOperatorR125.strongCoordinates (numberCoefficient B (u t))
          (pairCoefficient B (u t)) (Ext005FormCutoffR109.rootLift 2 (V t s x))) t) ∧
    -- it implements S(t,s) in the printed Weyl convention W(v) = exp(a*(v) - a(v))
    (∀ s t (v : L2T L) (x : Fock L),
      V t s (printedWeyl v ((V t s).symm x)) = printedWeyl (S t s v) x) ∧
    -- the vacuum evolution is pure quasifree with the printed number identity
    (∀ t, PhysicalQuasifreeSource (V t 0 vac) ∧ ‖V t 0 vac‖ = 1 ∧
      numberExpectation (fun n => (n : ℝ≥0∞)) (V t 0 vac) =
        TraceClass.hsSq (physicalBasis L) (β t 0)) := by
  intro B hB hsa Phi u S a b α β V
  have hM0 : 0 ≤ M := by linarith
  have hSeq : ∀ s t : ℝ, S t s = (flow B M A hA.le hB hsa u₀ t s).toContinuousLinearMap :=
    fun s t => (flow_eq_fderiv B M A hA.le hB hsa u₀ s t).symm
  refine ⟨fun t => ?_, hSeq, fun s t x => ?_, fun s t x => ?_, fun hPhi t ht => ?_,
    fun s x => evolution_self B M A hM0 hA.le hB hsa u₀ s x,
    fun r s t x => evolution_comp B M A hM0 hA.le hB hsa u₀ r s t x,
    fun s x => evolution_continuous B M A hM0 hA.le hB hsa u₀ s x,
    fun s t x hx => Prop022SmoothDomainR126.evolution_smooth_hasDerivAt B M A hM0 hA.le hB hsa u₀
      s t x ((Prop022SmoothDomainR126.smooth_iff_moments x).mpr hx),
    fun s t v x => ?_, fun t => ?_⟩
  · obtain ⟨h1, h2, h3⟩ := PROP022_printed_coefficient_bounds_R122 B M A hA.le hB hsa u₀ t
    exact ⟨numberOperator_adjoint B hsa (u t), pairKernel_symmetric B (u t), h1, h2,
      (numberOperator_norm_le B (u t)).trans h3⟩
  · have hfun : (fun r => S r s x) = fun r => flow B M A hA.le hB hsa u₀ r s x := by
      funext r; rw [hSeq]; rfl
    rw [hfun, hSeq]
    exact flow_printed_linearized B M A hA.le hB hsa u₀ s t x
  · rw [hSeq]
    exact flow_blocks B M A hA.le hB hsa u₀ t s x
  · exact printed_beta_bound_from_classical B M A hA.le hB hsa u₀ hM0 T P hP hPhi t ht
  · have h := printed_of_source (Sp B M A hA.le hB hsa u₀ t s)
      (propagator B M A hM0 hA.le hB hsa u₀ s t)
      (propagator_implements B M A hM0 hA.le hB hsa u₀ s t)
      (flow B M A hA.le hB hsa u₀ t s) (Sp_negI B M A hA.le hB hsa u₀ t s) v x
    rw [hSeq]
    exact h
  · have hβ : TraceClass.hsSq (physicalBasis L)
        (beta (physicalBasis L) (Sp B M A hA.le hB hsa u₀ t 0)) ≠ ⊤ := by
      rw [hsSq_beta_Sp]
      exact Prop022WeylVacuumR124.actual_beta_finite B M A hM0 hA.le hB hsa u₀ 0 t
    obtain ⟨h1, h2, h3, _⟩ := implementer_vacuum (Sp B M A hA.le hB hsa u₀ t 0)
      (Sp_symplectic B M A hA.le hB hsa u₀ t 0) hβ
      (propagator B M A hM0 hA.le hB hsa u₀ 0 t)
      (propagator_implements B M A hM0 hA.le hB hsa u₀ 0 t)
    exact ⟨h1, h2, h3.trans (hsSq_beta_Sp B M A hA.le hB hsa u₀ t 0)⟩

