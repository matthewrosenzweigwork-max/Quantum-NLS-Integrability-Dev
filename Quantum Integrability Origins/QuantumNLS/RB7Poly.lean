import Mathlib
import QuantumNLS.ClassicalCharges

/-!
# R-7B122087 `thm:hierarchy`: the DEF-022 recursion as a differential polynomial (own TODO A2, step 2)

Printed: "The differential-polynomial recursion makes `I_{r+1}` a smooth real functional on `H^q`."  Here the DEF-022 recursion
`v_1 = u`, `v_{j+1} = -i ∂_x v_j + κ ū Σ_{a=1}^{j-1} v_a v_{j-a}` is realized, literally and with the same index structure, in the algebra `JP = ℂ[X_{b,a}]` of polynomials in the jet
variables `X_{false,a} = ∂^a u`, `X_{true,a} = conj ∂^a u`, with the total derivation `dd` (`dd X_{b,a} = X_{b,a+1}`; `MvPolynomial.mkDerivation`):

* `jp κ j : JP`, defined by the verbatim recursion (`jp_succ`);
* `evj f x : JP →ₐ[ℂ] ℂ`, evaluation at the jet of `f` at `x`; `hasDerivAt_evj`: `d/dx evj f x P = evj f x (dd P)` for `f ∈ C^∞`;
* `vseq_eq_evj`: for `f ∈ C^∞`, `vseq κ f j x = evj f x (jp κ j)` (the printed recursion IS this polynomial);
* `jp_mem`: `jp κ j` only involves derivatives of order `≤ j - 1` (`JR`: the subalgebra generated by `X_{b,a}`, `a ≤ N`); `dd_mem`.
No analytic input.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
noncomputable section

open scoped ComplexConjugate ContDiff
open QuantumNLS.ClassicalCharges

namespace QuantumNLS.RB7

/-- Jet variables: `(false, a) ↔ ∂^a u`, `(true, a) ↔ conj ∂^a u`. -/
abbrev JetIdx : Type := Bool × ℕ

/-- Polynomials in the jet variables over `ℂ`. -/
abbrev JP : Type := MvPolynomial JetIdx ℂ

/-- `dd (X_{b,a}) = X_{b,a+1}`. -/
def jetShift (i : JetIdx) : JP := MvPolynomial.X (i.1, i.2 + 1)

/-- The total derivative on jet polynomials. -/
def dd : Derivation ℂ JP JP := MvPolynomial.mkDerivation ℂ jetShift

theorem dd_X (i : JetIdx) : dd (MvPolynomial.X i) = MvPolynomial.X (i.1, i.2 + 1) :=
  MvPolynomial.mkDerivation_X ℂ jetShift i

theorem dd_C (c : ℂ) : dd (MvPolynomial.C c) = 0 := by
  rw [← MvPolynomial.algebraMap_eq]; exact dd.map_algebraMap c

/-- The DEF-022 recursion in jet polynomials. -/
def jp (κ : ℝ) : ℕ → JP
  | 0 => 0
  | 1 => MvPolynomial.X (false, 0)
  | (j + 2) =>
      -(MvPolynomial.C Complex.I) * dd (jp κ (j + 1)) +
        MvPolynomial.C (κ : ℂ) * MvPolynomial.X (true, 0) *
          ∑ a ∈ (Finset.Icc 1 j).attach, jp κ a.1 * jp κ (j + 1 - a.1)
  decreasing_by
    all_goals
      first
        | omega
        | (have h := Finset.mem_Icc.mp a.2
           simp only [Nat.succ_eq_add_one]
           omega)

theorem jp_one (κ : ℝ) : jp κ 1 = MvPolynomial.X (false, 0) := by rw [jp]

theorem jp_succ (κ : ℝ) (j : ℕ) :
    jp κ (j + 2) = -(MvPolynomial.C Complex.I) * dd (jp κ (j + 1)) +
        MvPolynomial.C (κ : ℂ) * MvPolynomial.X (true, 0) *
          ∑ a ∈ Finset.Icc 1 j, jp κ a * jp κ (j + 1 - a) := by
  rw [jp]
  simp only [Finset.sum_attach (Finset.Icc 1 j) (fun a => jp κ a * jp κ (j + 1 - a))]

/-! ### Evaluation at jets -/

/-- The jet of `f` at `x`. -/
def jetPt (f : ℝ → ℂ) (x : ℝ) : JetIdx → ℂ := fun i =>
  if i.1 then conj (iteratedDeriv i.2 f x) else iteratedDeriv i.2 f x

/-- Evaluation of jet polynomials at the jet of `f` at `x`. -/
def evj (f : ℝ → ℂ) (x : ℝ) : JP →ₐ[ℂ] ℂ := MvPolynomial.aeval (jetPt f x)

theorem evj_X (f : ℝ → ℂ) (x : ℝ) (i : JetIdx) : evj f x (MvPolynomial.X i) = jetPt f x i := by
  simp [evj]

theorem hasDerivAt_jetPt {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f) (i : JetIdx) (x : ℝ) :
    HasDerivAt (fun y => jetPt f y i) (jetPt f x (i.1, i.2 + 1)) x := by
  have hd : ∀ m : ℕ, HasDerivAt (iteratedDeriv m f) (iteratedDeriv (m + 1) f x) x := by
    intro m
    have hdiff : Differentiable ℝ (iteratedDeriv m f) :=
      hf.differentiable_iteratedDeriv m (by exact_mod_cast ENat.natCast_lt_top m)
    rw [iteratedDeriv_succ]
    exact (hdiff x).hasDerivAt
  obtain ⟨b, m⟩ := i
  cases b
  · simpa [jetPt] using hd m
  · simpa [jetPt, Complex.star_def] using (hd m).star

theorem hasDerivAt_evj {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f) (P : JP) (x : ℝ) :
    HasDerivAt (fun y => evj f y P) (evj f x (dd P)) x := by
  induction P using MvPolynomial.induction_on with
  | C c =>
    rw [dd_C]
    simpa [evj] using hasDerivAt_const x c
  | add p q hp hq =>
    have e : (fun y => evj f y (p + q)) = fun y => evj f y p + evj f y q := by
      funext y; rw [map_add]
    rw [e, map_add dd, map_add]
    exact hp.add hq
  | mul_X p i hp =>
    have h2 := hasDerivAt_jetPt hf i x
    have h3 := hp.mul h2
    have e : (fun y => evj f y (p * MvPolynomial.X i)) = fun y => evj f y p * jetPt f y i := by
      funext y; rw [map_mul, evj_X]
    rw [e, Derivation.leibniz, dd_X, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, evj_X, evj_X]
    convert h3 using 1
    ring

/-! ### The printed recursion is the polynomial recursion -/

theorem vseq_eq_evj (κ : ℝ) {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f) (j : ℕ) (x : ℝ) :
    vseq κ f j x = evj f x (jp κ j) := by
  induction j using Nat.strong_induction_on generalizing x with
  | _ j ih =>
    match j, ih with
    | 0, _ => simp [vseq, jp]
    | 1, _ =>
      rw [vseq_one, jp_one, evj_X]
      simp [jetPt]
    | k + 2, ih =>
      have hfun : vseq κ f (k + 1) = fun y => evj f y (jp κ (k + 1)) :=
        funext fun y => ih (k + 1) (by omega) y
      have hder : deriv (vseq κ f (k + 1)) x = evj f x (dd (jp κ (k + 1))) := by
        rw [hfun]; exact (hasDerivAt_evj hf _ x).deriv
      have hsum : ∑ a ∈ Finset.Icc 1 k, vseq κ f a x * vseq κ f (k + 1 - a) x =
          ∑ a ∈ Finset.Icc 1 k, evj f x (jp κ a) * evj f x (jp κ (k + 1 - a)) := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        have ha' := Finset.mem_Icc.mp ha
        rw [ih a (by omega) x, ih (k + 1 - a) (by omega) x]
      have hC : ∀ c : ℂ, evj f x (MvPolynomial.C c) = c := fun c => by simp [evj]
      have h0 : jetPt f x (true, 0) = conj (f x) := by simp [jetPt]
      have := congrFun (vseq_succ κ f k) x
      rw [this, jp_succ, hder, hsum]
      simp only [map_add, map_mul, map_neg, map_sum, hC, evj_X, h0]

/-! ### Derivative orders -/

/-- Jet polynomials in the variables of derivative order `≤ N`. -/
def JR (N : ℕ) : Subalgebra ℂ JP :=
  Algebra.adjoin ℂ (MvPolynomial.X '' {i : JetIdx | i.2 ≤ N})

theorem JR_mono {N M : ℕ} (h : N ≤ M) : JR N ≤ JR M :=
  Algebra.adjoin_mono (Set.image_mono (fun _ hi => le_trans hi h))

theorem X_mem_JR {N : ℕ} {i : JetIdx} (h : i.2 ≤ N) : (MvPolynomial.X i : JP) ∈ JR N :=
  Algebra.subset_adjoin ⟨i, h, rfl⟩

theorem dd_mem {N : ℕ} {P : JP} (hP : P ∈ JR N) : dd P ∈ JR (N + 1) := by
  induction hP using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    rw [dd_X]
    exact X_mem_JR (by simpa using Nat.succ_le_succ hi)
  | algebraMap r =>
    rw [dd.map_algebraMap]
    exact zero_mem _
  | add x y hx hy ihx ihy => rw [map_add]; exact add_mem ihx ihy
  | mul x y hx hy ihx ihy =>
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact add_mem (mul_mem (JR_mono (Nat.le_succ N) hx) ihy) (mul_mem (JR_mono (Nat.le_succ N) hy) ihx)

theorem C_mem_JR (N : ℕ) (c : ℂ) : (MvPolynomial.C c : JP) ∈ JR N :=
  algebraMap_mem (JR N) c

theorem jp_mem (κ : ℝ) (j : ℕ) : jp κ j ∈ JR (j - 1) := by
  induction j using Nat.strong_induction_on with
  | _ j ih =>
    match j, ih with
    | 0, _ => rw [show jp κ 0 = 0 by rw [jp]]; exact zero_mem _
    | 1, _ => rw [jp_one]; exact X_mem_JR (by simp)
    | k + 2, ih =>
      rw [jp_succ]
      have h1 : dd (jp κ (k + 1)) ∈ JR (k + 1) := dd_mem (ih (k + 1) (by omega))
      refine add_mem (mul_mem (neg_mem (C_mem_JR _ _)) h1) (mul_mem (mul_mem (C_mem_JR _ _) (X_mem_JR (by simp))) ?_)
      refine Subalgebra.sum_mem _ (fun a ha => ?_)
      have ha' := Finset.mem_Icc.mp ha
      refine mul_mem (JR_mono (by omega) (ih a (by omega))) (JR_mono (by omega) (ih (k + 1 - a) (by omega)))

end QuantumNLS.RB7

#print axioms QuantumNLS.RB7.vseq_eq_evj
#print axioms QuantumNLS.RB7.jp_mem
#print axioms QuantumNLS.RB7.dd_mem
