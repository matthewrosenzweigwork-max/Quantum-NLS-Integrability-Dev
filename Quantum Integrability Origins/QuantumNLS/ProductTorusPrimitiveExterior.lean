import QuantumNLS.ProductTorusPrimitive

/-!
# R-4C2E4AC7 (`thm:global-product-torus`), stage T7b: `dᾱ = ω` and `ᾱ(X_{I_n}) = −I_n`

Source: `chapters/global/product_torus.tex`, proof section "Averaging the primitive":
"... justifies differentiation under the scalar integral. No Bochner integral with values in the nonseparable space of
bounded operators is needed. Since `d(T_θ^*α) = T_θ^*ω = ω`, the preceding derivative justification gives `dᾱ = ω`
on all Hilbert tangent pairs. ... Differentiate this invariance in the one coordinate generated by `X_{I_n}`. The
elementary Cartan identity for a differentiable one-form yields
`0 = L_{X_{I_n}}ᾱ = d(ᾱ(X_{I_n})) + ι_{X_{I_n}}dᾱ = d(ᾱ(X_{I_n}) + I_n)`. This identity follows directly by
differentiating the pullback on a fixed tangent vector, so it is valid for the strong Hilbert form. The scalar function
in the last line is constant on the connected space. At zero, each `I_n` vanishes and its differential is zero by
nonnegativity; hence its constant is zero."

Differentiation under the scalar integral (mathlib `hasDerivAt_integral_of_dominated_loc_of_deriv_le`), along
arbitrary `C¹` curves, with domination from T7a `local_bounds` (bounds uniform over the product group and over the
fibres of all nearby points, from properness) and the T2d/T5c Gronwall bounds; measurability of the second-derivative
integrand is T7a `measurable_alpha_fderiv2` (no GP-14 clause).

Proved (hypotheses T7a `PHyp`):
* `dAlpha x a b = ∫ (α_{DT a}(DT b) + α_{T x}(D²T[a,b]))`, `integrable_dInt`;
* **`hasDerivAt_alphaBar_curve`**: for `C¹` curves `c, w`,
  `d/dt ᾱ_{c t}(w t) = dAlpha (c t) (c' t) (w t) + ᾱ_{c t}(w' t)`;
* **`d_alphaBar`** (`dᾱ = ω`): `d/ds|₀ ᾱ_{u+sa}(b) = dAlpha u a b` and `dAlpha u a b − dAlpha u b a = ω(a,b)`
  (pointwise: T5a `symplectic` and T5c `fderiv2_flow_symm`);
* `lie_zero` (`L_{X_{I_n}}ᾱ = 0`, by differentiating T7a `alphaBar_invariant` along T4b `act_single`);
* **`alphaBar_Xn`** (`ᾱ(X_{I_n}) = −I_n`): the Cartan computation along the segment `s ↦ s u`, with
  `I_n(0) = 0` (mass identity and positivity) and `dI_n(0) = 0` (local minimum).
-/

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option maxSynthPendingDepth 3

open Filter Topology Set Metric MeasureTheory
open scoped InnerProductSpace NNReal

noncomputable section

namespace QuantumNLS.ProductTorusPrimitiveExterior

open _root_.HilbertL1Compact (L1)
open QuantumNLS.ProductTorusGenerator QuantumNLS.ProductTorusFlow QuantumNLS.ProductTorusVariational
  QuantumNLS.ProductTorusCommute QuantumNLS.ProductTorusContinuity QuantumNLS.ProductTorusAction
  QuantumNLS.ProductTorusFixedVector QuantumNLS.ProductTorusSymplectic QuantumNLS.ProductTorusSecondVariation
  QuantumNLS.ProductTorusPrimitive
open QuantumNLS.Ext025B6TorusCoordinates (Torus)
open QuantumNLS.Ext025BHaar (productCircleHaar)

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
attribute [local instance] InnerProductSpace.complexToReal

variable {I : E → L1 ℝ} {DI : E → (E →L[ℝ] L1 ℝ)}

/-! ## 1. Uniform local bounds and the derivative integrand -/

theorem uniform_local (H : PHyp I DI) (x₀ : E) : ∃ ρ > (0 : ℝ), ∃ M C1 C2 : ℝ, 0 ≤ M ∧ 0 ≤ C1 ∧ 0 ≤ C2 ∧
    ∀ x ∈ ball x₀ ρ, ∀ ψ : Torus, ‖act DI ψ x‖ ≤ M ∧ ‖fderiv ℝ (act DI ψ) x‖ ≤ C1 ∧
      ‖fderiv ℝ (fderiv ℝ (act DI ψ)) x‖ ≤ C2 := by
  obtain ⟨ρ, hρ, M, hM0, hM⟩ := local_bounds H x₀
  refine ⟨ρ, hρ, M, Real.exp (Real.pi * M / 2 + 1), Real.pi * M / 2 * Real.exp (Real.pi * M / 2 + 1) *
    Real.exp (Real.pi * M / 2 + 1) / (Real.pi * M / 2 + 1) * Real.exp (Real.pi * M / 2 + 1), hM0,
    (Real.exp_pos _).le, by positivity, fun x hx ψ => ⟨(hM x hx _ (act_mem_fibre H ψ x)).1,
    norm_fderiv_act_le H ψ x (fun w hw => (hM x hx w hw).2.1),
    norm_fderiv2_act_le H ψ x hM0 (fun w hw => (hM x hx w hw).2.1) (fun w hw => (hM x hx w hw).2.2)⟩⟩

/-- The integrand of the directional derivative of `ᾱ`. -/
def dInt (DI : E → (E →L[ℝ] L1 ℝ)) (x a b : E) (ψ : Torus) : ℝ :=
  alpha (fderiv ℝ (act DI ψ) x a) (fderiv ℝ (act DI ψ) x b) +
    alpha (act DI ψ x) (fderiv ℝ (fderiv ℝ (act DI ψ)) x a b)

/-- `dAlpha x a b`: the derivative of `ᾱ_·(b)` at `x` in direction `a`. -/
def dAlpha (DI : E → (E →L[ℝ] L1 ℝ)) (x a b : E) : ℝ := ∫ ψ, dInt DI x a b ψ ∂productCircleHaar

theorem measurable_dInt (H : PHyp I DI) (x a b : E) : Measurable (dInt DI x a b) :=
  (continuous_alpha_comp (continuous_fderiv_act H x a) (continuous_fderiv_act H x b)).measurable.add
    (measurable_alpha_fderiv2 H x a b)

theorem norm_dInt_le {x a b : E} {M C1 C2 : ℝ} (hM0 : 0 ≤ M) (hC1 : 0 ≤ C1) (ψ : Torus)
    (hb : ‖act DI ψ x‖ ≤ M ∧ ‖fderiv ℝ (act DI ψ) x‖ ≤ C1 ∧ ‖fderiv ℝ (fderiv ℝ (act DI ψ)) x‖ ≤ C2) :
    ‖dInt DI x a b ψ‖ ≤ C1 * ‖a‖ * (C1 * ‖b‖) + M * (C2 * ‖a‖ * ‖b‖) := by
  obtain ⟨hT, hD, hD2⟩ := hb
  have e1 : ‖fderiv ℝ (act DI ψ) x a‖ ≤ C1 * ‖a‖ :=
    ((fderiv ℝ (act DI ψ) x).le_opNorm a).trans (mul_le_mul_of_nonneg_right hD (norm_nonneg _))
  have e2 : ‖fderiv ℝ (act DI ψ) x b‖ ≤ C1 * ‖b‖ :=
    ((fderiv ℝ (act DI ψ) x).le_opNorm b).trans (mul_le_mul_of_nonneg_right hD (norm_nonneg _))
  have e4 : ‖fderiv ℝ (fderiv ℝ (act DI ψ)) x a b‖ ≤ C2 * ‖a‖ * ‖b‖ :=
    (ContinuousLinearMap.le_opNorm₂ _ _ _).trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hD2 (norm_nonneg _)) (norm_nonneg _))
  unfold dInt
  rw [Real.norm_eq_abs]
  refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
  · exact (abs_alpha_le _ _).trans (mul_le_mul e1 e2 (norm_nonneg _) (mul_nonneg hC1 (norm_nonneg _)))
  · exact (abs_alpha_le _ _).trans (mul_le_mul hT e4 (norm_nonneg _) hM0)

theorem integrable_dInt (H : PHyp I DI) (x a b : E) : Integrable (dInt DI x a b) productCircleHaar := by
  obtain ⟨ρ, hρ, M, C1, C2, hM0, hC1, -, hb⟩ := uniform_local H x
  exact Integrable.of_bound (measurable_dInt H x a b).aestronglyMeasurable _
    (Eventually.of_forall fun ψ => norm_dInt_le hM0 hC1 ψ (hb x (mem_ball_self hρ) ψ))

/-! ## 2. Differentiation under the integral along `C¹` curves -/

/-- The integrand along curves `c, w`. -/
def curveF (DI : E → (E →L[ℝ] L1 ℝ)) (c w : ℝ → E) (t : ℝ) (ψ : Torus) : ℝ :=
  alpha (act DI ψ (c t)) (fderiv ℝ (act DI ψ) (c t) (w t))

/-- Its derivative. -/
def curveF' (DI : E → (E →L[ℝ] L1 ℝ)) (c w c' w' : ℝ → E) (t : ℝ) (ψ : Torus) : ℝ :=
  alpha (fderiv ℝ (act DI ψ) (c t) (c' t)) (fderiv ℝ (act DI ψ) (c t) (w t)) +
    alpha (act DI ψ (c t)) (fderiv ℝ (fderiv ℝ (act DI ψ)) (c t) (c' t) (w t) + fderiv ℝ (act DI ψ) (c t) (w' t))

theorem curveF'_eq (c w c' w' : ℝ → E) (t : ℝ) (ψ : Torus) :
    curveF' DI c w c' w' t ψ = dInt DI (c t) (c' t) (w t) ψ + alpha (act DI ψ (c t)) (fderiv ℝ (act DI ψ) (c t) (w' t)) := by
  unfold curveF' dInt
  rw [alpha_add_right]
  ring

theorem hasDerivAt_curveF (H : PHyp I DI) {c w c' w' : ℝ → E} (hc : ∀ t, HasDerivAt c (c' t) t)
    (hw : ∀ t, HasDerivAt w (w' t) t) (ψ : Torus) (t : ℝ) :
    HasDerivAt (fun s => curveF DI c w s ψ) (curveF' DI c w c' w' t ψ) t := by
  have h1 : HasDerivAt (fun s => act DI ψ (c s)) (fderiv ℝ (act DI ψ) (c t) (c' t)) t :=
    (hasFDerivAt_act H ψ (c t)).comp_hasDerivAt t (hc t)
  have h2 : HasDerivAt (fun s => fderiv ℝ (act DI ψ) (c s) (w s))
      (fderiv ℝ (fderiv ℝ (act DI ψ)) (c t) (c' t) (w t) + fderiv ℝ (act DI ψ) (c t) (w' t)) t :=
    ((hasFDerivAt_fderiv_act H ψ (c t)).comp_hasDerivAt t (hc t)).clm_apply (hw t)
  exact hasDerivAt_alpha h1 h2

/-- **Differentiation of `ᾱ` along `C¹` curves under the scalar Haar integral.** -/
theorem hasDerivAt_alphaBar_curve (H : PHyp I DI) {c w c' w' : ℝ → E} (hc : ∀ t, HasDerivAt c (c' t) t)
    (hw : ∀ t, HasDerivAt w (w' t) t) (hc' : Continuous c') (hw' : Continuous w') (t₀ : ℝ) :
    HasDerivAt (fun t => alphaBar DI (c t) (w t))
      (dAlpha DI (c t₀) (c' t₀) (w t₀) + alphaBar DI (c t₀) (w' t₀)) t₀ := by
  obtain ⟨ρ, hρ, M, C1, C2, hM0, hC1, hC2, hb⟩ := uniform_local H (c t₀)
  have hcc : Continuous c := continuous_iff_continuousAt.2 fun t => (hc t).continuousAt
  have hwc : Continuous w := continuous_iff_continuousAt.2 fun t => (hw t).continuousAt
  obtain ⟨δ₀, hδ₀, hδc⟩ := Metric.continuousAt_iff.1 (hcc.continuousAt (x := t₀)) ρ hρ
  obtain ⟨B1, hB1⟩ := (isCompact_closedBall t₀ 1).exists_bound_of_continuousOn hc'.continuousOn
  obtain ⟨B2, hB2⟩ := (isCompact_closedBall t₀ 1).exists_bound_of_continuousOn hwc.continuousOn
  obtain ⟨B3, hB3⟩ := (isCompact_closedBall t₀ 1).exists_bound_of_continuousOn hw'.continuousOn
  have ht₀ : t₀ ∈ closedBall t₀ 1 := mem_closedBall_self zero_le_one
  have hB10 : 0 ≤ B1 := (norm_nonneg _).trans (hB1 t₀ ht₀)
  have hB20 : 0 ≤ B2 := (norm_nonneg _).trans (hB2 t₀ ht₀)
  have hmemB : ∀ t ∈ ball t₀ (min δ₀ 1), c t ∈ ball (c t₀) ρ ∧ t ∈ closedBall t₀ 1 := fun t ht => by
    rw [mem_ball] at ht
    exact ⟨mem_ball.2 (hδc (lt_of_lt_of_le ht (min_le_left _ _))),
      mem_closedBall.2 (lt_of_lt_of_le ht (min_le_right _ _)).le⟩
  have hbound : ∀ ψ : Torus, ∀ t ∈ ball t₀ (min δ₀ 1),
      ‖curveF' DI c w c' w' t ψ‖ ≤ C1 * B1 * (C1 * B2) + M * (C2 * B1 * B2 + C1 * B3) := by
    intro ψ t ht
    obtain ⟨hct, ht1⟩ := hmemB t ht
    obtain ⟨hT, hD, hD2⟩ := hb (c t) hct ψ
    have ha := hB1 t ht1
    have hbb := hB2 t ht1
    have hw3 := hB3 t ht1
    have e1 : ‖fderiv ℝ (act DI ψ) (c t) (c' t)‖ ≤ C1 * B1 :=
      ((fderiv ℝ (act DI ψ) (c t)).le_opNorm _).trans (mul_le_mul hD ha (norm_nonneg _) hC1)
    have e2 : ‖fderiv ℝ (act DI ψ) (c t) (w t)‖ ≤ C1 * B2 :=
      ((fderiv ℝ (act DI ψ) (c t)).le_opNorm _).trans (mul_le_mul hD hbb (norm_nonneg _) hC1)
    have e3 : ‖fderiv ℝ (act DI ψ) (c t) (w' t)‖ ≤ C1 * B3 :=
      ((fderiv ℝ (act DI ψ) (c t)).le_opNorm _).trans (mul_le_mul hD hw3 (norm_nonneg _) hC1)
    have e4 : ‖fderiv ℝ (fderiv ℝ (act DI ψ)) (c t) (c' t) (w t)‖ ≤ C2 * B1 * B2 :=
      (ContinuousLinearMap.le_opNorm₂ _ _ _).trans
        (mul_le_mul (mul_le_mul hD2 ha (norm_nonneg _) hC2) hbb (norm_nonneg _) (mul_nonneg hC2 hB10))
    unfold curveF'
    rw [Real.norm_eq_abs]
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · exact (abs_alpha_le _ _).trans (mul_le_mul e1 e2 (norm_nonneg _) (mul_nonneg hC1 hB10))
    · exact (abs_alpha_le _ _).trans (mul_le_mul hT ((norm_add_le _ _).trans (add_le_add e4 e3))
        (norm_nonneg _) hM0)
  have hF'meas : AEStronglyMeasurable (curveF' DI c w c' w' t₀) productCircleHaar := by
    have he : curveF' DI c w c' w' t₀ = fun ψ => dInt DI (c t₀) (c' t₀) (w t₀) ψ +
        alpha (act DI ψ (c t₀)) (fderiv ℝ (act DI ψ) (c t₀) (w' t₀)) := funext fun ψ => curveF'_eq c w c' w' t₀ ψ
    rw [he]
    exact ((measurable_dInt H _ _ _).add (continuous_integrand H _ _).measurable).aestronglyMeasurable
  have key := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := productCircleHaar)
    (F := curveF DI c w) (F' := curveF' DI c w c' w') (x₀ := t₀)
    (bound := fun _ => C1 * B1 * (C1 * B2) + M * (C2 * B1 * B2 + C1 * B3))
    (ball_mem_nhds t₀ (lt_min hδ₀ one_pos))
    (Eventually.of_forall fun t => (continuous_integrand H (c t) (w t)).aestronglyMeasurable)
    (integrable_integrand H (c t₀) (w t₀)) hF'meas
    (Eventually.of_forall fun ψ t ht => hbound ψ t ht) (integrable_const _)
    (Eventually.of_forall fun ψ t _ => hasDerivAt_curveF H hc hw ψ t)
  have hint : ∫ ψ, curveF' DI c w c' w' t₀ ψ ∂productCircleHaar =
      dAlpha DI (c t₀) (c' t₀) (w t₀) + alphaBar DI (c t₀) (w' t₀) := by
    simp_rw [curveF'_eq c w c' w' t₀]
    exact integral_add (integrable_dInt H _ _ _) (integrable_integrand H _ _)
  exact key.2.congr_deriv hint

/-! ## 3. `dᾱ = ω` -/

theorem dInt_antisymm (H : PHyp I DI) (x a b : E) (ψ : Torus) :
    dInt DI x a b ψ - dInt DI x b a ψ = omega a b := by
  have hs := ProductTorusSymplectic.symplectic H.hyp (lift ψ) 1 x a b
  have hsym := fderiv2_flow_symm H.hyp H.contDiff2 (lift ψ) 1 x a b
  have hsw := alpha_sub_swap (fderiv ℝ (flow DI (lift ψ) 1) x a) (fderiv ℝ (flow DI (lift ψ) 1) x b)
  unfold dInt
  rw [act_def, hsym]
  linarith

theorem dAlpha_antisymm (H : PHyp I DI) (x a b : E) : dAlpha DI x a b - dAlpha DI x b a = omega a b := by
  unfold dAlpha
  rw [← integral_sub (integrable_dInt H x a b) (integrable_dInt H x b a)]
  simp_rw [dInt_antisymm H x a b]
  rw [integral_const, probReal_univ, one_smul]

/-- **`dᾱ = ω`**: `ᾱ` has directional derivatives `d/ds|₀ ᾱ_{u+sa}(b) = dAlpha u a b`, and
`dAlpha u a b − dAlpha u b a = ω(a, b)` for all Hilbert tangent pairs. -/
theorem d_alphaBar (H : PHyp I DI) (u a b : E) :
    HasDerivAt (fun s : ℝ => alphaBar DI (u + s • a) b) (dAlpha DI u a b) 0 ∧
      dAlpha DI u a b - dAlpha DI u b a = omega a b := by
  refine ⟨?_, dAlpha_antisymm H u a b⟩
  have := hasDerivAt_alphaBar_curve H (c := fun s => u + s • a) (w := fun _ => b) (c' := fun _ => a)
    (w' := fun _ => 0) (fun t => by simpa using ((hasDerivAt_id t).smul_const a).const_add u)
    (fun t => hasDerivAt_const t b) continuous_const continuous_const 0
  simpa [alphaBar_zero_right] using this

/-! ## 4. The Lie derivative along `X_{I_n}` and the Cartan identity -/

/-- `L_{X_{I_n}}ᾱ = 0` on a fixed tangent vector (differentiating `T^*ᾱ = ᾱ` along `φ_{I_n}^t`). -/
theorem lie_zero (H : PHyp I DI) (n : ℤ) (x a : E) :
    dAlpha DI x (X DI (e n) x) a + alphaBar DI x (fderiv ℝ (X DI (e n)) x a) = 0 := by
  have hinv : ∀ t, alphaBar DI (flow DI (e n) t x) (fderiv ℝ (flow DI (e n) t) x a) = alphaBar DI x a := by
    intro t
    have hfun : act DI (Pi.mulSingle n (Circle.exp t)) = flow DI (e n) t :=
      funext fun v => act_single H.hyp H.nonneg H.proper H.periodic n t v
    have := alphaBar_invariant H (Pi.mulSingle n (Circle.exp t)) x a
    rwa [hfun] at this
  have hXc := X_contDiff H.hyp.contDiff (e n)
  have hd := hasDerivAt_alphaBar_curve H (c := fun t => flow DI (e n) t x)
    (w := fun t => fderiv ℝ (flow DI (e n) t) x a) (c' := fun t => X DI (e n) (flow DI (e n) t x))
    (w' := fun t => fderiv ℝ (X DI (e n)) (flow DI (e n) t x) (fderiv ℝ (flow DI (e n) t) x a))
    (hasDerivAt_flow H.hyp (e n) x) (hasDerivAt_fderiv_flow_apply H.hyp (e n) x a)
    (hXc.continuous.comp (continuous_flow_time H.hyp (e n) x))
    (((hXc.continuous_fderiv one_ne_zero).comp (continuous_flow_time H.hyp (e n) x)).clm_apply
      ((continuous_fderiv_flow H.hyp (e n) x).clm_apply continuous_const)) 0
  have := hd.unique ((hasDerivAt_const (0 : ℝ) (alphaBar DI x a)).congr_of_eventuallyEq
    (Eventually.of_forall hinv))
  simpa [flow_zero H.hyp, fderiv_flow_zero H.hyp] using this

/-- **`ᾱ(X_{I_n}) = −I_n`** (the contraction identity, including its sign). -/
theorem alphaBar_Xn (H : PHyp I DI) (hmass : ∀ u, ∑' n, (I u : ℤ → ℝ) n = ‖u‖ ^ 2) (n : ℤ) (u : E) :
    alphaBar DI u (Xn DI n u) = -(I u : ℤ → ℝ) n := by
  have hXc := X_contDiff H.hyp.contDiff (e n)
  have hX : ∀ v, HasFDerivAt (X DI (e n)) (fderiv ℝ (X DI (e n)) v) v := fun v =>
    ((hXc.differentiable one_ne_zero) v).hasFDerivAt
  have hline : ∀ s : ℝ, HasDerivAt (fun r : ℝ => r • u) u s := fun s => by
    simpa using (hasDerivAt_id s).smul_const u
  have hg : ∀ s : ℝ, HasDerivAt (fun r : ℝ => alphaBar DI (r • u) (X DI (e n) (r • u)) + coord n (I (r • u))) 0 s := by
    intro s
    have h1 := hasDerivAt_alphaBar_curve H (c := fun r => r • u) (w := fun r => X DI (e n) (r • u))
      (c' := fun _ => u) (w' := fun r => fderiv ℝ (X DI (e n)) (r • u) u) hline
      (fun r => by
        have := (hX (r • u)).comp_hasDerivAt r (hline r)
        exact this) continuous_const
      (((hXc.continuous_fderiv one_ne_zero).comp (continuous_id.smul continuous_const)).clm_apply continuous_const) s
    have h2 : HasDerivAt (fun r : ℝ => coord n (I (r • u))) (coord n (DI (s • u) u)) s :=
      (coord n).hasFDerivAt.comp_hasDerivAt s ((H.hyp.hasFDerivAt (s • u)).comp_hasDerivAt s (hline s))
    refine (h1.add h2).congr_deriv ?_
    have hlie := lie_zero H n (s • u) u
    have hanti := dAlpha_antisymm H (s • u) u (X DI (e n) (s • u))
    have hom : omega u (X DI (e n) (s • u)) = -coord n (DI (s • u) u) := by
      rw [omega_antisymm, omega_X, pair_e]
    linarith
  have hc := is_const_of_deriv_eq_zero (fun s => (hg s).differentiableAt) (fun s => (hg s).deriv) 1 0
  -- the value at `0`
  have hI0 : (I 0 : ℤ → ℝ) n = 0 := by
    have hsum := hmass 0
    rw [norm_zero, zero_pow two_ne_zero] at hsum
    have hs : Summable (fun m => (I 0 : ℤ → ℝ) m) := (HilbertL1Compact.L1_summable (I 0)).of_norm
    have hle := hs.le_tsum n (fun j _ => H.nonneg 0 j)
    have := H.nonneg 0 n
    linarith
  have hmin : IsLocalMin (fun v => coord n (I v)) 0 := Eventually.of_forall fun v => by
    show coord n (I 0) ≤ coord n (I v)
    rw [coord_apply, coord_apply, hI0]
    exact H.nonneg v n
  have hd0 : (coord n).comp (DI 0) = 0 :=
    hmin.hasFDerivAt_eq_zero ((coord n).hasFDerivAt.comp 0 (H.hyp.hasFDerivAt 0))
  have hX0 : X DI (e n) 0 = 0 := by
    rw [X_e]
    unfold Xn Winv
    rw [hd0]
    simp
  simp only [one_smul, zero_smul, hX0, alphaBar_zero_right, coord_apply, hI0, add_zero] at hc
  rw [← X_e]
  linarith

end QuantumNLS.ProductTorusPrimitiveExterior

