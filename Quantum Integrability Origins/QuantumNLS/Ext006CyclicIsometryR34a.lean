import QuantumNLS.Ext006CreationGramR34a
import Mathlib.Analysis.Normed.Operator.Extend

/-! Isometry and continuous extension on the CLOSED CYCLIC SUBSPACES
generated by source creation words. This does not assert that either cyclic
subspace is the full physical Fock space. That surjectivity remains a gap. -/
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 4000000
open scoped InnerProductSpace
namespace QuantumNLS.Ext006CyclicIsometryR34a
open Occupation Ext006VacuumRecurrence Ext006BogoliubovAlg
open Ext006SmoothOperatorsR34a Ext006SourceCCRR34a Ext006CreationGramR34a
open Ext006KernelHilbertSchmidt
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
attribute [local instance] InnerProductSpace.complexToReal

/-- Actual finite linear combinations of source creation words. -/
def eval (b : HilbertBasis ℤ ℂ E) (S : E ≃L[ℝ] E) (v : D) :
    (List E →₀ ℂ) →ₗ[ℂ] Fock :=
  Finsupp.linearCombination ℂ (fun fs => (word b S fs v).1)

/-- Exact scalar Gram form for finite formal combinations. -/
def wickForm (c d : List E →₀ ℂ) : ℂ :=
  ∑ fs ∈ c.support, ∑ gs ∈ d.support, star (c fs)*d gs*wick fs gs

lemma inner_eval (b : HilbertBasis ℤ ℂ E) (S : E ≃L[ℝ] E)
    (hS : Ext006SymplecticKernel.Symplectic S.toContinuousLinearMap)
    (v : D) (hn : ‖v.1‖=1) (hv : ∀ f,sourceAnn b S f v=0)
    (c d : List E →₀ ℂ) : inner ℂ (eval b S v c) (eval b S v d)=wickForm c d := by
  simp only [eval,Finsupp.linearCombination_apply,Finsupp.sum,sum_inner,inner_sum,
    inner_smul_left,inner_smul_right,gram b S hS v hn hv,wickForm,starRingEnd_apply]
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro fs _
  apply Finset.sum_congr rfl
  intro gs _
  ring

/-- Completion of the actual source-word span, inside the existing Fock. -/
abbrev cyclic (b : HilbertBasis ℤ ℂ E) (S : E ≃L[ℝ] E) (v : D) : Submodule ℂ Fock :=
  (eval b S v).range.topologicalClosure

def intoCyclic (b : HilbertBasis ℤ ℂ E) (S : E ≃L[ℝ] E) (v : D) :
    (List E →₀ ℂ) →ₗ[ℂ] cyclic b S v :=
  (Submodule.inclusion (eval b S v).range.le_topologicalClosure).comp (eval b S v).rangeRestrict

omit [CompleteSpace E] in
lemma intoCyclic_dense (b : HilbertBasis ℤ ℂ E) (S : E ≃L[ℝ] E) (v : D) :
    DenseRange (intoCyclic b S v) := by
  have hi : DenseRange (Submodule.inclusion (eval b S v).range.le_topologicalClosure) := by
    change DenseRange (Set.inclusion (eval b S v).range.le_topologicalClosure)
    exact (denseRange_inclusion_iff _).mpr subset_rfl
  exact hi.comp (eval b S v).surjective_rangeRestrict.denseRange
    (continuous_inclusion (eval b S v).range.le_topologicalClosure)

/-- The Gram identity gives a norm-preserving map before extension. -/
lemma eval_norm_eq (b : HilbertBasis ℤ ℂ E) (S T : E ≃L[ℝ] E)
    (hS : Ext006SymplecticKernel.Symplectic S.toContinuousLinearMap)
    (hT : Ext006SymplecticKernel.Symplectic T.toContinuousLinearMap)
    (v w : D) (hvn : ‖v.1‖=1) (hwn : ‖w.1‖=1)
    (hv : ∀ f,sourceAnn b S f v=0) (hw : ∀ f,sourceAnn b T f w=0)
    (c : List E →₀ ℂ) : ‖eval b S v c‖=‖eval b T w c‖ := by
  have hi : inner ℂ (eval b S v c) (eval b S v c)=inner ℂ (eval b T w c) (eval b T w c) := by
    rw [inner_eval b S hS v hvn hv,inner_eval b T hT w hwn hw]
  rw [inner_self_eq_norm_sq_to_K,inner_self_eq_norm_sq_to_K] at hi
  have hr : ‖eval b S v c‖^2=‖eval b T w c‖^2 := by exact_mod_cast hi
  nlinarith [norm_nonneg (eval b S v c),norm_nonneg (eval b T w c)]

/-- Extension is a proved isometry equivalence of the two closed cyclic
subspaces. No density in the WHOLE Fock space is supplied or inferred. -/
def cyclicEquiv (b : HilbertBasis ℤ ℂ E) (S T : E ≃L[ℝ] E)
    (hS : Ext006SymplecticKernel.Symplectic S.toContinuousLinearMap)
    (hT : Ext006SymplecticKernel.Symplectic T.toContinuousLinearMap)
    (v w : D) (hvn : ‖v.1‖=1) (hwn : ‖w.1‖=1)
    (hv : ∀ f,sourceAnn b S f v=0) (hw : ∀ f,sourceAnn b T f w=0) :
    cyclic b S v ≃ₗᵢ[ℂ] cyclic b T w :=
  (LinearEquiv.refl ℂ (List E →₀ ℂ)).extendOfIsometry
    (intoCyclic b S v) (intoCyclic b T w) (intoCyclic_dense b S v) (intoCyclic_dense b T w)
    (fun c => (eval_norm_eq b S T hS hT v w hvn hwn hv hw c).symm)

lemma cyclicEquiv_eval (b : HilbertBasis ℤ ℂ E) (S T : E ≃L[ℝ] E)
    (hS : Ext006SymplecticKernel.Symplectic S.toContinuousLinearMap)
    (hT : Ext006SymplecticKernel.Symplectic T.toContinuousLinearMap)
    (v w : D) (hvn : ‖v.1‖=1) (hwn : ‖w.1‖=1)
    (hv : ∀ f,sourceAnn b S f v=0) (hw : ∀ f,sourceAnn b T f w=0)
    (c : List E →₀ ℂ) :
    cyclicEquiv b S T hS hT v w hvn hwn hv hw (intoCyclic b S v c)=intoCyclic b T w c := by
  exact LinearEquiv.extendOfIsometry_eq _ _ _ _ _ _ c

section Physical
variable {L : ℝ} [Fact (0 < L)]

/-- Both vacua and their Gram matrices are constructed from the original
source hypotheses. This yields a cyclic-space isometry, not yet UNITARY. -/
theorem source_cyclic_equiv
    (S T : PhysicalTensor.L2T L ≃L[ℝ] PhysicalTensor.L2T L)
    (hS : Ext006SymplecticKernel.Symplectic S.toContinuousLinearMap)
    (hT : Ext006SymplecticKernel.Symplectic T.toContinuousLinearMap)
    (hβS : TraceClass.hsSq (physicalBasis L) (beta (physicalBasis L) S) ≠ ⊤)
    (hβT : TraceClass.hsSq (physicalBasis L) (beta (physicalBasis L) T) ≠ ⊤) :
    ∃ v w : D, ∃ U : cyclic (physicalBasis L) S v ≃ₗᵢ[ℂ] cyclic (physicalBasis L) T w,
      ∀ c : List (PhysicalTensor.L2T L) →₀ ℂ,
        U (intoCyclic (physicalBasis L) S v c)=intoCyclic (physicalBasis L) T w c := by
  obtain ⟨v,hvn,hv⟩ := source_vacuum S hS hβS
  obtain ⟨w,hwn,hw⟩ := source_vacuum T hT hβT
  exact ⟨v,w,cyclicEquiv (physicalBasis L) S T hS hT v w hvn hwn hv hw,
    cyclicEquiv_eval (physicalBasis L) S T hS hT v w hvn hwn hv hw⟩

/-- A single original source map gives an isometry from the identity-map
cyclic space, without any extra Hilbert-Schmidt or covariance premise. -/
theorem source_cyclic_from_identity
    (S : PhysicalTensor.L2T L ≃L[ℝ] PhysicalTensor.L2T L)
    (hS : Ext006SymplecticKernel.Symplectic S.toContinuousLinearMap)
    (hβ : TraceClass.hsSq (physicalBasis L) (beta (physicalBasis L) S) ≠ ⊤) :
    ∃ v w : D, ∃ U :
      cyclic (physicalBasis L) (ContinuousLinearEquiv.refl ℝ (PhysicalTensor.L2T L)) v ≃ₗᵢ[ℂ]
        cyclic (physicalBasis L) S w,
      ∀ c : List (PhysicalTensor.L2T L) →₀ ℂ,
        U (intoCyclic (physicalBasis L) (ContinuousLinearEquiv.refl ℝ (PhysicalTensor.L2T L)) v c)=
          intoCyclic (physicalBasis L) S w c := by
  let I := ContinuousLinearEquiv.refl ℝ (PhysicalTensor.L2T L)
  have hi : Ext006SymplecticKernel.Symplectic I.toContinuousLinearMap := by
    intro f g
    rfl
  have hz : beta (physicalBasis L) I=0 := by
    apply ContinuousLinearMap.ext
    intro f
    change Ext006Blocks.antilinearPart (ContinuousLinearMap.id ℝ (PhysicalTensor.L2T L))
      (conjugation (physicalBasis L) f)=0
    simp only [Ext006Blocks.antilinearPart_apply,ContinuousLinearMap.id_apply,
      Ext006Blocks.J_apply,smul_smul,Complex.I_mul_I,neg_one_smul,add_neg_cancel,smul_zero]
  have hh : TraceClass.hsSq (physicalBasis L) (beta (physicalBasis L) I) ≠ ⊤ := by
    rw [hz, (TraceClass.hsSq_eq_zero_iff (physicalBasis L) 0).mpr rfl]
    exact ENNReal.zero_ne_top
  exact source_cyclic_equiv I S hi hS hh hβ

end Physical
end QuantumNLS.Ext006CyclicIsometryR34a

#print axioms QuantumNLS.Ext006CyclicIsometryR34a.inner_eval
#print axioms QuantumNLS.Ext006CyclicIsometryR34a.intoCyclic_dense
#print axioms QuantumNLS.Ext006CyclicIsometryR34a.cyclicEquiv
#print axioms QuantumNLS.Ext006CyclicIsometryR34a.cyclicEquiv_eval
#print axioms QuantumNLS.Ext006CyclicIsometryR34a.source_cyclic_from_identity
#print axioms QuantumNLS.Ext006CyclicIsometryR34a.source_cyclic_equiv

set_option maxHeartbeats 8000000 in
run_cmd do
  let env ← Lean.getEnv
  let mut pending : Array Lean.Name := #[]
  let mut roots : Nat := 0
  for (n, _) in env.constants.toList do
    if n.toString.startsWith "QuantumNLS.Ext006CyclicIsometryR34a." then
      pending := pending.push n
      roots := roots + 1
  let mut seen : Std.HashSet Lean.Name := {}
  while !pending.isEmpty do
    let n := pending.back!
    pending := pending.pop
    unless seen.contains n do
      seen := seen.insert n
      if let some ci := env.find? n then
        match ci with
        | .axiomInfo _ =>
          unless n == ``propext || n == ``Classical.choice || n == ``Quot.sound do
            throwError "Nonstandard dependency: {n}"
        | _ => pure ()
        pending := pending ++ ci.type.getUsedConstants
        if let some v := ci.value? (allowOpaque := true) then
          pending := pending ++ v.getUsedConstants
      else
        throwError "Missing dependency: {n}"
  Lean.logInfo m!"Round34a aggregate audit PASS: {roots} own constants; {seen.size} transitive constants; standard only."
