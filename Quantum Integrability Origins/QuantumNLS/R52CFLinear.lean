      _ ≤ W0 * Fb := mul_le_mul (hWu θ) (hFbd θ _) (norm_nonneg _) hW0
  have hscal : ∀ i, ∫ θ, (uθ κ P θ * gF Fe Fs P θ (Prop010ContourBindingR11.ev L hκ hN (zθ P θ) i)).re
