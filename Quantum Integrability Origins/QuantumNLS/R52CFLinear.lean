/-! ### Generic operator facts -/

section GenericOps
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {Θ : Type*} [MeasurableSpace Θ] {ι : Type*}

theorem reOp_eq_realPart (X : H →L[ℂ] H) : reOp X = Prop010ContourBindingR11.realPart X := by
  unfold reOp Prop010ContourBindingR11.realPart
  rw [one_div]

/-- **`C_{0,N}` on a basis of joint eigenvectors.** -/
theorem C0N_basis (b : HilbertBasis ι ℂ H) (ν : Measure Θ) [IsFiniteMeasure ν] (R : ℝ)
    (S : Θ → H →L[ℂ] H) (hS : ∀ θ, IsStarNormal (S θ)) (hR : ∀ θ, ‖S θ‖ ≤ R)
    (u : Θ → ℂ) (g : Θ → ℂ → ℂ) (hg : ∀ θ, Continuous (g θ)) (ev : Θ → ι → ℂ)
    (hev : ∀ θ i, S θ (b i) = ev θ i • b i)
    (hB : ∀ j, AEStronglyMeasurable
      (fun θ => quadHom (S θ) (hS θ) R (hR θ) (coordC (d := 2) (K := Kdisc R) j)) ν)
    (hF : AEStronglyMeasurable (fun θ => resKd (Kdisc R) (quadF (u θ) (g θ))) ν)
    {C : ℝ} (hC : ∀ θ, ‖resKd (Kdisc R) (quadF (u θ) (g θ))‖ ≤ C) (i : ι) :
    C0N ν (fun θ => quadHom (S θ) (hS θ) R (hR θ)) (fun θ => quadF (u θ) (g θ)) (b i) =
      (((∫ θ, (u θ * g θ (ev θ i)).re ∂ν : ℝ)) : ℂ) • b i := by
  have hint := integrable_apply_comp ν (fun θ => quadHom (S θ) (hS θ) R (hR θ)) hB _ hF hC
  unfold C0N
  rw [ContinuousLinearMap.integral_apply hint]
  have hpt : ∀ θ, quadHom (S θ) (hS θ) R (hR θ) (resKd (Kdisc R) (quadF (u θ) (g θ))) (b i) =
      (((u θ * g θ (ev θ i)).re : ℝ) : ℂ) • b i := by
    intro θ
    rw [quadHom_quadF _ _ _ _ (u θ) (hg θ), reOp_eq_realPart]
    have hX : ∀ i', (u θ • cfc (g θ) (S θ)) (b i') = (u θ * g θ (ev θ i')) • b i' := by
      intro i'
      rw [ContinuousLinearMap.smul_apply, Prop020Diag.cfc_eigen (hS θ) (hev θ i')
        (b.orthonormal.ne_zero i') (g θ) (hg θ).continuousOn, smul_smul]
    exact Prop010ContourBindingR11.realPart_basis b _ _ hX i
  simp_rw [hpt]
  rw [integral_smul_const, integral_complex_ofReal]

/-- Integrability of a continuous scalar multiple of a continuous operator family (generic `H`). -/
theorem integrable_smul_cont {Θ' : Type*} [TopologicalSpace Θ'] [CompactSpace Θ'] [MeasurableSpace Θ']
    [OpensMeasurableSpace Θ'] (ν : Measure Θ') [IsFiniteMeasure ν] (c : Θ' → ℂ) (hc : Continuous c)
    (S : Θ' → H →L[ℂ] H) (hS : Continuous S) : Integrable (fun θ => c θ • S θ) ν :=
  (hc.smul hS).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

/-- `e^{-i·1·T} = expG T`. -/
theorem evol_one (T : H →L[ℂ] H) : evol T 1 = R52CFEvol.expG T := by
  unfold evol R52CFEvol.expG
  congr 1
  simp only [neg_smul, one_smul]

/-- The scalar part of the generator is a phase. -/
theorem evol_scalar_add (c : ℝ) (X : H →L[ℂ] H) (x : H) :
    evol ((c : ℂ) • (1 : H →L[ℂ] H) + X) 1 x =
      Complex.exp (-I * c) • LinearTailPhysicalEvolution.evolution X 1 x := by
  let +nondep : NormedAlgebra ℚ (H →L[ℂ] H) := .restrictScalars ℚ ℂ _
  rw [evol_one]
  unfold R52CFEvol.expG LinearTailPhysicalEvolution.evolution
  have hc : Commute ((-I) • ((c : ℂ) • (1 : H →L[ℂ] H))) ((-I) • X) :=
    (((Commute.one_left X).smul_left (c : ℂ)).smul_left (-I)).smul_right (-I)
  rw [smul_add, NormedSpace.exp_add_of_commute hc, ContinuousLinearMap.mul_apply]
  have hx : ((-I) • ((c : ℂ) • (1 : H →L[ℂ] H))) (NormedSpace.exp ((-I) • X) x) =
      (-I * c) • NormedSpace.exp ((-I) • X) x := by
    rw [ContinuousLinearMap.smul_apply, ContinuousLinearMap.smul_apply, ContinuousLinearMap.one_apply,
      smul_smul]
  rw [R52CFEvol.exp_eigen _ _ _ hx, Complex.ofReal_one, one_smul]

end GenericOps

theorem rdN_add {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (k q : ℕ)
    (hk : k ≤ k + q) (ψ : TensorCarrier.HilbertTensorPower ℂ E (k + q)) :
    PhysicalTensor.reducedDensityN (k + q) k hk ψ = TensorCarrier.reducedDensityPower k q ψ := by
  unfold PhysicalTensor.reducedDensityN
  have key : ∀ (m : ℕ) (hm : m = q) (h : k + q = k + m),
      TensorCarrier.reducedDensityPower k m (PhysicalTensor.castHTP h ψ) =
        TensorCarrier.reducedDensityPower k q ψ := by
    intro m hm h
    subst hm
    rfl
  exact key _ (Nat.add_sub_cancel_left k q) _

/-! ### Discrete labels, rectangle sides, the slice bound -/

theorem continuous_lab {P Y Z ι : Type*} [TopologicalSpace P] [TopologicalSpace Y] [TopologicalSpace Z]
    [TopologicalSpace ι] [DiscreteTopology ι] (a : P → ι) (ha : Continuous a) (f : ι → Y → Z)
    (hf : ∀ n, Continuous (f n)) (b : P → Y) (hb : Continuous b) :
    Continuous (fun p => f (a p) (b p)) := by
  refine continuous_iff_continuousAt.2 fun p0 => ?_
  have hev : ∀ᶠ p in 𝓝 p0, a p = a p0 :=
    ha.continuousAt.eventually_mem ((isOpen_discrete {a p0}).mem_nhds (Set.mem_singleton _))
  exact ((hf (a p0)).comp hb).continuousAt.congr (hev.mono fun p hp => by
    show f (a p0) (b p) = f (a p) (b p)
    rw [hp])

theorem rect4_ω (a b h : ℝ) (c : ℂ) (j : Fin 4) (z : ℂ) : (R52CFPieces.rect4 a b h c j).ω z = c := by
  fin_cases j <;> rfl

theorem norm_corner_add (x y : ℝ) : ‖(x : ℂ) + y * I‖ ≤ |x| + |y| := by
  refine (norm_add_le _ _).trans (le_of_eq ?_)
  rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
    Real.norm_eq_abs]

theorem norm_corner_sub (x y : ℝ) : ‖(x : ℂ) - y * I‖ ≤ |x| + |y| := by
  refine (norm_sub_le _ _).trans (le_of_eq ?_)
  rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
    Real.norm_eq_abs]

theorem rect4_γ'_le (a b h : ℝ) (c : ℂ) (j : Fin 4) (τ : ℝ) :
    ‖(R52CFPieces.rect4 a b h c j).γ' τ‖ ≤ 2 * (|a| + |b| + |h|) := by
  have ha := abs_nonneg a
  have hb := abs_nonneg b
  have hh := abs_nonneg h
  fin_cases j
  · show ‖((b : ℂ) - h * I) - ((a : ℂ) - h * I)‖ ≤ _
    have := (norm_sub_le ((b : ℂ) - h * I) ((a : ℂ) - h * I)).trans
      (add_le_add (norm_corner_sub b h) (norm_corner_sub a h))
    linarith
  · show ‖((b : ℂ) + h * I) - ((b : ℂ) - h * I)‖ ≤ _
    have := (norm_sub_le ((b : ℂ) + h * I) ((b : ℂ) - h * I)).trans
      (add_le_add (norm_corner_add b h) (norm_corner_sub b h))
    linarith
  · show ‖((a : ℂ) + h * I) - ((b : ℂ) + h * I)‖ ≤ _
    have := (norm_sub_le ((a : ℂ) + h * I) ((b : ℂ) + h * I)).trans
      (add_le_add (norm_corner_add a h) (norm_corner_add b h))
    linarith
  · show ‖((a : ℂ) - h * I) - ((a : ℂ) + h * I)‖ ≤ _
    have := (norm_sub_le ((a : ℂ) - h * I) ((a : ℂ) + h * I)).trans
      (add_le_add (norm_corner_sub a h) (norm_corner_add a h))
    linarith

/-- The iterated derivatives of a slice `w ↦ F(z, w)` are bounded by those of `F`. -/
theorem norm_iteratedFDeriv_slice (Fe : ℂ × ℂ → ℂ) (hF : ContDiff ℝ ∞ Fe) (z : ℂ) (i : ℕ) (w : ℂ) :
    ‖iteratedFDeriv ℝ i (fun w => Fe (z, w)) w‖ ≤ ‖iteratedFDeriv ℝ i Fe (z, w)‖ := by
  let J : ℂ →L[ℝ] ℂ × ℂ := ContinuousLinearMap.inr ℝ ℂ ℂ
  have hJ : ‖J‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun y => ?_)
    show ‖((0 : ℂ), y)‖ ≤ 1 * ‖y‖
    rw [one_mul, Prod.norm_def]
    simp
  have hfun : (fun w => Fe (z, w)) = (fun p : ℂ × ℂ => Fe ((z, 0) + p)) ∘ J := by
    funext y
    simp [J]
  have hG : ContDiff ℝ ∞ (fun p : ℂ × ℂ => Fe ((z, 0) + p)) := hF.comp (contDiff_const.add contDiff_id)
  rw [hfun, J.iteratedFDeriv_comp_right hG w (i := i) (by exact_mod_cast le_top), iteratedFDeriv_comp_add_left]
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans ?_
  have hp : ∏ _j : Fin i, ‖J‖ ≤ 1 := Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => hJ)
  have he : (z, (0 : ℂ)) + J w = (z, w) := by simp [J]
  rw [he]
  calc ‖iteratedFDeriv ℝ i Fe (z, w)‖ * ∏ _j : Fin i, ‖J‖ ≤ ‖iteratedFDeriv ℝ i Fe (z, w)‖ * 1 :=
        mul_le_mul_of_nonneg_left hp (norm_nonneg _)
    _ = ‖iteratedFDeriv ℝ i Fe (z, w)‖ := mul_one _

/-- The weighted contour integral over the concatenated family with a label-dependent integrand. -/
theorem integral_rectFam_lab (κ : ℝ) {m : ℕ} (a b h : Fin m → ℝ) (c : Fin m → ℂ) (f : Fin m → ℂ → ℂ)
    (hcont : Continuous (fun θ : ThetaSpace (m * 4) => uθ κ (R52CFPieces.rectFam a b h c) θ *
      f (finProdFinEquiv.symm θ.1).1 (zθ (R52CFPieces.rectFam a b h c) θ))) :
    ∫ θ, uθ κ (R52CFPieces.rectFam a b h c) θ *
        f (finProdFinEquiv.symm θ.1).1 (zθ (R52CFPieces.rectFam a b h c) θ) ∂(nu (m * 4)) =
      ∑ i : Fin m, -((((2 * Real.pi * κ)⁻¹ : ℝ) : ℂ)) *
        (c i * LabelExactPeriod.rectIntegral (f i) (a i) (b i) (h i)) := by
  rw [R52CFPieces.integral_nu hcont]
  rw [← (finProdFinEquiv : Fin m × Fin 4 ≃ Fin (m * 4)).sum_comp, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [← R52CFPieces.sum_rect4 (a i) (b i) (h i) (c i) (f i), Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  set P := R52CFPieces.rect4 (a i) (b i) (h i) (c i) j with hPdef
  have hP : R52CFPieces.rectFam a b h c (finProdFinEquiv (i, j)) = P := by
    simp [R52CFPieces.rectFam, hPdef]
  have hi : (finProdFinEquiv.symm (finProdFinEquiv (i, j))).1 = i := by simp
  have he : (∫ τ : unitInterval, uθ κ (R52CFPieces.rectFam a b h c) (finProdFinEquiv (i, j), τ) *
      f (finProdFinEquiv.symm (finProdFinEquiv (i, j), τ).1).1
        (zθ (R52CFPieces.rectFam a b h c) (finProdFinEquiv (i, j), τ))) =
      ∫ τ : unitInterval, (fun t : ℝ => -((((2 * Real.pi * κ)⁻¹ : ℝ) : ℂ)) * P.ω (P.γ t) * P.γ' t *
        f i (P.γ t)) τ := by
    simp only [uθ, zθ, hP, hi]
  have h2 := R52CFPieces.integral_I (fun t : ℝ => -((((2 * Real.pi * κ)⁻¹ : ℝ) : ℂ)) * P.ω (P.γ t) *
    P.γ' t * f i (P.γ t))
  rw [he]
  refine h2.trans ?_
  rw [← intervalIntegral.integral_const_mul]
  congr 1
  funext t
  ring

/-! ### The concatenated family -/

section Family
open QuantumNLS.ProductTorusGenerator (Linf)
open QuantumNLS.R52CFClassical (fam lab)

/-- The label of a parameter point. -/
def labθ (Fs : Finset ℤ) (θ : ThetaSpace (Fs.card * 4)) : ℤ := lab Fs (finProdFinEquiv.symm θ.1).1

theorem labθ_mem (Fs : Finset ℤ) (θ : ThetaSpace (Fs.card * 4)) : labθ Fs θ ∈ Fs :=
  R52CFClassical.lab_mem Fs _

theorem continuous_labθ (Fs : Finset ℤ) : Continuous (labθ Fs) :=
  (continuous_of_discreteTopology (f := fun k : Fin (Fs.card * 4) => lab Fs (finProdFinEquiv.symm k).1)).comp
    continuous_fst

/-- `g_θ = F_{n(θ)}(z_θ, ·)`. -/
def gF (Fe : ℤ → ℂ × ℂ → ℂ) (Fs : Finset ℤ) (P : Fin (Fs.card * 4) → Piece) (θ : ThetaSpace (Fs.card * 4))
    (w : ℂ) : ℂ := Fe (labθ Fs θ) (zθ P θ, w)

theorem norm_uθ_fam_le (κ : ℝ) (Fs : Finset ℤ) (t : Linf) (A B : ℤ → ℝ) (h : ℝ)
    (θ : ThetaSpace (Fs.card * 4)) :
    ‖uθ κ (fam Fs t A B h) θ‖ ≤ |(2 * Real.pi * κ)⁻¹| * |t (labθ Fs θ)| *
      (2 * (|A (labθ Fs θ)| + |B (labθ Fs θ)| + |h|)) := by
  have hP : fam Fs t A B h θ.1 = R52CFPieces.rect4 (A (labθ Fs θ)) (B (labθ Fs θ)) h
      ((t (labθ Fs θ) : ℝ) : ℂ) (finProdFinEquiv.symm θ.1).2 := rfl
  unfold uθ
  rw [hP, rect4_ω, norm_mul, norm_mul, norm_neg, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
    Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_left (rect4_γ'_le _ _ _ _ _ _) (by positivity)

/-- The uniform weight bound on the time box. -/
def Wu (κ : ℝ) (Fs : Finset ℤ) (T A B : ℤ → ℝ) (h : ℝ) : ℝ :=
  |(2 * Real.pi * κ)⁻¹| * (∑ n ∈ Fs, |T n|) * (2 * ∑ n ∈ Fs, (|A n| + |B n| + |h|))

theorem Wu_nonneg (κ : ℝ) (Fs : Finset ℤ) (T A B : ℤ → ℝ) (h : ℝ) : 0 ≤ Wu κ Fs T A B h := by
  unfold Wu
  have h1 : 0 ≤ ∑ n ∈ Fs, |T n| := Finset.sum_nonneg fun n _ => abs_nonneg _
  have h2 : 0 ≤ ∑ n ∈ Fs, (|A n| + |B n| + |h|) := Finset.sum_nonneg fun n _ => by positivity
  positivity

theorem norm_uθ_le_Wu (κ : ℝ) (Fs : Finset ℤ) (t : Linf) (T A B : ℤ → ℝ) (h : ℝ)
    (ht : ∀ n ∈ Fs, |t n| ≤ T n) (θ : ThetaSpace (Fs.card * 4)) :
    ‖uθ κ (fam Fs t A B h) θ‖ ≤ Wu κ Fs T A B h := by
  refine (norm_uθ_fam_le κ Fs t A B h θ).trans ?_
  have hm := labθ_mem Fs θ
  have h1 : |t (labθ Fs θ)| ≤ ∑ n ∈ Fs, |T n| :=
    (ht _ hm).trans ((le_abs_self _).trans
      (Finset.single_le_sum (f := fun n => |T n|) (fun n _ => abs_nonneg _) hm))
  have h2 : |A (labθ Fs θ)| + |B (labθ Fs θ)| + |h| ≤ ∑ n ∈ Fs, (|A n| + |B n| + |h|) :=
    Finset.single_le_sum (f := fun n => |A n| + |B n| + |h|) (fun n _ => by positivity) hm
  have h0 : 0 ≤ |(2 * Real.pi * κ)⁻¹| := abs_nonneg _
  have h3 : 0 ≤ ∑ n ∈ Fs, |T n| := Finset.sum_nonneg fun n _ => abs_nonneg _
  unfold Wu
  exact mul_le_mul (mul_le_mul_of_nonneg_left h1 h0) (by linarith) (by positivity) (mul_nonneg h0 h3)

end Family

/-! ### The PROP-026 application -/

section Physical
open PhysicalTensor (L2T)
open RootCauchyFullBracketR8 (G)
open RootCauchyJointR9 (Regular)
open PeriodReconstruction (Gam)
open PeriodReconstructionCore (Df)
open QuantumNLS.ProductTorusGenerator (Linf)
open QuantumNLS.R52CFClassical (fam wt lab)
open QuantumNLS.R52CFKernels (kerA physK)
open QuantumNLS.Prop010ContourBindingR11 (C0 c0 Extension)
open TensorCarrier

variable {L κ : ℝ} [Fact (0 < L)]

set_option maxHeartbeats 16000000 in
/-- **Stage 12 headline.**  The frozen leading contour evolution and the PROP-001 evolution of the frozen-contour
kernels have uniformly close `k`-particle marginals on product vectors. -/
theorem linear_bound (hκ : 0 < κ) (Fs : Finset ℤ) (T A B : ℤ → ℝ) (hAB : ∀ n, A n ≤ B n)
    (Fe : ℤ → ℂ × ℂ → ℂ) (hF : ∀ n, ContDiff ℝ ∞ (Fe n)) (hFc : ∀ n, HasCompactSupport (Fe n))
    (S : ℝ) (k : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (q : ℕ) (hN : 0 < k + q) (v : L2T L), ‖v‖ = 1 →
      (∀ n ∈ Fs, ∀ z ∈ Gam (A n) (B n) 1, Regular κ (v, z) ∧
        ‖NormalizedTransfer.productSymbol L κ v z‖ ≤ S ∧
        HasDerivAt (fun w => Fe n (z, w)) (Df L κ (fun z => G hκ z v) z)⁻¹
          (NormalizedTransfer.productSymbol L κ v z)) →
      ∀ t : Linf, (∀ n ∈ Fs, |t n| ≤ T n) →
      TraceClass.traceNorm
        (PhysicalTensor.reducedDensityN (k + q) k (Nat.le_add_right k q)
            ((R52CFEvol.frozenEvol L hκ hN Fs t (fun n => Extension.ofSmooth (Fe n) (hF n) (hFc n)) A B 1
              (HighMomentsOps.wvec (k + q) v) : BetheCoefficientTransform.HN L (k + q)) :
              HilbertTensorPower ℂ (L2T L) (k + q)) -
          PhysicalTensor.reducedDensityN (k + q) k (Nat.le_add_right k q)
            ((Prop001.quantumEvolution (kerA (nu (Fs.card * 4)) κ (wt κ Fs t A B 1 (Df L κ (fun z => G hκ z v)))
                (physK (L := L) (zθ (fam Fs t A B 1)))) (k + q) 1 (HighMomentsOps.wvec (k + q) v) :
                SymSector ℂ (L2T L) (k + q)) : HilbertTensorPower ℂ (L2T L) (k + q))) ≤
        ENNReal.ofReal (C * Real.sqrt (HighMomentsTransfer.Cunif L κ 1 1 / (k + q : ℕ))) := by
  classical
  obtain ⟨mder, K0, hm, hK0, hmain⟩ := prop026_traceNorm_physical
  set Rs : ℝ := max (Rbd L κ 1) S with hRs
  obtain ⟨K1, hK1, hK1b⟩ := hmain (U := Set.univ)
    (Q := Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) Rs)
    isOpen_univ (isCompact_closedBall _ _) (Set.subset_univ _)
  -- derivative bounds of the extensions
  have hbd : ∀ n i, ∃ Cb : ℝ, ∀ p, ‖iteratedFDeriv ℝ i (Fe n) p‖ ≤ Cb := fun n i =>
    ((hF n).continuous_iteratedFDeriv (m := i) (by exact_mod_cast le_top)).bounded_above_of_compact_support
      ((hFc n).iteratedFDeriv i)
  choose Cb hCb using hbd
  set M0 : ℝ := ∑ n ∈ Fs, ∑ i ∈ Finset.range (mder + 1), max 0 (Cb n i) with hM0def
  have hM0 : 0 ≤ M0 := Finset.sum_nonneg fun n _ => Finset.sum_nonneg fun i _ => le_max_left _ _
