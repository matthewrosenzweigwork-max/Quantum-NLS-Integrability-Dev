  have hCres : ∀ θ, ‖resKd (Kdisc (Rbd L κ 1)) (quadF (uθ κ P θ) (gF Fe Fs P θ))‖ ≤ W0 * Fb := by
    intro θ
    refine (ContinuousMap.norm_le _ (mul_nonneg hW0 hFb0)).2 (fun x => ?_)
    rw [resKd_apply (continuous_quadF (uθ κ P θ) (hgc θ)).continuousOn x, Complex.norm_real, Real.norm_eq_abs]
