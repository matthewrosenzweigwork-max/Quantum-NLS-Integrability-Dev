  have hWu : ∀ θ, ‖uθ κ P θ‖ ≤ W0 := fun θ => norm_uθ_le_Wu κ Fs t T A B 1 ht θ
  have hFb : ∀ θ, ∀ i ≤ mder, ∀ x ∈ (Set.univ : Set (EuclideanSpace ℝ (Fin 2))),
