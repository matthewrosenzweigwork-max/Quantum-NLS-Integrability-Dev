  have hsδ : ∀ θ, ‖(NormalizedTransfer.normalizedTransfer L κ (k + q) (zθ P θ) -
      NormalizedTransfer.productSymbol L κ v (zθ P θ) •
        (1 : SymSector ℂ (L2T L) (k + q) →L[ℂ] SymSector ℂ (L2T L) (k + q))) (HighMomentsOps.wvec (k + q) v)‖ ≤
      Real.sqrt (HighMomentsTransfer.Cunif L κ 1 1 / (k + q : ℕ)) := fun θ =>
    R52CFDev.transfer_dev L hκ hN v hv zero_le_one (zθ P θ)
      (by have := hzh θ; rw [abs_le] at this; linarith)
  set δN : ℝ := Real.sqrt (HighMomentsTransfer.Cunif L κ 1 1 / (k + q : ℕ)) with hδN
  have key := hK1b (nu (Fs.card * 4)) L κ hκ k q hN1 (zθ P) hz 1 hzh hKQ
    (fun θ => NormalizedTransfer.productSymbol L κ v (zθ P θ)) hsQ
    (fun θ => quadF (uθ κ P θ) (gF Fe Fs P θ)) (fun θ => (hFs θ).contDiffOn) hFm hdF
    (HighMomentsOps.wvec (k + q) v) (HighMomentsFinal.norm_wvec v hv (k + q))
    (fun _ => δN) (fun _ => Real.sqrt_nonneg _) hsδ
    (fun _ => W0) (fun _ => hW0) (integrable_const _) (integrable_const _) hM0 hFb
  beta_reduce at key
  -- identification of `C_{0,N}`
  have hS : ∀ θ, IsStarNormal (NormalizedTransfer.normalizedTransfer L κ (k + q) (zθ P θ)) :=
    fun θ => SN_isStarNormal L κ hκ (k + q) hN1 (zθ P θ)
  have hR : ∀ θ, ‖NormalizedTransfer.normalizedTransfer L κ (k + q) (zθ P θ)‖ ≤ Rbd L κ 1 :=
    fun θ => norm_normalizedTransfer_le L κ (k + q) (zθ P θ) 1 (hzh θ)
  have hBm : ∀ j, AEStronglyMeasurable (fun θ => quadHom (NormalizedTransfer.normalizedTransfer L κ (k + q)
      (zθ P θ)) (hS θ) (Rbd L κ 1) (hR θ) (coordC (d := 2) (K := Kdisc (Rbd L κ 1)) j)) (nu (Fs.card * 4)) :=
    fun j => PhiFam_hB hκ hN1 (nu (Fs.card * 4)) (zθ P) hz (Rbd L κ 1) hR j
  have hFbd : ∀ θ w, ‖gF Fe Fs P θ w‖ ≤ Fb := fun θ w => by
    have h1 := (Extension.ofSmooth (Fe (labθ Fs θ)) (hF _) (hFc _)).value_bound (zθ P θ, w)
    have h2 : (Extension.ofSmooth (Fe (labθ Fs θ)) (hF _) (hFc _)).bound ≤ Fb :=
      Finset.single_le_sum (f := fun n => (Extension.ofSmooth (Fe n) (hF n) (hFc n)).bound)
        (fun n _ => (Extension.ofSmooth (Fe n) (hF n) (hFc n)).bound_nonneg) (labθ_mem Fs θ)
