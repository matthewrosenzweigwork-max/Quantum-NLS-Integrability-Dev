set_option maxHeartbeats 16000000 in
/-- **Stage 13 headline: the local propagation estimate at a unit rough center.** -/
theorem local_rate (hκ : 0 < κ) (hG : GlobalStatement L κ hκ d Φl Ψl) (u : L2T L) (hu : ‖u‖ = 1)
    (Fs : Finset ℤ) (T : ℤ → ℝ) (k : ℕ) :
    ∃ U ∈ 𝓝 u, ∃ ρ : ℕ → ℝ, Tendsto ρ atTop (𝓝 0) ∧ ∃ N₀ : ℕ,
      ∀ (N : ℕ) (hN : 0 < N) (hk : k ≤ N), N₀ ≤ N → ∀ v ∈ U, ‖v‖ = 1 →
      ∀ t : Linf, (∀ n ∉ Fs, t n = 0) → (∀ n ∈ Fs, |t n| ≤ T n) →
      traceNorm (PhysicalTensor.reducedDensityN N k hk
          (countEvol L hκ hN Fs t (HighMomentsOps.wvec N v) : HilbertTensorPower ℂ (L2T L) N) -
        Prop001.coherentProjector k (Tθ (L := L) hκ t v)) ≤ ENNReal.ofReal (ρ N) := by
  classical
  have hL : 0 < L := Fact.out
  -- the accepted PROP-010 extensions of the center, rectangle height `1`
  have hex := fun n => Prop010SingleContourR17.condensate_reconstruction hκ u hu n (h := 1) one_pos
  choose Fe He hF hFc hH hHc r hR using hex
  have hr : ∀ n, 0 < r n := fun n => (hR n).1
  have hAB : ∀ n, RootScalarPeriodR8.cut hκ u (n-1) ≤ RootScalarPeriodR8.cut hκ u n :=
    fun n => (R52CFDeriv.cut_lt hκ u n).le
  -- stage 13a: the count evolution against the frozen leading evolution
  obtain ⟨U1, hU1, ρ, hρ, N₁, hevol⟩ := evol_near_r L hκ u hu Fs T one_pos r hr
    (fun n => Extension.ofSmooth (Fe n) (hF n) (hFc n)) (fun n => Extension.ofSmooth (He n) (hH n) (hHc n))
    (fun n => (hR n).2.1) (fun n => (hR n).2.2.1)
  -- stage 12a: the denominators near the center
  obtain ⟨m, S, hm, hden⟩ := R52CFDenom.local_denominators hκ u Fs one_pos r hr Fe (fun n => (hR n).2.1)
  obtain ⟨U2, hU2, hU2P⟩ := hden.exists_mem
  -- stage 1: the fixed-rectangle action differential
  choose W hWo hWu hWv using fun n => R52CFDeriv.fixed_rectangle_neighborhood hκ u n (h := 1) one_pos
  -- stage 12b: the linearization
  obtain ⟨C, hC0, hlin⟩ := R52CFLinear.linear_bound (L := L) hκ Fs T
    (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) hAB Fe hF hFc
    (∑ n ∈ Fs, |S n|) k
  -- stage 5: one budget
  set Wb : ℝ := R52CFLinear.Wu κ Fs T (fun n => RootScalarPeriodR8.cut hκ u (n-1))
    (fun n => RootScalarPeriodR8.cut hκ u n) 1 * ∑ n ∈ Fs, (m n)⁻¹ with hWb
  have hWb0 : 0 ≤ Wb := mul_nonneg (R52CFLinear.Wu_nonneg _ _ _ _ _ _)
    (Finset.sum_nonneg fun n _ => (inv_pos.2 (hm n)).le)
  set Bd := R52CFBudget.budget L κ 1 ((MPContour.nu (Fs.card * 4)).real Set.univ) Wb hL
    measureReal_nonneg hWb0 with hBd
  -- the rate
  have hlim1 : Tendsto (fun N : ℕ => 2 * max 0 (ρ N)) atTop (𝓝 0) := by
    have h := ((tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0)).max hρ).const_mul 2
    simpa using h
  have hlim2 : Tendsto (fun N : ℕ => C * Real.sqrt (HighMomentsTransfer.Cunif L κ 1 1 / N)) atTop (𝓝 0) := by
    have h1 : Tendsto (fun N : ℕ => (N : ℝ)⁻¹) atTop (𝓝 0) :=
      tendsto_inv_atTop_zero.comp tendsto_natCast_atTop_atTop
    have h2 : Tendsto (fun N : ℕ => HighMomentsTransfer.Cunif L κ 1 1 / (N : ℝ)) atTop (𝓝 0) := by
      simpa [div_eq_mul_inv] using h1.const_mul (HighMomentsTransfer.Cunif L κ 1 1)
    have h3 := (Real.continuous_sqrt.tendsto 0).comp h2
    rw [Real.sqrt_zero] at h3
    simpa using h3.const_mul C
  have hlim3 : Tendsto (fun N : ℕ => Bd.rate k N 1) atTop (𝓝 0) := by
    unfold Prop001RtwentyAssembly.NormBudget.rate
    have hpos := Prop001.rateExponent_positive Bd.tau 1
    have h1 := (tendsto_rpow_neg_atTop hpos).comp tendsto_natCast_atTop_atTop
    simpa using h1.const_mul (Bd.D * Real.exp (Bd.a * k))
  refine ⟨U1 ∩ (U2 ∩ ⋂ n ∈ Fs, W n),
    inter_mem hU1 (inter_mem hU2 ((Filter.biInter_finset_mem Fs).mpr fun n _ => (hWo n).mem_nhds (hWu n))),
    fun N => 2 * max 0 (ρ N) + C * Real.sqrt (HighMomentsTransfer.Cunif L κ 1 1 / N) + Bd.rate k N 1,
    by simpa using (hlim1.add hlim2).add hlim3, N₁, ?_⟩
  intro N hN hk hNN v hv hv1 t ht0 ht
  have hvU1 : v ∈ U1 := hv.1
  have hdenv := hU2P v hv.2.1
  have hWn : ∀ n ∈ Fs, v ∈ W n := fun n hn => Set.mem_iInter₂.mp hv.2.2 n hn
  obtain ⟨q, rfl⟩ : ∃ q, N = k + q := ⟨N - k, (Nat.add_sub_cancel' hk).symm⟩
  -- (1) count evolution against the frozen evolution
  obtain ⟨c, hc, hce⟩ := hevol (k + q) hN hNN v hvU1 hv1 t ht
  have hn1 : ‖countEvol L hκ hN Fs t (HighMomentsOps.wvec (k + q) v)‖ = 1 :=
    (norm_countEvol L hκ hN Fs t _).trans (HighMomentsFinal.norm_wvec v hv1 (k + q))
  have hn2 : ‖c • frozenEvol L hκ hN Fs t (fun n => Extension.ofSmooth (Fe n) (hF n) (hFc n))
      (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) 1
      (HighMomentsOps.wvec (k + q) v)‖ = 1 := by
    rw [norm_smul, hc, one_mul, norm_frozenEvol L hκ hN Fs t _ _ _ hAB zero_le_one,
      HighMomentsFinal.norm_wvec v hv1 (k + q)]
  have e1 := MarginalPureState.traceNorm_reducedDensityN_sub_le (k + q) k hk
    (countEvol L hκ hN Fs t (HighMomentsOps.wvec (k + q) v) : HilbertTensorPower ℂ (L2T L) (k + q))
    ((c • frozenEvol L hκ hN Fs t (fun n => Extension.ofSmooth (Fe n) (hF n) (hFc n))
      (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) 1
      (HighMomentsOps.wvec (k + q) v) : BetheCoefficientTransform.HN L (k + q)) :
        HilbertTensorPower ℂ (L2T L) (k + q))
  rw [← Submodule.coe_sub, Submodule.norm_coe, Submodule.norm_coe, Submodule.norm_coe, hn1, hn2,
    Submodule.coe_smul, R52CFEvol.reducedDensityN_phase _ _ _ _ hc] at e1
  have e1' : traceNorm (PhysicalTensor.reducedDensityN (k + q) k hk
      (countEvol L hκ hN Fs t (HighMomentsOps.wvec (k + q) v) : HilbertTensorPower ℂ (L2T L) (k + q)) -
      PhysicalTensor.reducedDensityN (k + q) k hk
      (frozenEvol L hκ hN Fs t (fun n => Extension.ofSmooth (Fe n) (hF n) (hFc n))
        (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) 1
        (HighMomentsOps.wvec (k + q) v) : HilbertTensorPower ℂ (L2T L) (k + q))) ≤
      ENNReal.ofReal (2 * max 0 (ρ (k + q))) := by
    refine e1.trans (ENNReal.ofReal_le_ofReal ?_)
    have := hce.trans (le_max_right 0 (ρ (k + q)))
    nlinarith [norm_nonneg (countEvol L hκ hN Fs t (HighMomentsOps.wvec (k + q) v) -
      c • frozenEvol L hκ hN Fs t (fun n => Extension.ofSmooth (Fe n) (hF n) (hFc n))
        (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) 1
        (HighMomentsOps.wvec (k + q) v))]
  -- (2) the linearization
  have hSle : ∀ n ∈ Fs, S n ≤ ∑ n ∈ Fs, |S n| := fun n hn =>
    (le_abs_self _).trans (Finset.single_le_sum (f := fun n => |S n|) (fun n _ => abs_nonneg _) hn)
  have e2 := hlin q hN v hv1 (fun n hn z hz => ⟨(hdenv n hn z hz).1,
    ((hdenv n hn z hz).2.2.1).trans (hSle n hn), (hdenv n hn z hz).2.2.2⟩) t ht
  -- (3) the bounded-interaction propagation and the classical identification
  have hzh : ∀ θ, |(MPContour.zθ (fam Fs t (fun n => RootScalarPeriodR8.cut hκ u (n-1))
      (fun n => RootScalarPeriodR8.cut hκ u n) 1) θ).im| ≤ 1 := fun θ =>
    R52CFCoh.zθ_im_le (fun i => RootScalarPeriodR8.cut hκ u (lab Fs i - 1))
      (fun i => RootScalarPeriodR8.cut hκ u (lab Fs i)) (fun _ => 1)
      (fun i => ((t (lab Fs i) : ℝ) : ℂ)) (fun i => hAB _) (fun _ => zero_le_one) (fun _ => le_rfl) θ
  have hgW : ∀ θ, ‖wt κ Fs t (fun n => RootScalarPeriodR8.cut hκ u (n-1))
      (fun n => RootScalarPeriodR8.cut hκ u n) 1 (Df L κ (fun z => G hκ z v)) θ‖ ≤ Wb := by
    intro θ
    have hmemθ := R52CFCoh.zθ_mem (fun i => RootScalarPeriodR8.cut hκ u (lab Fs i - 1))
      (fun i => RootScalarPeriodR8.cut hκ u (lab Fs i)) (fun _ => 1)
      (fun i => ((t (lab Fs i) : ℝ) : ℂ)) (fun i => hAB _) (fun _ => zero_le_one) θ
    have hℓ := R52CFLinear.labθ_mem Fs θ
    have hDl := (hdenv _ hℓ _ hmemθ).2.1
    have hu' := R52CFLinear.norm_uθ_le_Wu κ Fs t T (fun n => RootScalarPeriodR8.cut hκ u (n-1))
      (fun n => RootScalarPeriodR8.cut hκ u n) 1 ht θ
    have hinv := inv_anti₀ (hm _) hDl
    have hsum : (m (R52CFLinear.labθ Fs θ))⁻¹ ≤ ∑ n ∈ Fs, (m n)⁻¹ :=
      Finset.single_le_sum (f := fun n => (m n)⁻¹) (fun n _ => (inv_pos.2 (hm n)).le) hℓ
    unfold R52CFClassical.wt
    rw [norm_mul, norm_inv]
    exact mul_le_mul hu' (hinv.trans hsum) (inv_nonneg.2 (norm_nonneg _)) (R52CFLinear.Wu_nonneg _ _ _ _ _ _)
  have hD : ∀ n ∈ Fs, ContinuousOn (fun z => (Df L κ (fun z => G hκ z v) z)⁻¹)
      (Gam ((fun n => RootScalarPeriodR8.cut hκ u (n-1)) n) ((fun n => RootScalarPeriodR8.cut hκ u n) n) 1) :=
    fun n hn => R52CFDenom.continuousOn_Dinv hκ v (fun z hz => (hdenv n hn z hz).1)
  have hdiff : ∀ n ∈ Fs, ∀ k' : L2T L, fderiv ℝ (mass hκ n) v k' = -(2 * Real.pi * κ)⁻¹ *
      (rectIntegral (fun z => fderiv ℝ (fun w : L2T L => RootScalarPeriodR10.symbol κ w z) v k' /
        Df L κ (fun z => G hκ z v) z)
        ((fun n => RootScalarPeriodR8.cut hκ u (n-1)) n) ((fun n => RootScalarPeriodR8.cut hκ u n) n) 1).re :=
    fun n hn => (hWv n v (hWn n hn)).2.2
  have htraj := R52CFClassical.trajectory_eq hκ hG Fs t ht0 (fun n => RootScalarPeriodR8.cut hκ u (n-1))
    (fun n => RootScalarPeriodR8.cut hκ u n) zero_le_one hAB (Df L κ (fun z => G hκ z v)) hD v hv1 hdiff
    hzh hgW hWb0
  have hdom := R52CFBudget.dominates (L := L) (MPContour.nu (Fs.card * 4)) κ
    (wt κ Fs t (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) 1
      (Df L κ (fun z => G hκ z v)))
    (MPContour.zθ (fam Fs t (fun n => RootScalarPeriodR8.cut hκ u (n-1))
      (fun n => RootScalarPeriodR8.cut hκ u n) 1)) hzh hgW hWb0 1
  have hP := Prop001RtwentyAssembly.schedule_rate (Prop001RtwentyTheorem.nonzeroCaRate (H := L2T L)) Bd
    _ hdom ⟨v, hv1⟩ (k + q) k hk 1 zero_le_one (by simp [Prop001RtwentyAssembly.elapsed])
  have e3 : traceNorm (PhysicalTensor.reducedDensityN (k + q) k hk
      (Prop001.quantumEvolution (kerA (MPContour.nu (Fs.card * 4)) κ
        (wt κ Fs t (fun n => RootScalarPeriodR8.cut hκ u (n-1)) (fun n => RootScalarPeriodR8.cut hκ u n) 1
          (Df L κ (fun z => G hκ z v)))
        (physK (L := L) (MPContour.zθ (fam Fs t (fun n => RootScalarPeriodR8.cut hκ u (n-1))
          (fun n => RootScalarPeriodR8.cut hκ u n) 1)))) (k + q) 1 (HighMomentsOps.wvec (k + q) v) :
        HilbertTensorPower ℂ (L2T L) (k + q)) -
      Prop001.coherentProjector k (Tθ (L := L) hκ t v)) ≤ ENNReal.ofReal (Bd.rate k (k + q) 1) := by
    rw [← htraj]
    exact hP
  exact traceNorm_three _ _ _ _ (by positivity) (mul_nonneg hC0 (Real.sqrt_nonneg _))
    (Prop001RtwentyAssembly.rate_nonneg _ _ _ _) e1' e2 e3

end Local

