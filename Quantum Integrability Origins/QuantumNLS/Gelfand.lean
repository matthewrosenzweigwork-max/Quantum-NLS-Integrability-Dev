section OperatorSequenceQuotient

variable (H : ℕ → Type*) [∀ n, NormedAddCommGroup (H n)]
  [∀ n, InnerProductSpace ℂ (H n)] [∀ n, CompleteSpace (H n)] [∀ n, Nontrivial (H n)]

/-- The report's quotient for a specified family of complete complex Hilbert sectors.
The physical `H_N` and `E^q_{N,ab}` must still be constructed before this specialization
can be applied to the report's norm-limit theorem. -/
abbrev OperatorSequenceQuotient := SequenceQuotient (fun n => H n →L[ℂ] H n)

example : CStarAlgebra (OperatorSequenceQuotient H) := inferInstance

end OperatorSequenceQuotient

variable {ι A : Type*} [CStarAlgebra A]

/-- The actual closed unital star subalgebra generated by the entries of `E`. -/
def generatedAlgebra (E : ι → ι → A) : StarSubalgebra ℂ A :=
  (StarAlgebra.adjoin ℂ (Set.range fun p : ι × ι => E p.1 p.2)).topologicalClosure

theorem generator_mem (E : ι → ι → A) (a b : ι) :
    E a b ∈ generatedAlgebra E :=
  StarSubalgebra.le_topologicalClosure _
    (StarAlgebra.subset_adjoin ℂ _ ⟨(a, b), rfl⟩)

theorem generatedAlgebra_isClosed (E : ι → ι → A) :
    IsClosed (generatedAlgebra E : Set A) :=
  StarSubalgebra.isClosed_topologicalClosure _

instance generatedAlgebraCStar (E : ι → ι → A) : CStarAlgebra (generatedAlgebra E) :=
  StarSubalgebra.cstarAlgebra _ (h_closed := generatedAlgebra_isClosed E)

/-- Adjoint reversal plus pairwise commutation suffices even when the ambient algebra
is noncommutative. In the report these are identities of quotient classes, not of the
finite-particle operators themselves. -/
theorem generatedAlgebra_isMulCommutative (E : ι → ι → A)
    (hstar : ∀ a b, star (E a b) = E b a)
    (hcomm : ∀ a b c d, Commute (E a b) (E c d)) :
    IsMulCommutative (generatedAlgebra E) := by
  let s : Set A := Set.range fun p : ι × ι => E p.1 p.2
  have hs : IsMulCommutative (StarAlgebra.adjoin ℂ s) := by
    apply StarAlgebra.isMulCommutative_adjoin
    · rintro x ⟨⟨a, b⟩, rfl⟩
      exact ⟨by simpa only [hstar] using hcomm b a a b⟩
    · rintro x ⟨⟨a, b⟩, rfl⟩ y ⟨⟨c, d⟩, rfl⟩ _
      exact hcomm a b c d
    · rintro x ⟨⟨a, b⟩, rfl⟩ y ⟨⟨c, d⟩, rfl⟩ _
      simpa only [hstar] using hcomm a b d c
  have := hs
  exact StarSubalgebra.isMulCommutative_topologicalClosure _

/-- The commutative C*-algebra structure is derived, rather than assumed as a field. -/
abbrev generatedCommCStarAlgebra (E : ι → ι → A)
    (hstar : ∀ a b, star (E a b) = E b a)
    (hcomm : ∀ a b c d, Commute (E a b) (E c d)) :
    CommCStarAlgebra (generatedAlgebra E) := by
  letI := generatedAlgebra_isMulCommutative E hstar hcomm
  infer_instance

/-- Gelfand realization of the explicitly constructed generated algebra. -/
def generatedGelfand (E : ι → ι → A)
    (hstar : ∀ a b, star (E a b) = E b a)
    (hcomm : ∀ a b c d, Commute (E a b) (E c d)) :
    generatedAlgebra E ≃⋆ₐ[ℂ]
      C(WeakDual.characterSpace ℂ (generatedAlgebra E), ℂ) := by
  letI := generatedCommCStarAlgebra E hstar hcomm
  exact gelfandStarTransform _

theorem generatedGelfand_isometry (E : ι → ι → A)
    (hstar : ∀ a b, star (E a b) = E b a)
    (hcomm : ∀ a b c d, Commute (E a b) (E c d)) :
    Isometry (generatedGelfand E hstar hcomm) := by
  let := generatedCommCStarAlgebra E hstar hcomm
  exact gelfandTransform_isometry _

section CharacterMatrix

variable {κ : Type*} {C : Matrix κ κ ℂ}

/-- With all two-by-two minors zero, a Hermitian matrix whose diagonal vanishes is
zero. This handles the zero character matrix without choosing a nonzero pivot. -/
theorem eq_zero_of_diagonal_eq_zero (hHerm : C.IsHermitian)
    (hminor : ∀ a b c d, C a b * C c d = C a d * C c b)
    (hdiag : ∀ a, C a a = 0) : C = 0 := by
  ext a b
  change C a b = 0
  have hmul : C a b * C b a = 0 := by
    rw [← hminor a a b b, hdiag a, zero_mul]
  rcases mul_eq_zero.mp hmul with hab | hba
  · exact hab
  · simpa only [hba, star_zero] using (hHerm.apply a b).symm

/-- The report's local rank-one step after applying a character to `full-minors`.
Only nonnegativity of diagonal entries is needed from positivity. -/
theorem exists_vector_of_minors (hHerm : C.IsHermitian)
    (hdiag : ∀ a, 0 ≤ (C a a).re)
    (hminor : ∀ a b c d, C a b * C c d = C a d * C c b) :
    ∃ z : κ → ℂ, ∀ a b, C a b = z a * conj (z b) := by
  classical
  by_cases hzero : ∀ a, C a a = 0
  · have hC := eq_zero_of_diagonal_eq_zero hHerm hminor hzero
    exact ⟨fun _ => 0, by simp [hC]⟩
  · push Not at hzero
    obtain ⟨p, hp⟩ := hzero
    have hreal : ((C p p).re : ℂ) = C p p :=
      RCLike.conj_eq_iff_re.mp (hHerm.apply p p)
    have hpos : 0 < (C p p).re := by
      refine lt_of_le_of_ne (hdiag p) ?_
      intro h
      apply hp
      rw [← hreal, ← h]
      rfl
    let r : ℝ := Real.sqrt (C p p).re
    have hr : 0 < r := Real.sqrt_pos.mpr hpos
    have hr0 : (r : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hr
    have hr2 : (r : ℂ) * (r : ℂ) = C p p := by
      rw [← Complex.ofReal_mul, ← pow_two, Real.sq_sqrt (hdiag p)]
      exact hreal
    refine ⟨fun a => C a p / (r : ℂ), ?_⟩
    intro a b
    change C a b = (C a p / (r : ℂ)) * conj (C b p / (r : ℂ))
    rw [map_div₀, show conj (C b p) = C p b from hHerm.apply p b,
      Complex.conj_ofReal, div_mul_div_comm, hr2]
    exact (eq_div_iff hp).mpr (hminor a b p p)

/-- Positivity and the trace bound put the factorizing vector in the finite-coordinate
Hilbert unit ball. The norm here is Euclidean (`ℓ²`), not the function space sup norm.
This includes empty label sets and the zero matrix. -/
theorem exists_unitBall_vector_of_posSemidef_minors [Fintype κ]
    (hC : C.PosSemidef)
    (htrace : ∑ a, (C a a).re ≤ 1)
    (hminor : ∀ a b c d, C a b * C c d = C a d * C c b) :
    ∃ z : EuclideanSpace ℂ κ,
      (∀ a b, C a b = z a * conj (z b)) ∧ ‖z‖ ≤ 1 := by
  obtain ⟨v, hv⟩ := exists_vector_of_minors hC.isHermitian
    (fun a => (Complex.nonneg_iff.mp (hC.diag_nonneg (i := a))).1) hminor
  let z : EuclideanSpace ℂ κ := WithLp.toLp 2 v
  have hz : ∀ a b, C a b = z a * conj (z b) := hv
  refine ⟨z, hz, ?_⟩
  have hnorm : ‖z‖ ^ 2 ≤ 1 := by
    rw [EuclideanSpace.norm_sq_eq]
    convert htrace using 1
    apply Finset.sum_congr rfl
    intro a _
    rw [hz a a, Complex.mul_conj']
    simp only [← Complex.ofReal_pow, Complex.ofReal_re]
  nlinarith [norm_nonneg z]

#print axioms eq_zero_of_diagonal_eq_zero
#print axioms exists_vector_of_minors
#print axioms exists_unitBall_vector_of_posSemidef_minors

end CharacterMatrix

