section SequenceQuotient

open Filter Topology
open scoped ENNReal

variable (B : ℕ → Type*) [∀ n, CStarAlgebra (B n)]

/-- Bounded sequences with the actual (possibly varying) sector algebras as fibers. -/
abbrev BoundedSequence := lp B ∞

/-- Norm-nullness makes sense for varying fibers, without identifying the sectors. -/
def NormNull (x : BoundedSequence B) : Prop :=
  Tendsto (fun n => ‖x n‖) atTop (𝓝 0)

theorem normNull_zero : NormNull B 0 := by
  simp [NormNull]

theorem normNull_add {x y : BoundedSequence B} (hx : NormNull B x) (hy : NormNull B y) :
    NormNull B (x + y) := by
  apply squeeze_zero (fun n => norm_nonneg _) (fun n => norm_add_le (x n) (y n))
  simpa using hx.add hy

theorem normNull_mul_left (x : BoundedSequence B) {y : BoundedSequence B}
    (hy : NormNull B y) : NormNull B (x * y) := by
  apply squeeze_zero (fun n => norm_nonneg _)
    (fun n => (norm_mul_le (x n) (y n)).trans
      (mul_le_mul_of_nonneg_right (lp.norm_apply_le_norm ENNReal.top_ne_zero x n) (norm_nonneg _)))
  simpa using hy.const_mul ‖x‖

theorem normNull_mul_right {x : BoundedSequence B} (hx : NormNull B x)
    (y : BoundedSequence B) : NormNull B (x * y) := by
  apply squeeze_zero (fun n => norm_nonneg _)
    (fun n => (norm_mul_le (x n) (y n)).trans
      (mul_le_mul_of_nonneg_left (lp.norm_apply_le_norm ENNReal.top_ne_zero y n) (norm_nonneg _)))
  simpa using hx.mul_const ‖y‖

variable [∀ n, Nontrivial (B n)]

/-- The concrete left ideal; right absorption is proved below. -/
def normNullIdeal : Ideal (BoundedSequence B) where
  carrier := {x | NormNull B x}
  zero_mem' := normNull_zero B
  add_mem' := normNull_add B
  smul_mem' := normNull_mul_left B

instance normNullIdeal_twoSided : (normNullIdeal B).IsTwoSided where
  mul_mem_of_left := fun y hx => normNull_mul_right B hx y

omit [∀ n, Nontrivial (B n)] in
theorem normNull_star_iff (x : BoundedSequence B) : NormNull B (star x) ↔ NormNull B x := by
  simp only [NormNull, lp.star_apply, norm_star]

/-- Uniform-norm limits of norm-null sequences are norm-null. -/
theorem normNullIdeal_isClosed : IsClosed (normNullIdeal B : Set (BoundedSequence B)) := by
  apply isClosed_of_closure_subset
  intro x hx
  change NormNull B x
  rw [NormNull, Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨y, hy, hxy⟩ := Metric.mem_closure_iff.mp hx (ε / 2) (by positivity)
  have hy' : NormNull B y := hy
  have hev := (Metric.tendsto_nhds.mp hy') (ε / 2) (by positivity)
  filter_upwards [hev] with n hn
  have hcoord : ‖x n - y n‖ ≤ dist x y := by
    simpa only [dist_eq_norm, lp.coeFn_sub, Pi.sub_apply] using
      lp.norm_apply_le_norm ENNReal.top_ne_zero (x - y) n
  have htri := norm_add_le (x n - y n) (y n)
  rw [sub_add_cancel] at htri
  simp only [Real.dist_eq, sub_zero, abs_norm] at hn
  simpa only [Real.dist_eq, sub_zero, abs_norm] using
    lt_of_le_of_lt htri (by linarith)

instance normNullIdeal_closed : IsClosed (normNullIdeal B : Set (BoundedSequence B)) :=
  normNullIdeal_isClosed B

/-- The actual quotient by norm-null sequences. Its ring and Banach additive structures
come from the constructed ideal, not from a target interface. -/
abbrev SequenceQuotient := BoundedSequence B ⧸ normNullIdeal B

example : Ring (SequenceQuotient B) := inferInstance
example : NormedAddCommGroup (SequenceQuotient B) := inferInstance
example : CompleteSpace (SequenceQuotient B) := inferInstance

/-- Removing finitely many sectors changes no class in the norm-null quotient. -/
def sequenceTail (x : BoundedSequence B) (N : ℕ) : BoundedSequence B :=
  ⟨fun n => if N ≤ n then x n else 0,
    memℓp_infty_iff.mpr ⟨‖x‖, by
      rintro _ ⟨n, rfl⟩
      change ‖if N ≤ n then x n else 0‖ ≤ ‖x‖
      split_ifs
      · exact lp.norm_apply_le_norm ENNReal.top_ne_zero x n
      · exact (norm_zero).trans_le (norm_nonneg x)⟩⟩

theorem sequenceTail_mk (x : BoundedSequence B) (N : ℕ) :
    Ideal.Quotient.mk (normNullIdeal B) (sequenceTail B x N) =
      Ideal.Quotient.mk (normNullIdeal B) x := by
  apply Ideal.Quotient.eq.mpr
  change Tendsto (fun n => ‖sequenceTail B x N n - x n‖) atTop (𝓝 0)
  apply tendsto_const_nhds.congr'
  filter_upwards [eventually_ge_atTop N] with n hn
  simp [sequenceTail, hn]

omit [∀ n, Nontrivial (B n)] in
theorem sequence_norm_bounded (x : BoundedSequence B) :
    IsBoundedUnder (· ≤ ·) atTop (fun n => ‖x n‖) :=
  isBoundedUnder_of ⟨‖x‖, lp.norm_apply_le_norm ENNReal.top_ne_zero x⟩

omit [∀ n, Nontrivial (B n)] in
theorem sequence_norm_cobounded (x : BoundedSequence B) :
    IsCoboundedUnder (· ≤ ·) atTop (fun n => ‖x n‖) :=
  isCoboundedUnder_le_of_le atTop (fun n => norm_nonneg (x n))

omit [∀ n, Nontrivial (B n)] in
theorem sequence_limsup_nonneg (x : BoundedSequence B) :
    0 ≤ limsup (fun n => ‖x n‖) atTop := by
  apply le_limsup_of_le (sequence_norm_bounded B x)
  intro b hb
  obtain ⟨n, hn⟩ := hb.exists
  exact (norm_nonneg (x n)).trans hn

/-- The quotient norm is the limsup, for genuinely varying sector algebras. -/
theorem sequenceQuotient_norm (x : BoundedSequence B) :
    ‖Ideal.Quotient.mk (normNullIdeal B) x‖ = limsup (fun n => ‖x n‖) atTop := by
  apply le_antisymm
  · apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨N, hN⟩ := eventually_atTop.mp
      (eventually_lt_of_limsup_lt (lt_add_of_pos_right _ hε) (sequence_norm_bounded B x))
    rw [← sequenceTail_mk B x N]
    apply (Submodule.Quotient.norm_mk_le (normNullIdeal B) _).trans
    apply lp.norm_le_of_forall_le (by linarith [sequence_limsup_nonneg B x])
    intro n
    change ‖if N ≤ n then x n else 0‖ ≤ _
    split_ifs with hn
    · exact (hN n hn).le
    · simpa using (le_add_of_nonneg_of_le (sequence_limsup_nonneg B x) hε.le)
  · apply QuotientAddGroup.le_norm_iff.mpr
    intro y hy
    have hnull : NormNull B (x - y) := by
      exact Ideal.Quotient.eq.mp hy.symm
    apply le_of_forall_pos_le_add
    intro ε hε
    apply limsup_le_of_le (sequence_norm_cobounded B x)
    have hev := Metric.tendsto_nhds.mp hnull ε hε
    filter_upwards [hev] with n hn
    simp only [Real.dist_eq, sub_zero, abs_norm] at hn
    have htri := norm_add_le (x n - y n) (y n)
    rw [sub_add_cancel] at htri
    have hybound := lp.norm_apply_le_norm ENNReal.top_ne_zero y n
    change ‖x n‖ ≤ ‖y‖ + ε
    change ‖x n - y n‖ < ε at hn
    linarith

#print axioms sequenceQuotient_norm

/-- The quotient involution descends from adjoints of the actual sequences. -/
instance sequenceQuotientStar : Star (SequenceQuotient B) where
  star x := Quotient.liftOn' x (fun y => Ideal.Quotient.mk (normNullIdeal B) (star y)) (by
    intro y z hyz
    apply Ideal.Quotient.eq.mpr
    have hnull : NormNull B (y - z) := by
      exact (Submodule.quotientRel_def _).mp hyz
    change NormNull B (star y - star z)
    rw [← star_sub]
    exact (normNull_star_iff B _).mpr hnull)

@[simp] theorem sequenceQuotient_star_mk (x : BoundedSequence B) :
    star (Ideal.Quotient.mk (normNullIdeal B) x) =
      Ideal.Quotient.mk (normNullIdeal B) (star x) := rfl

instance sequenceQuotientStarRing : StarRing (SequenceQuotient B) where
  star_involutive := by
    intro x
    induction x using Quotient.inductionOn' with | h x =>
      change Ideal.Quotient.mk (normNullIdeal B) (star (star x)) =
        Ideal.Quotient.mk (normNullIdeal B) x
      rw [star_star]
  star_add := by
    intro x y
    induction x using Quotient.inductionOn' with | h x =>
      induction y using Quotient.inductionOn' with | h y =>
        change Ideal.Quotient.mk (normNullIdeal B) (star (x + y)) = _
        rw [star_add, map_add]
        rfl
  star_mul := by
    intro x y
    induction x using Quotient.inductionOn' with | h x =>
      induction y using Quotient.inductionOn' with | h y =>
        change Ideal.Quotient.mk (normNullIdeal B) (star (x * y)) = _
        rw [star_mul, map_mul]
        rfl

instance sequenceQuotientNormedRing : NormedRing (SequenceQuotient B) where
  dist_eq := dist_eq_norm_neg_add
  norm_mul_le x y := by
    induction x using Quotient.inductionOn' with | h x =>
      induction y using Quotient.inductionOn' with | h y =>
        change ‖Ideal.Quotient.mk (normNullIdeal B) (x * y)‖ ≤
          ‖Ideal.Quotient.mk (normNullIdeal B) x‖ * ‖Ideal.Quotient.mk (normNullIdeal B) y‖
        rw [sequenceQuotient_norm B (x * y), sequenceQuotient_norm B x, sequenceQuotient_norm B y]
        refine (limsup_le_limsup (Eventually.of_forall (fun n => norm_mul_le (x n) (y n)))
          (sequence_norm_cobounded B (x * y))
          (isBoundedUnder_of ⟨‖x‖ * ‖y‖, fun n => mul_le_mul
            (lp.norm_apply_le_norm ENNReal.top_ne_zero x n)
            (lp.norm_apply_le_norm ENNReal.top_ne_zero y n) (norm_nonneg _) (norm_nonneg _)⟩)).trans ?_
        exact limsup_mul_le (Eventually.of_forall (fun n => norm_nonneg (x n))).frequently
          (sequence_norm_bounded B x) (Eventually.of_forall (fun n => norm_nonneg (y n)))
          (sequence_norm_bounded B y)

instance sequenceQuotientNormedAlgebra : NormedAlgebra ℂ (SequenceQuotient B) :=
  { Submodule.Quotient.normedSpace (normNullIdeal B) ℂ,
    Ideal.Quotient.algebra ℂ with }

instance sequenceQuotientStarModule : StarModule ℂ (SequenceQuotient B) where
  star_smul c x := by
    induction x using Quotient.inductionOn' with | h x =>
      change Ideal.Quotient.mk (normNullIdeal B) (star (c • x)) =
        Ideal.Quotient.mk (normNullIdeal B) (star c • star x)
      rw [star_smul]

theorem sequenceQuotient_norm_star_mul_self (x : SequenceQuotient B) :
    ‖star x * x‖ = ‖x‖ * ‖x‖ := by
  induction x using Quotient.inductionOn' with | h x =>
    change ‖Ideal.Quotient.mk (normNullIdeal B) (star x * x)‖ =
      ‖Ideal.Quotient.mk (normNullIdeal B) x‖ * ‖Ideal.Quotient.mk (normNullIdeal B) x‖
    rw [sequenceQuotient_norm B (star x * x), sequenceQuotient_norm B x]
    simp only [lp.infty_coeFn_mul, Pi.mul_apply, lp.star_apply, CStarRing.norm_star_mul_self]
    have hmono : Monotone (fun t : ℝ => (max t 0) ^ 2) := by
      intro a b hab
      dsimp
      gcongr
    have h := hmono.map_limsup_of_continuousAt (fun n => ‖x n‖) (by fun_prop)
      (sequence_norm_bounded B x) (sequence_norm_cobounded B x)
    simp only [Function.comp_def, max_eq_left (sequence_limsup_nonneg B x),
      max_eq_left (norm_nonneg _), pow_two] at h
    exact h.symm

/-- The quotient C*-algebra structure is proved from its concrete norm and operations. -/
instance sequenceQuotientCStarAlgebra : CStarAlgebra (SequenceQuotient B) where
  norm_mul_self_le x := (sequenceQuotient_norm_star_mul_self B x).symm.le

theorem sequenceQuotient_norm_one : ‖(1 : SequenceQuotient B)‖ = 1 := by
  change ‖Ideal.Quotient.mk (normNullIdeal B) 1‖ = 1
  rw [sequenceQuotient_norm]
  simp only [lp.infty_coeFn_one, Pi.one_apply, norm_one, limsup_const]

/-- Nonzeroness of every sector algebra ensures the quotient is nonzero. -/
instance sequenceQuotientNontrivial : Nontrivial (SequenceQuotient B) := by
  refine ⟨⟨1, 0, ?_⟩⟩
  intro h
  have hn := sequenceQuotient_norm_one B
  rw [h, norm_zero] at hn
  exact zero_ne_one hn

/-- The canonical quotient map preserves all complex star-algebra operations. -/
def sequenceQuotientMk : BoundedSequence B →⋆ₐ[ℂ] SequenceQuotient B :=
  { Ideal.Quotient.mkₐ ℂ (normNullIdeal B) with
    map_star' := fun _ => rfl }

theorem sequenceQuotientMk_eq_zero_iff (x : BoundedSequence B) :
    sequenceQuotientMk B x = 0 ↔ NormNull B x :=
  Ideal.Quotient.eq_zero_iff_mem

omit [∀ n, Nontrivial (B n)] in
/-- An eventual `O(N⁻¹)` norm estimate suffices; there is no zero-sector assumption. -/
theorem normNull_of_eventually_norm_le_inv_nat_mul (x : BoundedSequence B) (C : ℝ)
    (h : ∀ᶠ n in atTop, ‖x n‖ ≤ (n : ℝ)⁻¹ * C) : NormNull B x := by
  apply squeeze_zero' (Eventually.of_forall (fun n => norm_nonneg (x n))) h
  simpa using (tendsto_inv_atTop_nhds_zero_nat (𝕜 := ℝ)).mul_const C

omit [∀ n, Nontrivial (B n)] in
/-- Uniform boundedness turns an eventual `N⁻¹` scalar multiple into a norm-null defect. -/
theorem normNull_of_eventually_eq_inv_nat_smul (d x : BoundedSequence B)
    (h : ∀ᶠ n in atTop, d n = (n : ℂ)⁻¹ • x n) : NormNull B d := by
  apply normNull_of_eventually_norm_le_inv_nat_mul B d ‖x‖
  filter_upwards [h] with n hn
  rw [hn, norm_smul, norm_inv, Complex.norm_natCast]
  exact mul_le_mul_of_nonneg_left (lp.norm_apply_le_norm ENNReal.top_ne_zero x n)
    (inv_nonneg.mpr (Nat.cast_nonneg n))

theorem sequenceQuotient_commute_iff (x y : BoundedSequence B) :
    Commute (sequenceQuotientMk B x) (sequenceQuotientMk B y) ↔
      NormNull B (x * y - y * x) := by
  change Ideal.Quotient.mk (normNullIdeal B) (x * y) =
      Ideal.Quotient.mk (normNullIdeal B) (y * x) ↔ _
  exact Ideal.Quotient.eq

/-- The exact CCR's vanishing norm defect produces actual commutation of classes. -/
theorem sequenceQuotient_commute_of_bound (x y : BoundedSequence B) (C : ℝ)
    (h : ∀ᶠ n in atTop, ‖x n * y n - y n * x n‖ ≤ (n : ℝ)⁻¹ * C) :
    Commute (sequenceQuotientMk B x) (sequenceQuotientMk B y) :=
  (sequenceQuotient_commute_iff B x y).mpr
    (normNull_of_eventually_norm_le_inv_nat_mul B (x * y - y * x) C h)

theorem sequenceQuotient_minor_of_bound (w x y z : BoundedSequence B) (C : ℝ)
    (h : ∀ᶠ n in atTop, ‖w n * x n - y n * z n‖ ≤ (n : ℝ)⁻¹ * C) :
    sequenceQuotientMk B w * sequenceQuotientMk B x =
      sequenceQuotientMk B y * sequenceQuotientMk B z := by
  apply Ideal.Quotient.eq.mpr
  exact normNull_of_eventually_norm_le_inv_nat_mul B (w * x - y * z) C h

variable {ι : Type*} [DecidableEq ι]

/-- Exact source CCR, with its donor/receiver sign and all four labels retained,
implies commutation in the concrete quotient. The operator CCR remains a separate
upstream obligation; this theorem does not assume quotient commutativity. -/
theorem sequenceQuotient_commute_of_CCR (E : ι → ι → BoundedSequence B)
    (hCCR : ∀ a b c d, ∀ᶠ n in atTop,
      E a b n * E c d n - E c d n * E a b n = (n : ℂ)⁻¹ •
        ((if a = d then E c b n else 0) - (if b = c then E a d n else 0))) :
    ∀ a b c d, Commute (sequenceQuotientMk B (E a b)) (sequenceQuotientMk B (E c d)) := by
  classical
  intro a b c d
  apply (sequenceQuotient_commute_iff B _ _).mpr
  apply normNull_of_eventually_eq_inv_nat_smul B _
    ((if a = d then E c b else 0) - (if b = c then E a d else 0))
  filter_upwards [hCCR a b c d] with n hn
  change E a b n * E c d n - E c d n * E a b n = (n : ℂ)⁻¹ •
    ((if a = d then E c b else 0) n - (if b = c then E a d else 0) n)
  have heval (p : Prop) [Decidable p] (u v : BoundedSequence B) :
      (if p then u else v) n = if p then u n else v n := by split_ifs <;> rfl
  simpa only [heval, lp.coeFn_zero, Pi.zero_apply] using hn

/-- The exact source minor identity gives vanishing minors of quotient classes. -/
theorem sequenceQuotient_minors_of_identity (E : ι → ι → BoundedSequence B)
    (hminor : ∀ a b c d, ∀ᶠ n in atTop,
      E a b n * E c d n - E a d n * E c b n = (n : ℂ)⁻¹ •
        ((if a = d then E c b n else 0) - (if a = b then E c d n else 0))) :
    ∀ a b c d, sequenceQuotientMk B (E a b) * sequenceQuotientMk B (E c d) =
      sequenceQuotientMk B (E a d) * sequenceQuotientMk B (E c b) := by
  classical
  intro a b c d
  apply Ideal.Quotient.eq.mpr
  apply normNull_of_eventually_eq_inv_nat_smul B _
    ((if a = d then E c b else 0) - (if a = b then E c d else 0))
  filter_upwards [hminor a b c d] with n hn
  change E a b n * E c d n - E a d n * E c b n = (n : ℂ)⁻¹ •
    ((if a = d then E c b else 0) n - (if a = b then E c d else 0) n)
  have heval (p : Prop) [Decidable p] (u v : BoundedSequence B) :
      (if p then u else v) n = if p then u n else v n := by split_ifs <;> rfl
  simpa only [heval, lp.coeFn_zero, Pi.zero_apply] using hn

