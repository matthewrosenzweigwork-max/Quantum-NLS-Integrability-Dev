import QuantumNLS.Ext006CyclicIsometryR34a

/-! Identity-source cyclicity in the whole completed occupation Fock space.
Every occupation ket is generated by actual source creators. No whole-Fock
cyclicity for a nonidentity source map is asserted here. -/
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 4000000
open scoped InnerProductSpace
namespace QuantumNLS.Ext006IdentityCyclicR35a
open Occupation Ext006VacuumRecurrence Ext006BogoliubovAlg Ext006QuasifreeWeak
open Ext006ModeDomainR33a Ext006SmearedDomainR33a Ext006SmoothOperatorsR34a
open Ext006SourceCCRR34a Ext006CreationGramR34a Ext006CyclicIsometryR34a
open Ext006KernelHilbertSchmidt
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]
attribute [local instance] InnerProductSpace.complexToReal

abbrev identitySource : E ≃L[ℝ] E := ContinuousLinearEquiv.refl ℝ E

def ketD (m : Occ) : D :=
  ⟨lp.single 2 m 1, Ext006SmearedCCRR34a.single_smooth m⟩

omit [CompleteSpace E] in
lemma p_identity (b : HilbertBasis ℤ ℂ E) (f : E) :
    p b identitySource f = b.repr f := by
  change b.repr (Ext006Blocks.complexPart (ContinuousLinearMap.id ℝ E) f) = _
  rw [Ext006SymplecticKernel.complexPart_id,ContinuousLinearMap.id_apply]

omit [CompleteSpace E] in
lemma r_identity (b : HilbertBasis ℤ ℂ E) (f : E) :
    r b identitySource f = 0 := by
  change b.repr (conjugation b (conjugation b
    (Ext006Blocks.antilinearPart (ContinuousLinearMap.id ℝ E) f))) = 0
  rw [Ext006SymplecticKernel.antilinearPart_id]
  simp

lemma A_zero : A (0 : H) = 0 := by
  ext w m
  change inner ℂ (0 : H) (xvec w.1 m) = 0
  exact inner_zero_left _

lemma C_zero : C (0 : H) = 0 := by
  ext w m
  change (∑ a ∈ m.support, (0 : H) a * creCoeff a w.1 m) = 0
  simp

omit [CompleteSpace E] in
lemma sourceAnn_identity (b : HilbertBasis ℤ ℂ E) (f : E) :
    sourceAnn b identitySource f = A (b.repr f) := by
  rw [sourceAnn,B,p_identity,r_identity,C_zero,add_zero]

omit [CompleteSpace E] in
lemma sourceCre_identity (b : HilbertBasis ℤ ℂ E) (f : E) :
    sourceCre b identitySource f = C (b.repr f) := by
  rw [sourceCre,Bstar,p_identity,r_identity,A_zero,add_zero]

omit [CompleteSpace E] in
lemma identity_vacuum (b : HilbertBasis ℤ ℂ E) (f : E) :
    sourceAnn b identitySource f (ketD 0) = 0 := by
  rw [sourceAnn_identity]
  apply Subtype.ext
  apply lp.ext
  funext m
  change inner ℂ (b.repr f) (xvec (lp.single 2 (0 : Occ) 1) m) = 0
  have hx : xvec (lp.single 2 (0 : Occ) 1) m = 0 := by
    apply lp.ext
    funext a
    change (Real.sqrt ((m a : ℝ)+1) : ℂ) * (lp.single 2 (0 : Occ) (1 : ℂ) : Fock) (m+e a) = 0
    simp [lp.single_apply]
  rw [hx,inner_zero_right]

lemma C_mode_ket (a : ℤ) (m : Occ) :
    C (lp.single 2 a 1) (ketD m) =
      (Real.sqrt ((m a : ℝ)+1) : ℂ) • ketD (m+e a) := by
  apply Subtype.ext
  apply lp.ext
  funext n
  change smearedCreCoeff (lp.single 2 a 1) (lp.single 2 m 1) n =
    (Real.sqrt ((m a : ℝ)+1) : ℂ) * (lp.single 2 (m+e a) (1 : ℂ) : Fock) n
  rw [Ext006StrongVacuumR33a.smearedCre_single]
  by_cases hn : n ∈ Set.range (fun k : Occ => k+e a)
  · obtain ⟨k,rfl⟩ := hn
    rw [creCoeff_add]
    by_cases hk : k=m
    · subst k
      simp
    · have hne : k+e a ≠ m+e a := fun he => hk (add_right_cancel he)
      simp [lp.single_apply,hk,hne]
  · rw [creCoeff_off a _ n hn]
    have hne : n ≠ m+e a := fun he => hn ⟨m,he.symm⟩
    simp [lp.single_apply,hne]

omit [CompleteSpace E] in
/-- A finite actual creator word generates each occupation ket, up to a
nonzero coefficient. -/
theorem word_generates_ket (b : HilbertBasis ℤ ℂ E) (m : Occ) :
    ∃ fs : List E, ∃ z : ℂ, z ≠ 0 ∧ word b identitySource fs (ketD 0) = z • ketD m := by
  have h : ∀ n : ℕ, ∀ m : Occ, total m=n →
      ∃ fs : List E, ∃ z : ℂ, z ≠ 0 ∧ word b identitySource fs (ketD 0) = z • ketD m := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro m hmn
      by_cases hm : m=0
      · subst m
        exact ⟨[],1,one_ne_zero,(one_smul ℂ (ketD 0)).symm⟩
      · obtain ⟨a,ha⟩ : ∃ a, m a ≠ 0 := by
          by_contra! hz
          exact hm (Finsupp.ext hz)
        have hma : 1 ≤ m a := Nat.one_le_iff_ne_zero.mpr ha
        have ht := total_sub_e hma
        obtain ⟨fs,z,hz,hfs⟩ := ih (total (m-e a)) (by omega) (m-e a) rfl
        let q : ℂ := (Real.sqrt (((m-e a) a : ℝ)+1) : ℂ)
        have hq : q ≠ 0 := by
          dsimp [q]
          exact_mod_cast (Real.sqrt_pos.mpr (show 0 < ((m-e a) a : ℝ)+1 by positivity)).ne'
        refine ⟨b a::fs,z*q,mul_ne_zero hz hq,?_⟩
        rw [word,hfs,map_smul,sourceCre_identity,b.repr_self,C_mode_ket,
          shift_sub_add hma,smul_smul]
  exact h (total m) m rfl

omit [CompleteSpace E] in
/-- Every ket is in the algebraic creator-word span. -/
theorem ket_in_range (b : HilbertBasis ℤ ℂ E) (m : Occ) :
    (ketD m).1 ∈ (eval b identitySource (ketD 0)).range := by
  obtain ⟨fs,z,hz,hfs⟩ := word_generates_ket b m
  refine ⟨Finsupp.single fs z⁻¹,?_⟩
  simp only [eval,Finsupp.linearCombination_single,hfs,Submodule.coe_smul,
    smul_smul,inv_mul_cancel₀ hz,one_smul]

omit [CompleteSpace E] in
/-- Actual whole-Fock cyclicity for the identity source and ordinary vacuum. -/
theorem identity_cyclic_eq_top (b : HilbertBasis ℤ ℂ E) :
    cyclic b identitySource (ketD 0) = ⊤ := by
  apply top_unique
  intro x _
  apply (eval b identitySource (ketD 0)).range.isClosed_topologicalClosure.mem_of_tendsto
    (lp.hasSum_single (by norm_num) x)
  apply Filter.Eventually.of_forall
  intro s
  apply Submodule.sum_mem
  intro m _
  have hs : (lp.single 2 m (x m) : Fock) = x m • (ketD m).1 := by
    rw [ketD,← lp.single_smul]
    simp
  rw [hs]
  exact Submodule.smul_mem _ _ ((eval b identitySource (ketD 0)).range.le_topologicalClosure
    (ket_in_range b m))

end QuantumNLS.Ext006IdentityCyclicR35a

#print axioms QuantumNLS.Ext006IdentityCyclicR35a.identity_vacuum
#print axioms QuantumNLS.Ext006IdentityCyclicR35a.C_mode_ket
#print axioms QuantumNLS.Ext006IdentityCyclicR35a.ket_in_range
#print axioms QuantumNLS.Ext006IdentityCyclicR35a.identity_cyclic_eq_top

set_option maxHeartbeats 8000000 in
run_cmd do
  let env ← Lean.getEnv
  let mut pending : Array Lean.Name := #[]
  let mut roots : Nat := 0
  for (n, _) in env.constants.toList do
    if n.toString.startsWith "QuantumNLS.Ext006IdentityCyclicR35a." then
      pending := pending.push n
      roots := roots + 1
  let mut seen : Std.HashSet Lean.Name := {}
  while !pending.isEmpty do
    let n := pending.back!
    pending := pending.pop
    unless seen.contains n do
      seen := seen.insert n
      if let some ci := env.find? n then
        match ci with
        | .axiomInfo _ =>
          unless n == ``propext || n == ``Classical.choice || n == ``Quot.sound do
            throwError "Nonstandard dependency: {n}"
        | _ => pure ()
        pending := pending ++ ci.type.getUsedConstants
        if let some v := ci.value? (allowOpaque := true) then
          pending := pending ++ v.getUsedConstants
      else
        throwError "Missing dependency: {n}"
  Lean.logInfo m!"Round35a aggregate audit PASS: {roots} own constants; {seen.size} transitive constants; standard only."
