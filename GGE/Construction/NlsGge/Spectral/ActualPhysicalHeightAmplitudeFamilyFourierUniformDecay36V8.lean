import NlsGge.Spectral.ActualPhysicalHeightAmplitudeFamilyContinuous36V7
import NlsGge.Measure.CompactLpFourierUniformDecay35V4

set_option autoImplicit false
noncomputable section
open Filter
open scoped UniformConvergence Topology

namespace NlsGge.SpectralFoundations
open NlsGge.Pilot NlsGge.Schur NlsGge.Analysis

/-- Uniform Fourier decay for the actual 00 amplitudes over their compact
physical L¹ image. Each point of the indexing subtype is an actual source
amplitude generated by an endpoint/height pair. -/
theorem actualPhysicalHeightAmplitude00Family36V8_fourierUniformDecay
    (u : PhysicalL2) (Y₀ : ℝ) (hY₀ : 0 ≤ Y₀) :
    Tendsto
      (UniformFun.ofFun ∘ fun ξ : ℝ => fun q :
        Set.range (actualPhysicalHeightAmplitude00Family36V6 u Y₀ hY₀) =>
          Real.Lp.fourierTransformCLM ℝ ℂ q.1 ξ)
      (Filter.cocompact ℝ)
      (𝓝 (UniformFun.ofFun (fun _ :
        Set.range (actualPhysicalHeightAmplitude00Family36V6 u Y₀ hY₀) => (0 : ℂ)))) := by
  exact NlsGge.Schur.compactLpFourierUniformDecay35V4
    (actualPhysicalHeightAmplitude00Family36V7_isCompact_range u Y₀ hY₀)

/-- The same actual-image uniform Fourier decay holds for the 11 amplitudes
with their original unstarred source representatives. -/
theorem actualPhysicalHeightAmplitude11Family36V8_fourierUniformDecay
    (u : PhysicalL2) (Y₀ : ℝ) (hY₀ : 0 ≤ Y₀) :
    Tendsto
      (UniformFun.ofFun ∘ fun ξ : ℝ => fun q :
        Set.range (actualPhysicalHeightAmplitude11Family36V6 u Y₀ hY₀) =>
          Real.Lp.fourierTransformCLM ℝ ℂ q.1 ξ)
      (Filter.cocompact ℝ)
      (𝓝 (UniformFun.ofFun (fun _ :
        Set.range (actualPhysicalHeightAmplitude11Family36V6 u Y₀ hY₀) => (0 : ℂ)))) := by
  exact NlsGge.Schur.compactLpFourierUniformDecay35V4
    (actualPhysicalHeightAmplitude11Family36V7_isCompact_range u Y₀ hY₀)

end NlsGge.SpectralFoundations
end
