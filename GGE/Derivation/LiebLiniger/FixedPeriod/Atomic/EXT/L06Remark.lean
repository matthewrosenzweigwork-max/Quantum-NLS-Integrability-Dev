import NlsGge.Hierarchy.ALQ4Ensemble38

/-!
# Invariance of the actual Q₄ lattice ensemble

This supplies the invariant-law assertion of `paper/v2.tex:2222-2224` for the
literal lattice law in `C:eq:ALmeasure` (lines 2095-2102). The frozen TeX SHA-256
is `0e7c2e61a06ab6886124c3891c73e0b8997ab71473eaf75b05c524098a58e3ec`.
The law retains the actual Liouville density and the natural open polydisk.
The public conclusion has the source range `N ≥ 2`, positive three coefficients,
and every real time. Its helpers also cover arbitrary real coefficients as
identities of totalized measures, without asserting probability in that range.

The polynomial specialization is used only on the disk, where it is proved;
outside it the existing flow is the identity. No all-charge admissibility is
imposed on the coefficient sequence with zero tail. These are author proofs
submitted for independent source and semantic review, not claim acceptance.
-/

set_option autoImplicit false
noncomputable section

namespace NlsGge.AblowitzLadik

open MeasureTheory NlsGge.HierarchyRiccati.Core

/-- For arbitrary real coefficients `β₀`, `β₁`, `β₂`, a natural lattice index
`N ≥ 1` supplied by `hN`, every real time `t`, and every complex configuration
`α` on `ZMod (2*N+1)`, the literal polynomial lattice energy is conserved by the
actual AL Hamiltonian flow. This includes the flow's identity extension off the
defocusing polydisk. -/
theorem alQ4Energy_flow38 (β₀ β₁ β₂ : ℝ) {N : ℕ} (hN : 1 ≤ N)
    (t : ℝ) (α : ZMod (2 * N + 1) → ℂ) :
    alQ4Energy38 β₀ β₁ β₂ N (alFlow38 alHd t α) =
      alQ4Energy38 β₀ β₁ β₂ N α := by
  classical
  by_cases hα : α ∈ alDisk38 (2 * N + 1)
  · have hflow : IsALField38 (alFlow38 alHd t α) :=
      alFlow_mem38 alHd_contDiffOn38 alBracket_mass_alHd38 hα t
    rw [← alEnergy38_poly38 β₀ β₁ β₂ hN hflow,
      alEnergy_flow38, alEnergy38_poly38 β₀ β₁ β₂ hN hα]
  · rw [alFlow_of_not_mem38 alHd t hα]

/-- For arbitrary real coefficients `β₀`, `β₁`, `β₂`, a natural lattice index
`N ≥ 1` supplied by `hN`, and every real time `t`, pushing the Q₄
energy-weighted Liouville measure forward by the actual AL flow preserves that
measure. This is an equality of measures before normalization. -/
theorem alQ4Weighted_invariant38 (β₀ β₁ β₂ : ℝ) {N : ℕ}
    (hN : 1 ≤ N) (t : ℝ) :
    (alQ4Weighted38 β₀ β₁ β₂ N).map (alFlow38 alHd t) =
      alQ4Weighted38 β₀ β₁ β₂ N := by
  classical
  obtain ⟨hm, -⟩ := alLiouville_preimage38
    (alHd_contDiffOn38 (L := 2 * N + 1)) alBracket_mass_alHd38 t
  have hw : Measurable fun α : ZMod (2 * N + 1) → ℂ =>
      ENNReal.ofReal (Real.exp (-alQ4Energy38 β₀ β₁ β₂ N α)) :=
    ENNReal.measurable_ofReal.comp (meas_alQ4Energy38 β₀ β₁ β₂ N).neg.exp
  refine Measure.ext fun A hA => ?_
  unfold alQ4Weighted38
  rw [Measure.map_apply hm hA, withDensity_apply _ (hm hA), withDensity_apply _ hA,
    ← lintegral_indicator (hm hA), ← lintegral_indicator hA]
  rw [← alLiouville_lintegral_flow38 (alHd_contDiffOn38 (L := 2 * N + 1))
    alBracket_mass_alHd38 t (hw.indicator hA)]
  refine lintegral_congr fun α => ?_
  by_cases hx : alFlow38 alHd t α ∈ A
  · rw [Set.indicator_of_mem (show α ∈ alFlow38 alHd t ⁻¹' A from hx),
      Set.indicator_of_mem hx, alQ4Energy_flow38 β₀ β₁ β₂ hN]
  · rw [Set.indicator_of_notMem (show α ∉ alFlow38 alHd t ⁻¹' A from hx),
      Set.indicator_of_notMem hx]

/-- For arbitrary real coefficients `β₀`, `β₁`, `β₂`, a natural lattice index
`N ≥ 1` supplied by `hN`, and every real time `t`, the actual AL flow preserves
the normalized Q₄ measure as a measure equality. Probability is asserted in the
source-positive range by `actual_l06_q4_invariant38` below. -/
theorem alQ4Eta_invariant38 (β₀ β₁ β₂ : ℝ) {N : ℕ}
    (hN : 1 ≤ N) (t : ℝ) :
    (alQ4Eta38 β₀ β₁ β₂ N).map (alFlow38 alHd t) =
      alQ4Eta38 β₀ β₁ β₂ N := by
  unfold alQ4Eta38
  rw [Measure.map_smul, alQ4Weighted_invariant38 β₀ β₁ β₂ hN t]
  exact (alLiouville_preimage38 (alHd_contDiffOn38 (L := 2 * N + 1))
    alBracket_mass_alHd38 t).1.aemeasurable

end NlsGge.AblowitzLadik

namespace LiebLiniger.FixedPeriod.EXT

open MeasureTheory NlsGge.AblowitzLadik NlsGge.HierarchyRiccati.Core

/-- The lattice-invariance assertion of the L06 source remark. For arbitrary
real `β₀`, `β₁`, `β₂`, strictly positive by `hβ₀`, `hβ₁`, `hβ₂`, every natural
`N ≥ 2` supplied by `hN` (hence lattice size `2*N+1 ≥ 5` and mesh `1/(2*N+1)`),
and every real time `t`, the literal Q₄ lattice law is a probability measure
and is preserved by the actual AL flow generated by `alHd`. No small-mesh
condition or continuum-dynamics conclusion is part of this assertion. -/
theorem actual_l06_q4_invariant38 {β₀ β₁ β₂ : ℝ}
    (hβ₀ : 0 < β₀) (hβ₁ : 0 < β₁) (hβ₂ : 0 < β₂)
    {N : ℕ} (hN : 2 ≤ N) (t : ℝ) :
    IsProbabilityMeasure (alQ4Eta38 β₀ β₁ β₂ N) ∧
    MeasurePreserving (alFlow38 alHd t)
      (alQ4Eta38 β₀ β₁ β₂ N) (alQ4Eta38 β₀ β₁ β₂ N) := by
  refine ⟨isProbabilityMeasure_alQ4Eta38 hβ₀ hβ₁.le hβ₂.le N, ?_⟩
  exact ⟨(alLiouville_preimage38 (alHd_contDiffOn38 (L := 2 * N + 1))
    alBracket_mass_alHd38 t).1,
    alQ4Eta_invariant38 β₀ β₁ β₂ (by omega : 1 ≤ N) t⟩

end LiebLiniger.FixedPeriod.EXT
