import LiebLiniger.FixedPeriod.Quantum.OccupationBasis

/-! Complete occupation basis for the concrete finite-mode symmetric subspace. -/

noncomputable section
open MeasureTheory
open scoped InnerProductSpace

namespace LiebLiniger.FixedPeriod.Quantum

/-- The actual occupation labels realized by n-particle words over d modes. -/
def RealizedOccupation (n d : ℕ) :=
  {α : Fin d → ℕ // ∃ f : Fin n → Fin d, occupationWordCount f = α}

instance realizedOccupation_fintype (n d : ℕ) : Fintype (RealizedOccupation n d) := by
  classical
  apply Fintype.ofSurjective
    (fun f : Fin n → Fin d => (⟨occupationWordCount f, ⟨f, rfl⟩⟩ : RealizedOccupation n d))
  rintro ⟨α, f, hf⟩
  subst α
  exact ⟨f, rfl⟩

/-- A representative word is chosen only after its existence is part of the label carrier. -/
def occupationRepresentative {n d : ℕ} (α : RealizedOccupation n d) : Fin n → Fin d :=
  Classical.choose α.property

@[simp] theorem occupationRepresentative_count {n d : ℕ} (α : RealizedOccupation n d) :
    occupationWordCount (occupationRepresentative α) = α.val :=
  Classical.choose_spec α.property

/-- Every realized label retains exactly n particles, including n=0. -/
theorem realizedOccupation_sum {n d : ℕ} (α : RealizedOccupation n d) :
    ∑ j, α.val j = n := by
  rw [← occupationRepresentative_count α]
  exact occupationWordCount_sum (occupationRepresentative α)

variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]

/-- Source-normalized occupation vector on the actual spatial symmetric sector. -/
def occupationBasisVector {n d : ℕ} (e : Fin d → Lp ℂ 2 μ)
    (α : RealizedOccupation n d) : SymmetricSector μ n :=
  normalizedOccupationWordVector μ e (occupationRepresentative α)

/-- The distinct occupation labels give an actual orthonormal family. -/
theorem occupationBasisVector_orthonormal {n d : ℕ} (e : Fin d → Lp ℂ 2 μ)
    (he : Orthonormal ℂ e) : Orthonormal ℂ (occupationBasisVector (n := n) μ e) := by
  apply normalizedOccupationWordVector_orthonormal μ e he
  intro α β hαβ
  apply Subtype.ext
  rw [← occupationRepresentative_count α, ← occupationRepresentative_count β]
  exact hαβ

/-- The concrete finite-mode symmetric subspace is generated by the actual symmetrized mode words. -/
def finiteModeWordSpace {d : ℕ} (e : Fin d → Lp ℂ 2 μ) (n : ℕ) :
    Submodule ℂ (SymmetricSector μ n) :=
  Submodule.span ℂ (Set.range (occupationWordVector (n := n) μ e))

lemma occupationBasisVector_mem_wordSpace {n d : ℕ} (e : Fin d → Lp ℂ 2 μ)
    (α : RealizedOccupation n d) : occupationBasisVector μ e α ∈ finiteModeWordSpace μ e n := by
  unfold occupationBasisVector normalizedOccupationWordVector finiteModeWordSpace
  exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self _))

/-- Completeness is proved from representative independence, not postulated as an interface. -/
theorem occupationBasisVector_span {n d : ℕ} (e : Fin d → Lp ℂ 2 μ) :
    Submodule.span ℂ (Set.range (occupationBasisVector (n := n) μ e)) =
      finiteModeWordSpace μ e n := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨α, rfl⟩
    exact occupationBasisVector_mem_wordSpace μ e α
  · unfold finiteModeWordSpace
    apply Submodule.span_le.mpr
    rintro v ⟨f, rfl⟩
    let α : RealizedOccupation n d := ⟨occupationWordCount f, ⟨f, rfl⟩⟩
    have hcount : occupationWordCount (occupationRepresentative α) = occupationWordCount f :=
      occupationRepresentative_count α
    have hmem : normalizedOccupationWordVector μ e f ∈
        Submodule.span ℂ (Set.range (occupationBasisVector (n := n) μ e)) := by
      rw [← normalizedOccupationWordVector_eq_of_count_eq μ e (occupationRepresentative α) f hcount]
      exact Submodule.subset_span (Set.mem_range_self α)
    have hpNat : 0 < ∏ j, (occupationWordCount f j).factorial :=
      Finset.prod_pos (fun j hj => Nat.factorial_pos _)
    have hp : (0 : ℝ) < ((∏ j, (occupationWordCount f j).factorial : ℕ) : ℝ) := by
      exact_mod_cast hpNat
    have hn : (0 : ℝ) < (n.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos n
    have hcR : Real.sqrt ((n.factorial : ℝ) /
        ∏ j, (occupationWordCount f j).factorial) ≠ 0 :=
      (Real.sqrt_pos.mpr (div_pos hn hp)).ne'
    have hc : (Real.sqrt ((n.factorial : ℝ) /
        ∏ j, (occupationWordCount f j).factorial) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hcR
    have hscaled := (Submodule.span ℂ (Set.range (occupationBasisVector (n := n) μ e))).smul_mem
      ((Real.sqrt ((n.factorial : ℝ) /
        ∏ j, (occupationWordCount f j).factorial) : ℂ)⁻¹) hmem
    simp only [normalizedOccupationWordVector, smul_smul, inv_mul_cancel₀ hc, one_smul] at hscaled
    change occupationWordVector μ e f ∈
      Submodule.span ℂ (Set.range (occupationBasisVector (n := n) μ e))
    exact hscaled

/-- The complete finite occupation orthonormal basis of the actual mode-word subspace. -/
def finiteModeOccupationBasis {n d : ℕ} (e : Fin d → Lp ℂ 2 μ) (he : Orthonormal ℂ e) :
    OrthonormalBasis (RealizedOccupation n d) ℂ (finiteModeWordSpace μ e n) := by
  let v : RealizedOccupation n d → finiteModeWordSpace μ e n :=
    fun α => ⟨occupationBasisVector μ e α, occupationBasisVector_mem_wordSpace μ e α⟩
  have hon : Orthonormal ℂ v := by
    apply ((finiteModeWordSpace μ e n).subtypeₗᵢ).orthonormal_comp_iff.mp
    exact occupationBasisVector_orthonormal μ e he
  have hspan : Submodule.span ℂ (Set.range v) = ⊤ :=
    (Submodule.span_range_subtype_eq_top_iff (finiteModeWordSpace μ e n)
      (fun α => occupationBasisVector_mem_wordSpace μ e α)).mpr (occupationBasisVector_span μ e)
  exact OrthonormalBasis.mk hon hspan.ge

end LiebLiniger.FixedPeriod.Quantum
