import LiebLiniger.FixedPeriod.Quantum.OccupationBasisCompletion
import Mathlib.LinearAlgebra.Multilinear.Basis
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-! Intrinsic symmetric tensor space over the actual finite one-particle mode span. -/

noncomputable section
open MeasureTheory
open scoped InnerProductSpace

namespace LiebLiniger.FixedPeriod.Quantum

variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]

/-- The genuine finite one-particle mode subspace of physical L². -/
def oneParticleModeSpace {d : ℕ} (e : Fin d → Lp ℂ 2 μ) : Submodule ℂ (Lp ℂ 2 μ) :=
  Submodule.span ℂ (Set.range e)

/-- Every symmetric tensor of arbitrary factors from the mode span lies in the occupation-word span. -/
theorem symmetricModeTensor_mem_wordSpace {n d : ℕ} (e : Fin d → Lp ℂ 2 μ)
    (he : Orthonormal ℂ e) (u : Fin n → oneParticleModeSpace μ e) :
    symmetricTensorContinuousMultilinear μ n (fun i => (u i : Lp ℂ 2 μ)) ∈
      finiteModeWordSpace μ e n := by
  classical
  let b : Module.Basis (Fin d) ℂ (oneParticleModeSpace μ e) := Module.Basis.span he.linearIndependent
  let F := (symmetricTensorContinuousMultilinear μ n).toMultilinearMap
  have hb (j : Fin d) : (b j : Lp ℂ 2 μ) = e j := by
    change ((Module.Basis.span he.linearIndependent j :
      Submodule.span ℂ (Set.range e)) : Lp ℂ 2 μ) = e j
    exact Module.Basis.coe_span_apply he.linearIndependent j
  have hu (i : Fin n) : (u i : Lp ℂ 2 μ) = ∑ j, b.repr (u i) j • e j := by
    have h := congrArg ((oneParticleModeSpace μ e).subtype) (b.sum_repr (u i))
    calc
      (u i : Lp ℂ 2 μ) = ∑ j, b.repr (u i) j • (b j : Lp ℂ 2 μ) := by
        simpa only [map_sum, map_smul, Submodule.subtype_apply] using h.symm
      _ = _ := Finset.sum_congr rfl (fun j _ =>
        congrArg (fun w : Lp ℂ 2 μ => b.repr (u i) j • w) (hb j))
  change F (fun i => (u i : Lp ℂ 2 μ)) ∈ finiteModeWordSpace μ e n
  rw [show (fun i => (u i : Lp ℂ 2 μ)) =
    (fun i => ∑ j, b.repr (u i) j • e j) from funext hu]
  rw [F.map_sum]
  apply Submodule.sum_mem
  intro f hf
  rw [F.map_smul_univ]
  change (∏ i, b.repr (u i) (f i)) • occupationWordVector μ e f ∈ finiteModeWordSpace μ e n
  exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self f))

/-- The intrinsic completed symmetric tensor subspace generated by the mode one-particle space. -/
def finiteModeSymmetricSpace {d : ℕ} (e : Fin d → Lp ℂ 2 μ) (n : ℕ) :
    Submodule ℂ (SymmetricSector μ n) :=
  (Submodule.span ℂ (Set.range (fun u : Fin n → oneParticleModeSpace μ e =>
    symmetricTensorContinuousMultilinear μ n (fun i => (u i : Lp ℂ 2 μ))))).topologicalClosure

/-- The actual word span is finite dimensional because there are finitely many mode words. -/
instance finiteModeWordSpace_finiteDimensional {n d : ℕ} (e : Fin d → Lp ℂ 2 μ) :
    FiniteDimensional ℂ (finiteModeWordSpace μ e n) := by
  classical
  exact FiniteDimensional.span_of_finite ℂ
    (Set.finite_range (occupationWordVector (n := n) μ e))

/-- The source's completed finite-mode symmetric space equals the proved occupation-word space. -/
theorem finiteModeSymmetricSpace_eq_wordSpace {n d : ℕ} (e : Fin d → Lp ℂ 2 μ)
    (he : Orthonormal ℂ e) :
    finiteModeSymmetricSpace μ e n = finiteModeWordSpace μ e n := by
  classical
  have hspan : Submodule.span ℂ (Set.range (fun u : Fin n → oneParticleModeSpace μ e =>
      symmetricTensorContinuousMultilinear μ n (fun i => (u i : Lp ℂ 2 μ)))) =
      finiteModeWordSpace μ e n := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro v ⟨u, rfl⟩
      exact symmetricModeTensor_mem_wordSpace μ e he u
    · unfold finiteModeWordSpace
      apply Submodule.span_le.mpr
      rintro v ⟨f, rfl⟩
      let u : Fin n → oneParticleModeSpace μ e :=
        fun i => ⟨e (f i), Submodule.subset_span (Set.mem_range_self (f i))⟩
      exact Submodule.subset_span ⟨u, rfl⟩
  have hclosed : IsClosed (finiteModeWordSpace μ e n : Set (SymmetricSector μ n)) :=
    Submodule.closed_of_finiteDimensional _
  unfold finiteModeSymmetricSpace
  rw [hspan, hclosed.submodule_topologicalClosure_eq]

/-- Complete occupation ONB of the intrinsic completed finite-mode symmetric tensor space. -/
def intrinsicFiniteModeOccupationBasis {n d : ℕ} (e : Fin d → Lp ℂ 2 μ)
    (he : Orthonormal ℂ e) :
    OrthonormalBasis (RealizedOccupation n d) ℂ (finiteModeSymmetricSpace μ e n) :=
  (finiteModeOccupationBasis μ e he).map
    (LinearIsometryEquiv.ofEq _ _ (finiteModeSymmetricSpace_eq_wordSpace μ e he).symm)

/-- The basis applies on the literal physical circle L² carrier with arbitrary fixed positive period. -/
def physicalFiniteModeOccupationBasis (L : ℝ) [Fact (0 < L)] {n d : ℕ}
    (e : Fin d → Lp ℂ 2 (volume : Measure (AddCircle L))) (he : Orthonormal ℂ e) :
    OrthonormalBasis (RealizedOccupation n d) ℂ
      (finiteModeSymmetricSpace (volume : Measure (AddCircle L)) e n) :=
  intrinsicFiniteModeOccupationBasis (volume : Measure (AddCircle L)) e he

end LiebLiniger.FixedPeriod.Quantum
