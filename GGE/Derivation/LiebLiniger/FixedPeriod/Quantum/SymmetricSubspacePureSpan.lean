import LiebLiniger.FixedPeriod.Quantum.ModeSectorIdentification
import LiebLiniger.FixedPeriod.Quantum.Polarization

/-! Pure powers are total in the genuine symmetric tensor subspace over an actual one-particle subspace. -/
noncomputable section
open MeasureTheory
open scoped InnerProductSpace
namespace LiebLiniger.FixedPeriod.Quantum
variable {X : Type*} [MeasurableSpace X] (μ : Measure X) [SigmaFinite μ]

/-- The actual completed symmetric tensor subspace over K, inside the same spatial sector. -/
def symmetricSubspace (K : Submodule ℂ (Lp ℂ 2 μ)) (n : ℕ) :
    Submodule ℂ (SymmetricSector μ n) :=
  (Submodule.span ℂ (Set.range (fun u : Fin n → K =>
    symmetricTensorContinuousMultilinear μ n (fun i => (u i : Lp ℂ 2 μ))))).topologicalClosure

/-- Closed span of literal pure spatial tensor powers of vectors in K. -/
def symmetricPurePowerSpan (K : Submodule ℂ (Lp ℂ 2 μ)) (n : ℕ) :
    Submodule ℂ (SymmetricSector μ n) :=
  (Submodule.span ℂ (Set.range (fun u : K =>
    pureSymmetricTensor μ n (u : Lp ℂ 2 μ)))).topologicalClosure

/-- Polarization proves every actual mixed symmetric tensor belongs to the closed pure-power span. -/
theorem symmetricTensor_mem_purePowerSpan (K : Submodule ℂ (Lp ℂ 2 μ)) (n : ℕ)
    (u : Fin n → K) :
    symmetricTensorContinuousMultilinear μ n (fun i => (u i : Lp ℂ 2 μ)) ∈
      symmetricPurePowerSpan μ K n := by
  classical
  unfold symmetricPurePowerSpan
  rw [← Submodule.orthogonal_orthogonal_eq_closure]
  intro ψ hψ
  have hp (x : K) : inner ℂ ψ (pureSymmetricTensor μ n (x : Lp ℂ 2 μ)) = 0 :=
    (Submodule.span ℂ (Set.range (fun x : K =>
      pureSymmetricTensor μ n (x : Lp ℂ 2 μ)))).inner_left_of_mem_orthogonal
        (Submodule.subset_span (Set.mem_range_self x)) hψ
  let F : ContinuousMultilinearMap ℂ (fun _ : Fin n => K) ℂ :=
    (innerSL ℂ ψ).compContinuousMultilinearMap
      ((symmetricTensorContinuousMultilinear μ n).compContinuousLinearMap
        (fun _ => K.subtypeL))
  have hsym (σ : Equiv.Perm (Fin n)) (v : Fin n → K) :
      F (fun i => v (σ i)) = F v := by
    change inner ℂ ψ (symmetricTensorContinuousMultilinear μ n
      (fun i => (v (σ i) : Lp ℂ 2 μ))) =
      inner ℂ ψ (symmetricTensorContinuousMultilinear μ n (fun i => (v i : Lp ℂ 2 μ)))
    exact congrArg (fun w : SymmetricSector μ n => inner ℂ ψ w)
      (symmetricTensorContinuousMultilinear_permutation μ n σ
        (fun i => (v i : Lp ℂ 2 μ)))
  have hdiag (x : K) : F (fun _ => x) = 0 := by
    change inner ℂ ψ (symmetricTensorContinuousMultilinear μ n
      (fun _ : Fin n => (x : Lp ℂ 2 μ))) = 0
    rw [symmetricTensorContinuousMultilinear_diagonal]
    exact hp x
  have hF := continuousMultilinearMap_eq_zero_of_diagonal F hsym hdiag
  exact congrArg (fun G => G u) hF

/-- The actual symmetric tensor space over K is generated by pure powers, with no completeness assumption on K. -/
theorem symmetricSubspace_eq_purePowerSpan (K : Submodule ℂ (Lp ℂ 2 μ)) (n : ℕ) :
    symmetricSubspace μ K n = symmetricPurePowerSpan μ K n := by
  apply le_antisymm
  · apply Submodule.topologicalClosure_minimal
    · apply Submodule.span_le.mpr
      rintro v ⟨u, rfl⟩
      exact symmetricTensor_mem_purePowerSpan μ K n u
    · exact Submodule.isClosed_topologicalClosure _
  · apply Submodule.topologicalClosure_mono
    apply Submodule.span_le.mpr
    rintro v ⟨u, rfl⟩
    exact Submodule.subset_span ⟨(fun _ : Fin n => u),
      symmetricTensorContinuousMultilinear_diagonal μ n (u : Lp ℂ 2 μ)⟩

/-- Completeness of the actual symmetric subspace is inherited from its definition as a closed spatial subspace. -/
instance symmetricSubspace_completeSpace (K : Submodule ℂ (Lp ℂ 2 μ)) (n : ℕ) :
    CompleteSpace (symmetricSubspace μ K n) := by
  unfold symmetricSubspace
  infer_instance

/-- The finite mode factor is exactly the previously checked intrinsic symmetric mode space. -/
theorem symmetricSubspace_oneParticleModeSpace {d : ℕ} (e : Fin d → Lp ℂ 2 μ) (n : ℕ) :
    symmetricSubspace μ (oneParticleModeSpace μ e) n = finiteModeSymmetricSpace μ e n := rfl

end LiebLiniger.FixedPeriod.Quantum
