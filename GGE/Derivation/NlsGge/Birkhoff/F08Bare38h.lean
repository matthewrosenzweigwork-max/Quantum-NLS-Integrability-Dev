import NlsGge.Birkhoff.F08Bare38g
import NlsGge.Hierarchy.F03Spectral38

/-! # F08 (v2 `C:thm:bare`), file h: the claim, sub-claim map, and `E_m` on the plane

* `F08_bare38` (`C:thm:bare`): the conjunction of
  `F08_L1_38` (`C:eq:L1`), `F08_normalizer_38` and `F08_weak_38` (`C:eq:barelimits`) and the
  well-definedness of the bare measure `ν_{m,N}` (`C:eq:bare`).
* `F08_01_38`: all cutoffs live on one Gaussian probability space (`ℤ → ℂ`, `γ_m`) with the
  increasing low-mode σ-fields `windowSigma N`.
* `EmPlane_eq_spectral38`: `E_m` on the plane is the spectral energy `Σ β_j Q_{2j}`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
noncomputable section

namespace NlsGge.Birkhoff

open MeasureTheory ProbabilityTheory Filter Topology NlsGge.Measure NlsGge.Pilot
  NlsGge.HierarchyRiccati.Core NlsGge.Sobolev38 NlsGge.SpectralFoundations
open scoped ENNReal BoundedContinuousFunction

section Fidelity

variable {m : ℕ} {β : ℕ → ℝ}

/-- `E_m(v) = Σ_{j≤m} β_j Q_{2j}(v)` on the Fourier plane, with `Q_{2j}` the spectral charge
`(2/π)∫(2λ)^{2j} v(λ;v) dλ` (v2 `A:eq:trace`) of the trigonometric polynomial `v`. -/
theorem EmPlane_eq_spectral38 (hm : 2 ≤ m) (N : ℕ) (z : FourierPlane N) :
    EmPlane38 m β N z =
      spectralEnergy38 m β (planeReal N z) (planeReal_smooth38 N z) (planeReal_periodic N z) := by
  unfold EmPlane38 energySobolev38 spectralEnergy38
  refine Finset.sum_congr rfl fun j hj => ?_
  have hj' : j ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
  congr 1
  exact chargeSobolev38_smooth_spectral (m + 1) j (by omega) (by omega) (planeReal N z)
    (planeReal_smooth38 N z) (planeReal_periodic N z) _ (planeElement_hsource38 _ N z)

variable (hm : 2 ≤ m) (hβ : ∀ j ≤ m, 0 < β j)

include hm hβ in
/-- **F08.01.**  The cutoffs `P_N U` (`N ∈ ℕ`) are all defined on the single Gaussian probability
space `(ℤ → ℂ, γ_m)`, are adapted to the increasing σ-fields `A_N` generated by the Fourier
coefficients `|n| ≤ N`, and almost surely agree with the Hilbert projections `P_N U` of
`U = gaussianRealization38 m ω`; `γ_m^F` is the law of `U`. -/
theorem F08_01_38 :
    IsProbabilityMeasure (gammaM38 m β) ∧
    Monotone NlsGge.Ramer.windowSigma ∧
    (∀ N : ℕ, NlsGge.Ramer.windowSigma N ≤ MeasurableSpace.pi) ∧
    (∀ N : ℕ, @Measurable (ℤ → ℂ) (Hm1 m) (NlsGge.Ramer.windowSigma N) _ (PN38 m N)) ∧
    (∀ᵐ ω ∂(gammaM38 m β), ∀ N : ℕ,
      PN38 m N ω = truncSobolev38 _ N (gaussianRealization38 m ω)) ∧
    gammaFM38 m β = (gammaM38 m β).map (gaussianRealization38 m) := by
  refine ⟨inferInstance, NlsGge.Ramer.windowSigma_mono, NlsGge.Ramer.windowSigma_le_pi,
    fun N => ?_, ae_PN_eq_trunc38 hm hβ, gammaFM38_eq_realization m β⟩
  exact (measurable_finiteElement38 _ _).comp (comap_measurable (NlsGge.Ramer.windowProj N))

end Fidelity

namespace BirkhoffInput38

variable (B : BirkhoffInput38) (O : OneSmoothingInput38 B) {m : ℕ} {β : ℕ → ℝ}
  (hm : 2 ≤ m) (hβ : ∀ j ≤ m, 0 < β j)

include O hm hβ in
/-- **v2 `C:thm:bare`** (conditional on `B`, `O`).  For every `m ≥ 2` and `β_0, …, β_m > 0`:

* (`C:eq:bare`) `𝒵_{m,N} > 0` and `ν_{m,N}` is a probability measure on `H^{m-1}`;
* (`C:eq:L1`) with `U ~ γ_m^F` (`gammaFM38`), `e^{-V_m(P_N U)}` and `e^{-V_m(U)}` are integrable and
  `e^{-V_m(P_N U)} → e^{-V_m(U)}` in `L¹`;
* (`C:eq:barelimits`) `𝒵_{m,N} / ∏_{|n|≤N} (π/a_{m,n}) → Z_m` and `ν_{m,N} ⇀ μ_m` on `H^{m-1}`. -/
theorem F08_bare38 :
    (∀ N : ℕ, 0 < ZcalBare38 m β N ∧ IsProbabilityMeasure (nuBare38 m β N)) ∧
    ((∀ N : ℕ, Integrable (fun u : Hm1 m => Real.exp (-(Vm38 m β (truncSobolev38 _ N u))))
        (gammaFM38 m β)) ∧
      Integrable (fun u : Hm1 m => Real.exp (-(Vm38 m β u))) (gammaFM38 m β) ∧
      Tendsto (fun N : ℕ => ∫ u, |Real.exp (-(Vm38 m β (truncSobolev38 _ N u))) -
          Real.exp (-(Vm38 m β u))| ∂(gammaFM38 m β)) atTop (𝓝 0)) ∧
    Tendsto (fun N : ℕ => ZcalBare38 m β N /
      ∏ n ∈ Finset.Icc (-(N : ℤ)) N, (Real.pi / finiteHierarchyRate38 m β n)) atTop
      (𝓝 (ZM38 B m β)) ∧
    Tendsto (fun N : ℕ => nuBarePM38 hm hβ N) atTop (𝓝 (muPM38 B hm hβ)) :=
  ⟨fun N => ⟨ZcalBare_pos38 hm hβ N, isProbabilityMeasure_nuBare38 hm hβ N⟩,
    F08_L1_38 B O hm hβ, F08_normalizer_38 B O hm hβ, F08_weak_38 B O hm hβ⟩

end BirkhoffInput38

end NlsGge.Birkhoff

end
