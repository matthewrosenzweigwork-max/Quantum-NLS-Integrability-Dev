import Mathlib
import NlsGge.Hierarchy.RiccatiAttachedRecursionCore
import NlsGge.Hierarchy.RiccatiLowOrderAlgebraAfterCore
import NlsGge.Hierarchy.RiccatiSmoothJetDerivativeAfterProductPrerequisite

/- M-003 PROOF03 (proof development). Jet-order bound for the Riccati leading remainder.
   jetOrd r P : every monomial of P only involves jets v with v.2 <= r.
   jetAlg r  : the subalgebra generated by X v with v.2 <= r.
   Steps: order closure under ring operations; jetOrd = jetAlg membership; spatialD raises the
   order by at most one; p (n+1) has order <= n (strong induction); the attached convolution sum
   riccatiSum k has order <= k-1; R k := p (k+1) + X (true,k) satisfies R (k+1) = spatialD (R k) +
   X (false,0) * riccatiSum k and has order <= k-2 for k >= 2. No placeholders. -/

open NlsGge.HierarchyRiccati.Core
open scoped ContDiff

namespace NlsGge.Atomic.M003

noncomputable def riccatiLeadingRemainder (k : ℕ) : Poly :=
  p (k+1) + MvPolynomial.X (true, k)

noncomputable def riccatiSum (k : ℕ) : Poly :=
  (Finset.Icc 1 k).attach.sum fun l => p (k + 1 - l.1) * p l.1

theorem riccatiLeadingRemainder_one : riccatiLeadingRemainder 1 = 0 := by
  unfold riccatiLeadingRemainder
  rw [show (1:ℕ) + 1 = 2 from rfl, p_two]
  ring

def jetOrd (r : ℕ) (P : Poly) : Prop :=
  ∀ m ∈ P.support, ∀ v ∈ m.support, v.2 ≤ r

theorem jetOrd_zero (r : ℕ) : jetOrd r 0 := by
  intro m hm
  simp at hm

theorem jetOrd_mono {r s : ℕ} {P : Poly} (h : r ≤ s) (hP : jetOrd r P) : jetOrd s P :=
  fun m hm v hv => (hP m hm v hv).trans h

theorem jetOrd_add {r : ℕ} {P Q : Poly} (hP : jetOrd r P) (hQ : jetOrd r Q) :
    jetOrd r (P + Q) := by
  intro m hm v hv
  rcases Finset.mem_union.1 (MvPolynomial.support_add hm) with h | h
  · exact hP m h v hv
  · exact hQ m h v hv

theorem jetOrd_neg {r : ℕ} {P : Poly} (hP : jetOrd r P) : jetOrd r (-P) := by
  intro m hm v hv
  exact hP m (by simpa using hm) v hv

theorem jetOrd_mul {r s : ℕ} {P Q : Poly} (hP : jetOrd r P) (hQ : jetOrd s Q) :
    jetOrd (max r s) (P * Q) := by
  intro m hm v hv
  obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_add.1 (MvPolynomial.support_mul P Q hm)
  rcases Finset.mem_union.1 (Finsupp.support_add hv) with h | h
  · exact (hP a ha v h).trans (le_max_left _ _)
  · exact (hQ b hb v h).trans (le_max_right _ _)

theorem jetOrd_X {r : ℕ} (v : Jet) (hv : v.2 ≤ r) : jetOrd r (MvPolynomial.X v) := by
  intro m hm w hw
  rw [MvPolynomial.support_X, Finset.mem_singleton] at hm
  subst hm
  have hw' := Finsupp.support_single_subset hw
  rw [Finset.mem_singleton] at hw'
  subst hw'
  exact hv

theorem jetOrd_C {r : ℕ} (c : ℤ) : jetOrd r (MvPolynomial.C c) := by
  intro m hm v hv
  rw [MvPolynomial.support_C] at hm
  split_ifs at hm with hc
  · simp at hm
  · rw [Finset.mem_singleton] at hm
    subst hm
    simp at hv

theorem jetOrd_sum {r : ℕ} {ι : Type*} (s : Finset ι) (f : ι → Poly)
    (h : ∀ i ∈ s, jetOrd r (f i)) : jetOrd r (∑ i ∈ s, f i) :=
  Finset.sum_induction f (jetOrd r) (fun a b ha hb => jetOrd_add ha hb) (jetOrd_zero r) h

def jetGen (r : ℕ) : Set Poly :=
  {Q | ∃ v : Jet, v.2 ≤ r ∧ Q = MvPolynomial.X v}

noncomputable def jetAlg (r : ℕ) : Subalgebra ℤ Poly :=
  Algebra.adjoin ℤ (jetGen r)

theorem X_mem_jetAlg {r : ℕ} (v : Jet) (hv : v.2 ≤ r) :
    (MvPolynomial.X v : Poly) ∈ jetAlg r :=
  Algebra.subset_adjoin (show MvPolynomial.X v ∈ jetGen r from ⟨v, hv, rfl⟩)

theorem jetAlg_mono {r s : ℕ} (h : r ≤ s) : jetAlg r ≤ jetAlg s :=
  Algebra.adjoin_mono (fun Q hQ => by
    obtain ⟨v, hv, rfl⟩ := hQ
    exact ⟨v, le_trans hv h, rfl⟩)

theorem mem_jetAlg_of_jetOrd {r : ℕ} {P : Poly} (h : jetOrd r P) : P ∈ jetAlg r := by
  have hsum : (∑ m ∈ P.support, MvPolynomial.monomial m (P.coeff m)) ∈ jetAlg r := by
    apply Subalgebra.sum_mem
    intro m hm
    rw [MvPolynomial.monomial_eq]
    apply Subalgebra.mul_mem
    · rw [← MvPolynomial.algebraMap_eq]
      exact Subalgebra.algebraMap_mem _ _
    · unfold Finsupp.prod
      apply Subalgebra.prod_mem
      intro n hn
      exact Subalgebra.pow_mem _ (X_mem_jetAlg n (h m hm n hn)) _
  rwa [← MvPolynomial.as_sum P] at hsum

theorem jetOrd_of_mem_jetAlg {r : ℕ} {P : Poly} (hP : P ∈ jetAlg r) : jetOrd r P := by
  unfold jetAlg at hP
  induction hP using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨v, hv, rfl⟩ := hx
    exact jetOrd_X v hv
  | algebraMap c =>
    rw [MvPolynomial.algebraMap_eq]
    exact jetOrd_C c
  | add x y _ _ hx hy => exact jetOrd_add hx hy
  | mul x y _ _ hx hy =>
    have := jetOrd_mul hx hy
    rwa [max_self] at this

theorem spatialD_mem_jetAlg {r : ℕ} {P : Poly} (hP : P ∈ jetAlg r) :
    spatialD P ∈ jetAlg (r+1) := by
  unfold jetAlg at hP
  induction hP using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨v, hv, rfl⟩ := hx
    rw [spatialD_jet]
    exact Algebra.subset_adjoin (show MvPolynomial.X (v.1, v.2 + 1) ∈ jetGen (r+1) from
      ⟨(v.1, v.2 + 1), by show v.2 + 1 ≤ r + 1; omega, rfl⟩)
  | algebraMap c =>
    rw [Derivation.map_algebraMap]
    exact Subalgebra.zero_mem _
  | add x y hxA hyA hx hy =>
    rw [map_add]
    exact Subalgebra.add_mem _ hx hy
  | mul x y hxA hyA hx hy =>
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact Subalgebra.add_mem _
      (Subalgebra.mul_mem _ (jetAlg_mono (Nat.le_succ r) hxA) hy)
      (Subalgebra.mul_mem _ (jetAlg_mono (Nat.le_succ r) hyA) hx)

theorem jetOrd_spatialD {r : ℕ} {P : Poly} (h : jetOrd r P) : jetOrd (r+1) (spatialD P) :=
  jetOrd_of_mem_jetAlg (spatialD_mem_jetAlg (mem_jetAlg_of_jetOrd h))

/-- Order of the Riccati sequence: p (n+1) has jet order at most n. -/
theorem p_jetOrd : ∀ n : ℕ, jetOrd n (p (n+1)) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases n with _ | k
    · show jetOrd 0 (p 1)
      rw [p_one]
      exact jetOrd_neg (jetOrd_X (true, 0) (le_refl _))
    · show jetOrd (k+1) (p (k+2))
      rw [p_recurrence k]
      apply jetOrd_add
      · exact jetOrd_spatialD (ih k (by omega))
      · have hS : jetOrd (k+1) ((Finset.Icc 1 k).attach.sum fun l => p (k + 1 - l.1) * p l.1) := by
          apply jetOrd_sum
          intro l _
          obtain ⟨hl1, hl2⟩ := Finset.mem_Icc.mp l.2
          have A : jetOrd (k - l.1) (p (k + 1 - l.1)) := by
            have := ih (k - l.1) (by omega)
            rwa [show k - l.1 + 1 = k + 1 - l.1 by omega] at this
          have B : jetOrd (l.1 - 1) (p l.1) := by
            have := ih (l.1 - 1) (by omega)
            rwa [show l.1 - 1 + 1 = l.1 by omega] at this
          exact jetOrd_mono (max_le (by omega) (by omega)) (jetOrd_mul A B)
        exact jetOrd_mono (max_le (Nat.zero_le _) (le_refl _))
          (jetOrd_mul (jetOrd_X (false, 0) (le_refl 0)) hS)

/-- The attached convolution sum has jet order at most k-1. -/
theorem riccatiSum_jetOrd (k : ℕ) : jetOrd (k - 1) (riccatiSum k) := by
  unfold riccatiSum
  apply jetOrd_sum
  intro l _
  obtain ⟨hl1, hl2⟩ := Finset.mem_Icc.mp l.2
  have A : jetOrd (k - l.1) (p (k + 1 - l.1)) := by
    have := p_jetOrd (k - l.1)
    rwa [show k - l.1 + 1 = k + 1 - l.1 by omega] at this
  have B : jetOrd (l.1 - 1) (p l.1) := by
    have := p_jetOrd (l.1 - 1)
    rwa [show l.1 - 1 + 1 = l.1 by omega] at this
  exact jetOrd_mono (max_le (by omega) (by omega)) (jetOrd_mul A B)

theorem riccatiLeadingRemainder_succ (k : ℕ) :
    riccatiLeadingRemainder (k+1) =
      spatialD (riccatiLeadingRemainder k) +
        MvPolynomial.X (false, 0) * riccatiSum k := by
  unfold riccatiLeadingRemainder riccatiSum
  rw [show k + 1 + 1 = k + 2 from rfl, p_recurrence k]
  simp only [map_add, spatialD_jet]
  ring

theorem riccatiLeadingRemainder_jetOrd (j : ℕ) :
    jetOrd j (riccatiLeadingRemainder (j+2)) := by
  induction j with
  | zero =>
    have h2 : riccatiLeadingRemainder 2 =
        spatialD (riccatiLeadingRemainder 1) + MvPolynomial.X (false, 0) * riccatiSum 1 :=
      riccatiLeadingRemainder_succ 1
    show jetOrd 0 (riccatiLeadingRemainder 2)
    rw [h2]
    simp only [riccatiLeadingRemainder_one, map_zero, zero_add]
    exact jetOrd_mono (s := 0) (max_le (Nat.zero_le _) (by norm_num))
      (jetOrd_mul (jetOrd_X (false, 0) (le_refl 0)) (riccatiSum_jetOrd 1))
  | succ j ih =>
    have e : riccatiLeadingRemainder (j+1+2) =
        spatialD (riccatiLeadingRemainder (j+2)) +
          MvPolynomial.X (false, 0) * riccatiSum (j+2) :=
      riccatiLeadingRemainder_succ (j+2)
    rw [e]
    apply jetOrd_add
    · exact jetOrd_spatialD ih
    · exact jetOrd_mono (max_le (Nat.zero_le _) (by omega))
        (jetOrd_mul (jetOrd_X (false, 0) (le_refl 0)) (riccatiSum_jetOrd (j+2)))

/-- Clause (3): for 2 <= k, every jet order occurring in R k = p (k+1) + X (true,k) is at most k-2. -/
theorem riccatiLeadingRemainder_order (k : ℕ) (hk : 2 ≤ k) :
    jetOrd (k - 2) (riccatiLeadingRemainder k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 2 := ⟨k - 2, by omega⟩
  rw [show j + 2 - 2 = j by omega]
  exact riccatiLeadingRemainder_jetOrd j

/-- Physical recurrence: evaluation of p (k+2) along u (the M003.physical node). -/
theorem riccati_source_recurrence (u : ℝ → ℂ)
    (hu : ContDiff ℝ ∞ u) (k : ℕ) (x : ℝ) :
    riccatiJetEvaluation u x (p (k+2)) =
      deriv (fun y => riccatiJetEvaluation u y (p (k+1))) x +
      u x * ((Finset.Icc 1 k).attach.sum fun l =>
        riccatiJetEvaluation u x (p (k+1-l.1)) *
          riccatiJetEvaluation u x (p l.1)) := by
  have hD : riccatiJetEvaluation u x (spatialD (p (k+1))) =
      deriv (fun y => riccatiJetEvaluation u y (p (k+1))) x :=
    ((riccatiJetEvaluation_hasDerivAt u hu (p (k+1)) x).deriv).symm
  have hX : riccatiJetEvaluation u x (MvPolynomial.X (false, 0)) = u x := by
    simp [riccatiJetEvaluation_X, riccatiJetFunction]
  have hadd : ∀ A B : Poly,
      riccatiJetEvaluation u x (A + B) = riccatiJetEvaluation u x A + riccatiJetEvaluation u x B :=
    fun A B => map_add (polynomialEvaluation (fun v => riccatiJetFunction u v x)) A B
  have hmul : ∀ A B : Poly,
      riccatiJetEvaluation u x (A * B) = riccatiJetEvaluation u x A * riccatiJetEvaluation u x B :=
    fun A B => map_mul (polynomialEvaluation (fun v => riccatiJetFunction u v x)) A B
  have hsum : riccatiJetEvaluation u x ((Finset.Icc 1 k).attach.sum fun l =>
        p (k+1-l.1) * p l.1) =
      (Finset.Icc 1 k).attach.sum fun l =>
        riccatiJetEvaluation u x (p (k+1-l.1) * p l.1) :=
    map_sum (polynomialEvaluation (fun v => riccatiJetFunction u v x)) _ _
  rw [p_recurrence k, ← hD, hadd, hmul, hX, hsum]
  simp only [hmul]


theorem riccatiLeadingRemainder_eq (k : ℕ) :
    p (k+1) = -MvPolynomial.X (true, k) + riccatiLeadingRemainder k := by
  unfold riccatiLeadingRemainder
  ring

/-- Design node M003.main, stated exactly as in the design. -/
theorem riccati_leading_remainder (k : ℕ) (hk : 1 ≤ k) :
    p (k+1) = -MvPolynomial.X (true,k) + riccatiLeadingRemainder k ∧
    (k = 1 → riccatiLeadingRemainder k = 0) ∧
    (2 ≤ k → ∀ q ∈ (riccatiLeadingRemainder k).support,
      ∀ v ∈ q.support, v.2 ≤ k-2) := by
  refine ⟨riccatiLeadingRemainder_eq k, ?_, ?_⟩
  · intro hk1
    subst hk1
    exact riccatiLeadingRemainder_one
  · intro hk2 q hq v hv
    exact riccatiLeadingRemainder_order k hk2 q hq v hv

end NlsGge.Atomic.M003
